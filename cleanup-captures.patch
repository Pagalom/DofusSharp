+    public void DeleteCaptureArtifacts(
+        string captureFilePath)
+    {
+        if (string.IsNullOrWhiteSpace(
+            captureFilePath))
+        {
+            return;
+        }
+
+        string? directory =
+            Path.GetDirectoryName(
+                captureFilePath
+            );
+
+        TryDeleteCaptureDirectory(
+            directory
+        );
+    }
+
+    private static string
+        GetCapturesDirectory()
+    {
+        return Path.Combine(
+            Environment.GetFolderPath(
+                Environment
+                    .SpecialFolder
+                    .LocalApplicationData
+            ),
+            "BestCrush",
+            "DebugCaptures"
+        );
+    }
+
+    private static void
+        TryDeleteCaptureDirectory(
+            string? directory)
+    {
+        if (string.IsNullOrWhiteSpace(
+            directory))
+        {
+            return;
+        }
+
+        try
+        {
+            string fullDirectory =
+                Path.GetFullPath(
+                    directory
+                );
+
+            string capturesDirectory =
+                Path.GetFullPath(
+                    GetCapturesDirectory()
+                );
+
+            DirectoryInfo? parent =
+                Directory.GetParent(
+                    fullDirectory
+                );
+
+            // Sécurité : BestCrush ne supprime que les
+            // sous-dossiers directs de DebugCaptures.
+            if (parent is null ||
+                !string.Equals(
+                    Path.GetFullPath(
+                        parent.FullName
+                    ),
+                    capturesDirectory,
+                    StringComparison.OrdinalIgnoreCase
+                ))
+            {
+                return;
+            }
+
+            if (Directory.Exists(
+                fullDirectory))
+            {
+                Directory.Delete(
+                    fullDirectory,
+                    recursive: true
+                );
+            }
+        }
+        catch
+        {
+            // Le nettoyage d'une capture temporaire
+            // ne doit jamais interrompre BestCrush.
+        }
+    }
+
