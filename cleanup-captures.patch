+    private async Task
+        CleanupAbandonedCaptureAsync(
+            Task<DofusCaptureResult>
+                captureTask)
+    {
+        try
+        {
+            DofusCaptureResult capture =
+                await captureTask
+                    .ConfigureAwait(false);
+
+            dofusCaptureService
+                .DeleteCaptureArtifacts(
+                    capture.FilePath
+                );
+        }
+        catch
+        {
+            // Capture annulée/échouée :
+            // DofusCaptureService nettoie déjà son
+            // éventuel dossier partiellement créé.
+        }
+    }
