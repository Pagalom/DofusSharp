@using BestCrush.Domain.Models
@using BestCrush.Domain.Services
@using BestCrush.Models

<div class="table-responsive history-observations">
<table class="table table-striped table-hover align-middle mb-0">
    <thead><tr>
        @foreach (var column in Columns)
        {
            <th class="@(column.Key is HistorySortColumn.Value or HistorySortColumn.Quantity ? "text-end" : null)"><button type="button" class="history-sort" @onclick="() => SortRequested.InvokeAsync(column.Key)">@column.Label @Indicator(column.Key)</button></th>
        }
    </tr></thead>
    <tbody>
    @if (!Rows.Any()) { <tr><td colspan="@(IsEquipment ? 6 : 5)" class="text-center py-4">Aucun relevé ne correspond à ces filtres.</td></tr> }
    @foreach (var row in Rows)
    {
        bool expanded = _expanded.Contains(row.Id);
        <tr>
            <td class="text-nowrap">@row.At.ToLocalTime().ToString("dd/MM/yyyy")<div class="small text-body-secondary">@row.At.ToLocalTime().ToString("HH:mm")</div></td>
            <td><div class="d-flex align-items-center gap-2">
                @if (row.Item is not null) { <ItemIcon Item="row.Item" Size="Size.Tiny" Background="IconBackground.Slot" /> }
                <button class="history-object" type="button" aria-expanded="@expanded" @onclick="() => Toggle(row.Id)"><span aria-hidden="true">@(expanded ? "⌄" : "›")</span>
                <span><span class="fw-semibold">@row.Name</span><span class="small text-body-secondary d-block">Niv. @row.Level @row.Type</span></span>
            </button></div></td>
            @if (IsEquipment) { <td>@(row.IsCoefficient ? "Coefficient" : "Prix")</td> }
            <td class="text-end text-nowrap">@(row.Quantity is int q ? $"× {q:N0}" : "—")</td>
            <td class="text-end text-nowrap">@(row.Cleared ? "—" : row.IsCoefficient ? $"{row.Value:0.##} %" : $"{row.Value:N0} K")
                @if (row.Cleared) { <div class="small text-warning">Réinitialisé</div> }
            </td>
            <td>@row.Source</td>
        </tr>
        @if (expanded)
        {
            <tr><td colspan="@(IsEquipment ? 6 : 5)"><div class="d-flex flex-wrap gap-4 p-2 small">
                @if (!row.IsCoefficient && !row.Cleared && row.Quantity is > 0)
                { <div>Prix à l’unité<strong class="d-block">@((row.Value / row.Quantity.Value).ToString("N2")) K</strong></div> }
                <div>Source<strong class="d-block">@row.Source</strong></div>
                <div>Date du relevé<strong class="d-block">@row.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
            </div></td></tr>
        }
    }
    </tbody>
</table></div>

@code {
    [Parameter] public IReadOnlyList<MarketHistoryRow> MarketRows { get; set; } = [];
    [Parameter] public IReadOnlyList<ItemHistoryRow> ItemRows { get; set; } = [];
    [Parameter] public bool IsEquipment { get; set; }
    [Parameter] public IReadOnlyDictionary<long, IItem> Items { get; set; } = new Dictionary<long, IItem>();
    [Parameter] public HistorySortColumn SortColumn { get; set; }
    [Parameter] public HistorySortDirection SortDirection { get; set; }
    [Parameter] public EventCallback<HistorySortColumn> SortRequested { get; set; }
    [Parameter] public string? ResetKey { get; set; }
    private string? _lastKey;
    private readonly HashSet<Guid> _expanded = [];
    protected override void OnParametersSet() { if (_lastKey != ResetKey) { _lastKey = ResetKey; _expanded.Clear(); } }
    private void Toggle(Guid id) { if (!_expanded.Add(id)) _expanded.Remove(id); }
    private string Indicator(HistorySortColumn key) => key == SortColumn ? SortDirection == HistorySortDirection.Ascending ? "▲" : "▼" : "↕";
    private IEnumerable<(HistorySortColumn Key, string Label)> Columns => new[] {(HistorySortColumn.Date,"Date"),(HistorySortColumn.Name,"Objet")}
        .Concat(IsEquipment ? new[] {(HistorySortColumn.DataKind,"Relevé")} : [])
        .Concat([(HistorySortColumn.Quantity,"Lot"),(HistorySortColumn.Value,"Valeur"),(HistorySortColumn.Source,"Source")]);
    private sealed record Observation(Guid Id, DateTime At, string Name, int Level, string? Type, int? Quantity, double Value, bool IsCoefficient, bool Cleared, string Source, IItem? Item);
    private IEnumerable<Observation> Rows => IsEquipment
        ? ItemRows.Select(r => new Observation(r.ObservationId,r.ObservedAtUtc,r.Name,r.Level,"· " + r.Type.ToDisplayName(),r.Quantity,r.Value,r.DataKind == ItemHistoryDataKind.Coefficient,r.IsCleared,
            r.MarketSource is MarketPriceSource m ? m == MarketPriceSource.Manual ? "Manuel" : "Jeu" : r.CoefficientSource == CoefficientSource.DofocusInitial ? "DoFocus" : r.CoefficientSource == CoefficientSource.Manual ? "Manuel" : "Jeu",Items.GetValueOrDefault(r.DofusDbId)))
        : MarketRows.Select(r => new Observation(r.ObservationId,r.ObservedAtUtc,r.Name,r.Level,null,r.Quantity,r.Price,false,r.IsCleared,r.Source == MarketPriceSource.Manual ? "Manuel" : "Jeu",Items.GetValueOrDefault(r.DofusDbId)));
}
