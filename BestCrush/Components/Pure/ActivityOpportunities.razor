    private IReadOnlyDictionary<string, int>? JobLevels
    {
        get
        {
            if (Server is not { } server || (!(IsTrading || IsFarming) &&
                !string.Equals(Stocks.Selected?.ServerName, server, StringComparison.OrdinalIgnoreCase)))
                return null;

            return Professions.ForWindow(Clients.SelectedClient?.Key, IsTrading || IsFarming ? server : null)?
                .GroupBy(profession => profession.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToDictionary(group => group.Key, group => group.Max(profession => profession.Level), StringComparer.CurrentCultureIgnoreCase);
        }
    }
    private bool CanDisplay=>_report is not null && _reportInputs is { } inputs && inputs.Module==Module &&
        inputs.Client==Clients.SelectedClient?.Key && string.Equals(inputs.Server,Server,StringComparison.OrdinalIgnoreCase) &&
        inputs.Stock?.Id==Stocks.Selected?.Id;
    private sealed record ViewKey(ActivityReport Report, ActivityFilters Filters, string Levels, long Minute);
    private ViewKey? _viewKey;
    private IReadOnlyList<ActivityRecommendation> _visible=[];
    private IReadOnlyList<ActivityRecommendation> GetVisibleRows(
        IReadOnlyDictionary<string, int>? levels, bool respectJobLevels)
    {
        string levelKey = levels is null ? "" : string.Join(';', levels.OrderBy(x => x.Key).Select(x => $"{x.Key}:{x.Value}"));
        var now = DateTime.UtcNow;
        bool historical = IsHistoricalTrading;
        var filters = new ActivityFilters(_search, _strategy, _sort, ItemId,
            historical ? 0 : _minimum, _budget, MaximumLevel, !historical && _completeOnly, _excludeOld,
            !IsFarming && respectJobLevels, Origin: _origin, MinimumRoi: historical ? 0 : _minimumRoi,
            ReadyOnly: !historical && _readyOnly, MinimumMedianDiscount: historical ? _minimumMedianDiscount : 0,
            MaximumMedianAgeDays: historical ? _maximumMedianAgeDays : null,
            TradingTargetRoi: IsTrading ? Settings.TargetRoiPercent : null,
            TradingCategories: IsTrading ? _tradeCategories : null, FarmSource: _farmSource,
            HarvestJob: _harvestJob, RespectHarvestLevels: IsFarming && respectJobLevels,
            CombatSelection: IsFarming ? _farmCombat : null, CombatCatalog: IsFarming ? _combatCatalog : null);
        long minute = _excludeOld || filters.MaximumMedianAgeDays.HasValue ? now.Ticks / TimeSpan.TicksPerMinute : 0;
        var key = new ViewKey(_report!, filters, levelKey, minute);
        if (key == _viewKey) return _visible;
        _visible = ActivityRanking.Select(_report!.Candidates, filters, now, levels);
        _viewKey = key;
        return _visible;
    }
    private List<TradingCard> BuildTradingCards(IReadOnlyList<ActivityRecommendation> rows, double targetRoi)
    {
        var cards = rows.GroupBy(row => row.HistoricalPrice is null ? row.Id : $"history-{row.ObjectType}-{row.ItemId}")
            .Where(group => _showHidden || !_hiddenTrades.Contains(group.Key))
            .Select(group => new TradingCard(group.Key, group.First(),
                group.First().HistoricalPrice is null ? null : group.ToArray()))
            .ToList();
        if (_openTrade is not { } open)
            return cards;

        int currentIndex = cards.FindIndex(card => card.Key == open.Card.Key);
        bool unavailable = currentIndex < 0;
        var current = unavailable ? open.Card : cards[currentIndex];
        bool atTarget = !unavailable && current.Row.MeetsTradingTarget(targetRoi);
        current = current with
        {
            Unavailable = unavailable,
            DismissOnScroll = unavailable || (open.WasAtTarget && !atTarget)
        };
        _openTrade = open with { Card = current, WasAtTarget = open.WasAtTarget || atTarget };
        if (!unavailable)
            cards.RemoveAt(currentIndex);
        cards.Insert(Math.Min(open.Position, cards.Count), current);
        return cards;
    }

    private void SetTradeExpanded(TradingCard card, int position, bool expanded)
    {
        _openTrade = expanded ? new(card, position, card.Row.MeetsTradingTarget(Settings.TargetRoiPercent)) : null;
    }

    private void ReleaseOpenTrade() => _openTrade = null;

    private string HiddenTradesKey => $"Trading.Hidden.{_hiddenServer}";

    private void LoadHiddenTrades(string? server)
    {
        if (string.Equals(_hiddenServer, server, StringComparison.OrdinalIgnoreCase))
            return;
        _hiddenServer = server;
        _showHidden = false;
        _hiddenTrades.Clear();
        if (server is not null && WorkspacePreferences.GetString(HiddenTradesKey) is { Length: > 0 } saved)
        {
            try { _hiddenTrades.UnionWith(JsonSerializer.Deserialize<string[]>(saved) ?? []); }
            catch (JsonException) { }
        }
    }

    private void ToggleShowHidden()
    {
        ReleaseOpenTrade();
        _showHidden = !_showHidden;
    }

    private void SetTradeHidden(string key, bool hidden)
    {
        if (_hiddenServer is null)
            return;
        if (hidden)
            _hiddenTrades.Add(key);
        else
            _hiddenTrades.Remove(key);
        if (_hiddenTrades.Count == 0)
        {
            _showHidden = false;
            WorkspacePreferences.Remove(HiddenTradesKey);
        }
        else
            WorkspacePreferences.SetString(HiddenTradesKey, JsonSerializer.Serialize(_hiddenTrades));
        if (hidden && !_showHidden && _openTrade?.Card.Key == key)
            ReleaseOpenTrade();
    }

    protected override void OnInitialized()
    {
        RestoreTabFilters();
        Stocks.Changed+=Changed;Clients.Changed+=Changed;ServerFilter.Changed+=Changed;Professions.Changed+=JobsChanged;
        Sales.Changed+=SalesChanged;MarketChanges.Changed+=MarketChanged;
        Sales.ListingsChanged += ListingsChanged;
        _ = WatchListingWindowAsync(_listingClock.Token);
        if (Settings is BestCrushSettingsService localSettings)
            localSettings.TargetRoiChanged += TargetRoiChanged;
    }
    protected override Task OnParametersSetAsync()=>ReloadAsync(false);
    private Task InputsChangedAsync()=>ReloadAsync(true,true);
    private void Changed()=>_=InvokeAsync(()=>ReloadAsync(true));
    private void JobsChanged()=>_=InvokeAsync(StateHasChanged);
    private void TargetRoiChanged()
    {
        if (IsTrading)
            _ = InvokeAsync(StateHasChanged);
    }
    private void SalesChanged(string server){if(string.Equals(server,Server,StringComparison.OrdinalIgnoreCase))_=InvokeAsync(()=>ReloadAsync(true,true));}
    private void MarketChanged(object? sender,MarketDataChangedEventArgs e)=>SalesChanged(e.ServerName);
    private long? ListedUnitsFor(ActivityRecommendation row) =>
        string.Equals(_listingServer, Server, StringComparison.OrdinalIgnoreCase) ? _listingTotals?.For(row) : null;

    private void ListingsChanged(string server) => _ = InvokeAsync(() => RefreshListingTotalsAsync(server));

    private async Task WatchListingWindowAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
                if (!_disposed && Server is { } server)
                    await RefreshListingTotalsAsync(server);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private async Task RefreshListingTotalsAsync(string server)
    {
        if (_disposed || !string.Equals(server, Server, StringComparison.OrdinalIgnoreCase))
            return;
        int revision = ++_listingRevision;
        try
        {
            var totals = await Task.Run(() => Sales.ReadListingTotals(server, DateTimeOffset.UtcNow));
            if (_disposed || revision != _listingRevision || !string.Equals(server, Server, StringComparison.OrdinalIgnoreCase))
                return;
            _listingServer = server;
            _listingTotals = totals;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Le nombre de mises en vente est indisponible pour {Server}.", server);
            if (!_disposed && revision == _listingRevision)
            {
                _listingTotals = null;
                StateHasChanged();
            }
        }
    }

    private async Task ReloadAsync(bool debounce,bool force=false,bool refresh=false)
    {
        if(_disposed)return;
        if (UsesCards && refresh) _filtersOpen = false;
        var inputs=new Inputs(Module,Server,Clients.SelectedClient?.Key,Stocks.Selected,AnalysisVolume);
        if(!force && inputs==_lastInputs)return;
        _lastInputs=inputs;_scan?.Cancel();
        using var cancellation=new CancellationTokenSource();_scan=cancellation;var token=cancellation.Token;
        if (!CanDisplay)
        {
            _report = null;
            ReleaseOpenTrade();
        }
        if (IsTrading)
            LoadHiddenTrades(inputs.Server);
        _busy=true;_error=null;StateHasChanged();
        try
        {
            if(debounce)await Task.Delay(450,token);
            if(inputs.Server is null)return;
            if(inputs.Volume is <1 or >10000){_error="Choisissez une quantité de 1 à 10 000.";return;}
            var report=await Service.ScanAsync(inputs.Module,inputs.Server,inputs.Stock,inputs.Volume,token,refresh);
            if(Module.Length==0 && StockOpportunityService.CanUse(inputs.Stock,inputs.Server))
            {
                var craftReport=await StockOpportunitiesService.ScanAsync(inputs.Stock!,inputs.Server,1,token,useCache:true);
                var histories=Sales.ReadHistories(inputs.Server);
                var extra=craftReport.Candidates.Select(row=>
                {
                    var market=new SalesMarketKey(inputs.Server,row.Plan.MarketType,row.Plan.Product.DofusDbId);
                    var history=row.Origin=="craft" ? histories.FirstOrDefault(x=>x.Market==market) : null;
                    var value=SalesKineticsCalculator.EvaluateProfitability(market,row.Plan.Quantity,row.Revenue,row.Plan.EconomicCost,
                        history?.Period(7),DateTimeOffset.UtcNow,TimeSpan.FromDays(2));
                    var missing=row.MissingData.ToList();
                    if(!value.Kinetics.HasMeasuredDemand)missing.Add("Cinétique à vérifier : consultez le Cours du marché des objets revendus dans Dofus.");
                    return new ActivityRecommendation($"stock-{row.Origin}-{row.Plan.Product.DofusDbId}-{row.Focus}",row.Origin,row.Strategy,
                        row.Plan.Product.DofusDbId,row.Plan.Product.Name,row.Plan.Product.Level,row.Plan.MarketType,
                        row.Plan.Quantity,row.Revenue,row.Plan.EconomicCost,value,missing,
                        row.Plan.Ingredients.Select(x=>$"{x.Required} × {x.Name} · {x.Used} possédé(s) utilisé(s), {x.Missing} manquant(s)").ToArray())
                        {PriceUpdatedUtc=row.Evidence.OldestUtc,SourceHref=row.SourceUrl,CashRequired=row.Plan.CashRequired};
                }).ToArray();
                report=report with{Candidates=report.Candidates.Concat(extra).ToArray()};
            }
            token.ThrowIfCancellationRequested();
            if(!_disposed && ReferenceEquals(_scan,cancellation) && inputs==_lastInputs)
            {
                _report=report;_reportInputs=inputs;
                if (IsFarming)
                {
                    HarvestJobs = report.Candidates.Select(row => row.Job).OfType<string>()
                        .Distinct(StringComparer.CurrentCultureIgnoreCase).Order(StringComparer.CurrentCultureIgnoreCase).ToArray();
                    if (_combatCatalogRequested || _sort is "monster" or "zone")
                        _ = LoadCombatCatalogAsync();
                }
                await RefreshListingTotalsAsync(inputs.Server);
            }
        }
        catch(OperationCanceledException) when(token.IsCancellationRequested){}
        catch(Exception ex){Logger.LogError(ex,"Analyse des activités économiques indisponible.");if(!token.IsCancellationRequested)_error="Analyse indisponible. Réessayez après actualisation des données.";}
        finally{if(ReferenceEquals(_scan,cancellation)){_scan=null;_busy=false;}if(!_disposed)StateHasChanged();}
    }
    public void Dispose()
    {
        _combatLookup?.Cancel();
        _disposed=true;_scan?.Cancel();Stocks.Changed-=Changed;Clients.Changed-=Changed;ServerFilter.Changed-=Changed;
        Professions.Changed-=JobsChanged;Sales.Changed-=SalesChanged;MarketChanges.Changed-=MarketChanged;
        Sales.ListingsChanged -= ListingsChanged;
        _listingClock.Cancel();
        _listingClock.Dispose();
        if (Settings is BestCrushSettingsService localSettings)
            localSettings.TargetRoiChanged -= TargetRoiChanged;
        var filters = ReadCurrentFilters();
        if (_filterPreferencesKey is not null && filters != _initialFilters)
            WorkspacePreferences.SetString(_filterPreferencesKey, JsonSerializer.Serialize(filters));
    }
