@using BestCrush.Domain.Models
@using BestCrush.Domain.Services
@using BestCrush.Models
@using BestCrush.Services
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject IServiceScopeFactory Scopes
@inject Microsoft.Extensions.Logging.ILogger<OwnedForgemagingList> Logger
@using Microsoft.Extensions.Logging
@implements IDisposable

@if (_stock is not null && _store is not null)
{
    <section class="owned-forgemaging mt-3" aria-busy="@_load.IsLoading.ToString().ToLowerInvariant()">
        @if (Filters is null && Source is not null)
        {
            <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                <ServiceSearch @bind-Value="_search" Label="Chercher dans mes équipements" Placeholder="Chercher dans mes équipements…" />
            </div>
        }
        @if (Source is null && TargetItemId is null)
        {
            <p class="text-secondary small">Synchronisez l’inventaire ou la banque du personnage ciblé sur ce serveur.</p>
        }
        else if (_load.Error is not null || _preparationError)
        {
            <p class="text-warning small" role="status">Le chargement des équipements a échoué. <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="RefreshAsync">Réessayer</button></p>
        }
        else if (_load.IsLoading && _rows.Length == 0)
        {
            <p class="text-secondary small" role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Chargement des équipements…</p>
        }
        else if (VisibleRows is { Length: > 0 } rows)
        {
            <PagedDataTable TItem="OwnedForgemagingEquipment" Items="rows" PageSize="20" ResetKey="@($"{_sourceId}:{_search}:{Filters?.SearchText}:{TargetItemId}:{TargetInstanceKey}")">
                <RowContent Context="page">
                    @foreach (var row in page)
                    {
                        RenderFragment identity = @<span class="result-identity">
                                    <span class="owned-fm-picture">
                                        <MarketItemPicture IconId="row.Equipment.DofusDbIconId" />
                                        <span class="owned-fm-origin" tabindex="0" role="img" aria-label="@Origin(row)"
                                              data-bs-toggle="tooltip" data-bs-title="@Origin(row)" data-bs-custom-class="multiline-tooltip">@if (row.Container == "workshop") { <i class="bi bi-tools" aria-hidden="true"></i> }
                                            else { <StockContainerIcon Bank="@(row.Container == "bank")" /> }</span>
                                    </span>
                                    <span><span class="result-name"><CopyTextButton Value="@row.Equipment.Name" Tooltip="Copier le nom de l’équipement">@row.Equipment.Name</CopyTextButton></span>
                                        <small>@row.Equipment.Type.ToDisplayName() · Niv. @row.Equipment.Level@if (row.HasOver) { <text> · Over</text> }@if (row.HasExo) { <text> · Exo</text> }</small></span>
                                </span>;
                        @if (Filters is not null && ServerName is { } server)
                        {
                            <CrushingResultCard @key="row.Key" Equipment="row.Equipment" ServerName="@server" Owned="row"
                                                InitiallyExpanded="@(TargetItemId is not null)" Identity="identity"
                                                GainLabel="Gain net" RankedSummary="@OwnedCrushingSummary(row)">
                                <ChildContent>
                                    <OwnedForgemagingDetail Item="row" RuneIcons="_runeIcons" IsCrushing="true" ShowRoll="false"
                                                            SaveAcquisition="@(row.Quantity == 1 && row.Container != "workshop"
                                                                ? EventCallback.Factory.Create<EquipmentAcquisition>(this, acquisition => SaveAcquisition(row, acquisition))
                                                                : default)" />
                                </ChildContent>
                            </CrushingResultCard>
                        }
                        else
                        {
                            <ServiceResult @key="row.Key" Focus="() => Services.GetRequiredService<OverlayWorkspaceService>().FocusOwnedAsync(row, ServerName)" FocusItemName="@row.Equipment.Name">
                                <Summary>
                                    @identity
                                    @if (row.RuneCount > 0)
                                    {
                                        <span class="result-stat"><small>Runes passées</small><strong>@row.RuneCount</strong></span>
                                        <span class="result-stat"><small>Coût FM</small><strong>@OwnedForgemagingDetail.FormatCost(row)</strong></span>
                                    }
                                </Summary>
                                <ChildContent><OwnedForgemagingDetail Item="row" RuneIcons="_runeIcons" /></ChildContent>
                            </ServiceResult>
                        }
                    }
                </RowContent>
            </PagedDataTable>
        }
        else
        {
            <p class="small text-secondary">@(Filters is null ? "Aucun équipement à afficher." : "Aucun équipement possédé ne correspond aux filtres dans les stocks synchronisés.")</p>
        }
    </section>
}

@code {
    [Parameter] public string? ServerName { get; set; }
    [Parameter] public SearchItemsModel? Filters { get; set; }
    [Parameter] public int RefreshVersion { get; set; }
    [Parameter] public Func<IReadOnlyCollection<Equipment>, IEnumerable<Equipment>>? FilterEquipment { get; set; }
    [Parameter] public EventCallback<IReadOnlyCollection<Equipment>> EquipmentLoaded { get; set; }
    [Parameter] public long? TargetItemId { get; set; }
    [Parameter] public string? TargetInstanceKey { get; set; }

    private sealed record EquipmentRead(OwnedForgemagingEquipment[] Rows, IReadOnlyDictionary<long, long> RuneIcons);

    private readonly BackgroundDataLoad<EquipmentRead> _load = new();
    private LiveStockService? _stock;
    private CurrentDofusClientsState? _clients;
    private ForgemagingSessionStore? _store;
    private LiveForgemagingService? _live;
    private (long? Item, string? Key) _target;
    private MarketDataChangeNotifier? _market;
    private OwnedForgemagingEquipment[] _rows = [];
    private IReadOnlyDictionary<long, long> _runeIcons = new Dictionary<long, long>();
    private string? _sourceId, _server;
    private string _search = "";
    private int _version, _reloadQueued;
    private bool _disposed, _preparationError;
    private LiveStockSource? Source => _stock?.SelectedForServer(ServerName) is { } source &&
        source.Containers.Any(c => c.Complete && !c.Stale && c.Container is "inventory" or "bank") ? source : null;

    private OwnedForgemagingEquipment[] VisibleRows
    {
        get
        {
            if (_sourceId != Source?.Id) return [];
            if (TargetItemId is { } id)
                return _rows.Where(row => row.Equipment.DofusDbId == id &&
                    (TargetInstanceKey is null || row.Key.Equals(TargetInstanceKey, StringComparison.OrdinalIgnoreCase))).ToArray();
            if (Filters is not { } filters)
                return _rows.Where(row => row.Equipment.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase))
                    .OrderBy(row => row.Equipment.Name, StringComparer.CurrentCultureIgnoreCase).ToArray();

            var accepted = FilterEquipment?.Invoke(_rows.Select(row => row.Equipment).DistinctBy(item => item.DofusDbId).ToArray())
                .Select(item => item.DofusDbId).ToHashSet();
            return _rows.Where(row => (accepted is null || accepted.Contains(row.Equipment.DofusDbId)) &&
                    (!filters.CompleteDataOnly || row.Gain is not null) && (!filters.FreshDataOnly || row.Fresh) &&
                    (!filters.RequireCoefficient || row.HasCoefficient) &&
                    (filters.MinimumBenefit is not { } min || row.Gain >= min) && MatchesRunes(row, filters))
                .OrderByDescending(row => row.Gain.HasValue).ThenByDescending(row => row.Gain)
                .ThenByDescending(row => row.Crushing?.Target?.Value).ThenBy(row => row.Equipment.Name).ToArray();
        }
    }

    protected override void OnInitialized()
    {
        _stock = Services.GetService<LiveStockService>();
        _clients = Services.GetService<CurrentDofusClientsState>();
        _store = Services.GetService<ForgemagingSessionStore>();
        _market = Services.GetService<MarketDataChangeNotifier>();
        _live = Services.GetService<LiveForgemagingService>();
        if (_stock is not null) _stock.Changed += QueueRefresh;
        if (_clients is not null) _clients.Changed += QueueRefresh;
        if (_store is not null) _store.GameHistoryChanged += HistoryChanged;
        if (_market is not null) _market.Changed += MarketChanged;
    }

    protected override Task OnParametersSetAsync()
    {
        if (_server == ServerName && _version == RefreshVersion && _target == (TargetItemId, TargetInstanceKey)) return Task.CompletedTask;
        _target = (TargetItemId, TargetInstanceKey);
        _server = ServerName;
        _version = RefreshVersion;
        return RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (_disposed || _store is not { } store) return;
        var source = Source;
        if (_sourceId != source?.Id) _rows = [];
        _sourceId = source?.Id;
        _preparationError = false;
        if (ServerName is not { } server || (source is null && TargetItemId is null)) { _load.Cancel(); return; }
        bool crushing = Filters is not null;
        var (targetId, targetKey) = _target;
        bool loaded = await _load.RunAsync(async token =>
        {
            using var scope = Scopes.CreateScope();
            var services = scope.ServiceProvider;
            var data = services.GetRequiredService<ForgemagingDataService>();
            var rows = source is null ? [] : await ForgemagedEquipmentStock.LoadAsync(source, server, store,
                data, services.GetService<ActivityCatalogService>(),
                services.GetService<CoefficientService>(), services.GetService<IBestCrushSettingsProvider>(), crushing, token, targetId);
            if (targetId is { } id && targetKey is not null && rows.All(row => row.Key != targetKey) &&
                _live?.View(server) is { StockKey: { } key, Session: { } observed, Crushing: { } context, Runes: var runes } &&
                key == targetKey && observed.ItemId == id &&
                (await data.GetOwnedEquipmentAsync([id], token, forCrushing: true)).FirstOrDefault() is { } equipment)
            {
                var acquisition = store.GetAcquisitions(server, [(id, key)]).GetValueOrDefault(key);
                var craft = acquisition?.Kind == EquipmentAcquisitionKind.Craft
                    ? (await data.GetEquipmentCraftCostsAsync(server, [id], token)).GetValueOrDefault(id) : null;
                rows = [.. rows, ForgemagedEquipmentStock.Project(key, equipment, "workshop", 1, DateTime.MinValue,
                    null, observed, new(runes, context.ResalePrices), context, acquisition, craft)];
            }
            var runeIds = rows.SelectMany(row => row.Attempts).Select(attempt => attempt.Rune.Id).Distinct().ToArray();
            var runeIcons = runeIds.Length > 0 ? await data.GetRuneIconIdsAsync(runeIds, token) : new Dictionary<long, long>();
            return new EquipmentRead(rows, runeIcons);
        });
        if (_disposed || source?.Id != Source?.Id || _target != (targetId, targetKey)) return;
        if (loaded && _load.Value is { } result)
        {
            _rows = result.Rows;
            _runeIcons = result.RuneIcons;
            try { await EquipmentLoaded.InvokeAsync(_rows.Select(row => row.Equipment).DistinctBy(item => item.DofusDbId).ToArray()); }
            catch (Exception error) { _preparationError = true; Logger.LogWarning(error, "Could not prepare owned equipment filters"); }
        }
        else if (_load.Error is { } error) Logger.LogWarning(error, "Could not load owned equipment");
    }

    private void SaveAcquisition(OwnedForgemagingEquipment row, EquipmentAcquisition acquisition)
    {
        if (_store is null || row.Quantity != 1 || ServerName is not { } server || Source is not { } source ||
            !source.Containers.Any(container => container.Complete && !container.Stale &&
                container.Items.Any(item => item.Quantity == 1 && item.ItemId == (ulong)row.Equipment.DofusDbId &&
                    ForgemagedEquipmentStock.InstanceKey(server, row.Equipment.DofusDbId, item.Uid) == row.Key)))
            throw new InvalidOperationException("Cet équipement n’est plus disponible dans le stock synchronisé.");

        _store.RecordAcquisition(server, row.Equipment.DofusDbId, row.Key, acquisition);
    }

    private void QueueRefresh()
    {
        if (_disposed || Interlocked.Exchange(ref _reloadQueued, 1) != 0) return;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(220);
            Interlocked.Exchange(ref _reloadQueued, 0);
            if (_disposed) return;
            var refresh = RefreshAsync();
            StateHasChanged();
            await refresh;
            if (!_disposed) StateHasChanged();
        });
    }

    private void HistoryChanged(string server)
    {
        if (string.Equals(server, ServerName, StringComparison.OrdinalIgnoreCase)) QueueRefresh();
    }

    private void MarketChanged(object? sender, MarketDataChangedEventArgs change)
    {
        if (Filters is null || !string.Equals(change.ServerName, ServerName, StringComparison.OrdinalIgnoreCase)) return;
        if (change.ObjectType == MarketObjectType.Rune ||
            (change.ObjectType == MarketObjectType.Equipment && _rows.Any(row => row.Equipment.DofusDbId == change.DofusDbId)) ||
            ((change.ObjectType is MarketObjectType.Resource or MarketObjectType.Equipment) &&
                _rows.Any(row => row.Acquisition?.Kind == EquipmentAcquisitionKind.Craft)))
            QueueRefresh();
    }

    private static bool MatchesRunes(OwnedForgemagingEquipment row, SearchItemsModel filters)
    {
        if (filters.RuneFilters.Count == 0) return true;
        bool Matches(RuneFilterCriterion rune) => row.Roll?.Any(line => line.Characteristic == rune.Characteristic && line.Current > 0) == true;
        return filters.RuneMatchMode == RuneFilterMatchMode.All ? filters.RuneFilters.All(Matches) : filters.RuneFilters.Any(Matches);
    }
    private static string Origin(OwnedForgemagingEquipment row) => $"{(row.Container switch { "bank" => "Banque", "workshop" => "Atelier", _ => "Inventaire" })} : {row.Quantity:N0}";
    private static CrushingResultSummary OwnedCrushingSummary(OwnedForgemagingEquipment row)
    {
        double? value = row.Crushing?.Target?.Value;
        return new(value, row.Gain, value - row.Gain);
    }

    public void Dispose()
    {
        _disposed = true;
        _load.Dispose();
        if (_stock is not null) _stock.Changed -= QueueRefresh;
        if (_clients is not null) _clients.Changed -= QueueRefresh;
        if (_store is not null) _store.GameHistoryChanged -= HistoryChanged;
        if (_market is not null) _market.Changed -= MarketChanged;
    }
}
