@using BestCrush.Domain.Models
@using BestCrush.Domain.Services
@using BestCrush.Models
@inject ItemsService ItemsService

<button type="button" @onclick="HandleClickAsync" id="item-icon-@GetHashCode()"
        class="btn p-0"
        data-bs-toggle="tooltip"
        data-bs-title="@TooltipText"
        data-bs-html="@(TooltipIsHtml ? "true" : "false")"
        data-bs-custom-class="multiline-tooltip">
    <div class="d-flex align-items-center justify-content-center position-relative"
         style="width:@(BackgroundSizeInPx)px; height:@(BackgroundSizeInPx)px">
        @if (_loadingIcon)
        {
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        }
        else if (_icon is not null)
        {
            @switch (Background)
            {
                case IconBackground.Slot:
                    <img class="position-absolute top-0 bottom-0 start-0 end-0" src="img/slot_bg.png" width="@BackgroundSizeInPx" height="@BackgroundSizeInPx" alt="Item icon"/>
                    break;
            }

            <div class="position-absolute top-0 bottom-0 start-0 end-0 d-flex align-items-center justify-content-center">
                <img src="data:@_icon" width="@IconSizeInPx" height="@IconSizeInPx" alt="Item icon"/>
            </div>
        }
        else
        {
            @switch (Size)
            {
                case Size.Small:
                    <span class="fw-bold small">?</span>
                    break;
                case Size.Medium:
                    <span class="fw-bold fs-3">?</span>
                    break;
                case Size.Large:
                    <span class="fw-bold fs-1">?</span>
                    break;
            }
        }
    </div>
</button>

@code {
    [CascadingParameter] public BestCrush.Services.ItemCopyFeedback? CopyFeedback { get; set; }

    private async Task HandleClickAsync()
    {
        if (OnClick.HasDelegate) await OnClick.InvokeAsync();
        else if (CopyFeedback is not null) await CopyFeedback.CopyAsync(Item?.Name);
    }

    string? _icon;
    bool _loadingIcon;
    bool _iconRequested;
    long? _requestedIconId;
    int _iconRequestVersion;

    int BackgroundSizeInPx =>
        Size switch
        {
            Size.Tiny => 32,
            Size.Small => 48,
            Size.Medium => 64,
            Size.Large => 128,
            _ => throw new ArgumentOutOfRangeException()
        };

    int IconSizeInPx =>
        Background == IconBackground.None
            ? BackgroundSizeInPx
            : Size switch
            {
                Size.Tiny => 24,
                Size.Small => 32,
                Size.Medium => 48,
                Size.Large => 96,
                _ => throw new ArgumentOutOfRangeException()
            };

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public IItem? Item { get; init; }

    [Parameter]
    public bool TooltipIsHtml { get; init; }

    [Parameter]
    public Size Size { get; init; } = Size.Medium;

    [Parameter]
    public IconBackground Background { get; init; } = IconBackground.None;

    protected override async Task OnParametersSetAsync()
    {
        long? iconId = Item?.DofusDbIconId;
        // A stock toggle or sort changes amounts, not the image. Keep the loaded
        // bytes instead of rereading and re-encoding the disk cache on every render.
        if (_iconRequested && _requestedIconId == iconId) return;
        _iconRequested = true;
        _requestedIconId = iconId;
        int version = ++_iconRequestVersion;
        _icon = null;
        if (iconId is null)
        {
            _loadingIcon = false;
            return;
        }
        _loadingIcon = true;
        try
        {
            var icon = await ItemsService.GetItemIconAsync(iconId.Value);
            if (version == _iconRequestVersion) _icon = icon;
        }
        catch
        {
            if (version == _iconRequestVersion) _iconRequested = false;
            throw;
        }
        finally
        {
            if (version == _iconRequestVersion) _loadingIcon = false;
        }
    }
    [Parameter]
    public string? Tooltip { get; init; }

    string? TooltipText =>
        string.IsNullOrWhiteSpace(Tooltip)
            ? Item?.Name
            : Tooltip;

}