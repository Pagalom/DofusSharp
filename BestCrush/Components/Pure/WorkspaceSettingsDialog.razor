@using BestCrush.Domain.Models
@using BestCrush.Domain.Services
@using BestCrush.Models
@inject BestCrush.Services.BestCrushSettingsService BestCrushSettings
@inject IDataPriorityProvider DataPriorityProvider
@inject BestCrush.Services.OverlayService OverlayService

@if (Visible)
{
<div style="
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;"
    @onclick="CloseSettings">

    <div class="card shadow"
        style="
            width: 540px;
            max-width: calc(100vw - 40px);
            padding: 20px;
            max-height: calc(100vh - 40px);
            overflow-y: auto;"
        @onclick:stopPropagation="true">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="m-0">
                Paramètres
            </h4>

            <button type="button"
                    class="btn-close"
                    @onclick="CloseSettings">
            </button>
        </div>

        <div class="border rounded p-3 mb-3">
            <h6 class="mb-3">Marché &amp; capture</h6>

            <label class="form-label fw-bold">
                Données capturées automatiquement
            </label>

            <div class="text-muted small mb-3">
                Choisis quelles données BestCrush est autorisé
                à enregistrer automatiquement depuis Dofus.
            </div>

            <div class="form-check form-switch mb-2">
                <input class="form-check-input"
                       type="checkbox"
                       id="capture-equipment"
                       @bind="BestCrushSettings.EquipmentCaptureEnabled" />
                <label class="form-check-label" for="capture-equipment">
                    Prix des équipements
                </label>
            </div>

            <div class="form-check form-switch mb-2">
                <input class="form-check-input"
                       type="checkbox"
                       id="capture-runes"
                       @bind="BestCrushSettings.RuneCaptureEnabled" />
                <label class="form-check-label" for="capture-runes">
                    Prix des runes
                </label>
            </div>

            <div class="form-check form-switch mb-2">
                <input class="form-check-input"
                       type="checkbox"
                       id="capture-resources"
                       @bind="BestCrushSettings.ResourceCaptureEnabled" />
                <label class="form-check-label" for="capture-resources">
                    Prix des ressources
                </label>
            </div>

            <div class="form-check form-switch mb-4">
                <input class="form-check-input"
                       type="checkbox"
                       id="capture-coefficients"
                       @bind="BestCrushSettings.CoefficientCaptureEnabled" />
                <label class="form-check-label" for="capture-coefficients">
                    Coefficients de brisage
                </label>
            </div>

            <label class="form-label fw-bold">
                Priorité des données
            </label>

            <div class="text-muted small mb-2">
                Détermine quelle source est utilisée lorsqu'une
                valeur manuelle et une capture jeu sont disponibles.
            </div>

            <select class="form-select"
                    value="@DataPriorityProvider.Priority"
                    @onchange="OnDataPriorityChanged">
                <option value="@DataPriority.Manual">Manuel</option>
                <option value="@DataPriority.InGameAutomatic">Capture jeu</option>
            </select>
        </div>

        <div class="border rounded p-3 mb-3">
            <h6 class="mb-3">Concassage &amp; rentabilité</h6>

            <label class="form-label fw-bold"
                   for="crush-yield-estimation-mode">
                Estimation du jet de concassage
            </label>

            <div class="text-muted small mb-2">
                Détermine le jet utilisé pour estimer le nombre
                de runes obtenu lors du concassage.
            </div>

            <select id="crush-yield-estimation-mode"
                    class="form-select"
                    value="@BestCrushSettings.CrushYieldEstimationMode"
                    @onchange="OnCrushYieldEstimationModeChanged">
                <option value="@CrushYieldEstimationMode.Conservative">
                    Jet prudent de concassage
                </option>
                <option value="@CrushYieldEstimationMode.Average">
                    Jet moyen de concassage
                </option>
            </select>

            <div class="text-muted small mt-2 mb-4">
                Prudent : utilise le jet minimum de chaque caractéristique.
                Moyen : utilise la moyenne entre le minimum et le maximum.
            </div>

            <label class="form-label fw-bold"
                   for="crush-value-discount">
                Décote de valorisation du concassage
            </label>

            <div class="text-muted small mb-2">
                Réduit la valeur théorique des runes pour estimer
                plus prudemment la valeur réellement récupérable.
                Cette décote est aussi utilisée pour les bénéfices et rendements.
            </div>

            <div class="input-group mb-4">
                <input id="crush-value-discount"
                       type="number"
                       class="form-control"
                       min="0"
                       max="100"
                       step="0.5"
                       @bind="BestCrushSettings.CrushValueDiscountPercent" />
                <span class="input-group-text">%</span>
            </div>

            <label class="form-label fw-bold"
                   for="target-roi">
                Objectif de rentabilité
            </label>

            <div class="text-muted small mb-2">
                Détermine le prix maximal d’achat en concassage
                et les seuils d’achat et de revente dans Achat / Vente.
            </div>

            <div class="input-group">
                <input id="target-roi"
                       type="number"
                       class="form-control"
                       min="0"
                       max="1000"
                       step="1"
                       @bind="BestCrushSettings.TargetRoiPercent" />
                <span class="input-group-text">%</span>
            </div>
        </div>

        <div class="border rounded p-3 mb-3">
            <h6 class="mb-3">Interface &amp; overlays</h6>

            <div class="text-muted small mb-3">
                Les positions et tailles sont conservées automatiquement
                entre les lancements et les mises à jour.
            </div>

            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="RestoreOverlayLayouts">
                Restaurer la position par défaut des overlays
            </button>

            @if (!string.IsNullOrWhiteSpace(
                _overlayLayoutResetMessage))
            {
                <div class="text-success small mt-2">
                    @_overlayLayoutResetMessage
                </div>
            }
        </div>

        <div class="border rounded p-3">
            <h6 class="mb-3">Développement</h6>

            <div class="text-muted small mb-3">
                Conserve les artefacts nécessaires pour diagnostiquer
                la capture passive et la lecture d'infobulle F8.
            </div>

            <div class="form-check form-switch">
                <input class="form-check-input"
                       type="checkbox"
                       id="devtool-keep-debug-artifacts"
                       @bind="BestCrushSettings.DevTool_KeepDebugArtifacts" />
                <label class="form-check-label"
                       for="devtool-keep-debug-artifacts">
                    Conserver les artefacts de debug
                </label>
            </div>

            <div class="text-muted small mt-2">
                Désactivé : les captures temporaires F8
                sont supprimées et aucune trace réseau détaillée n'est écrite.
                Activé : les fichiers sont conservés dans
                %LOCALAPPDATA%\BestCrush\DebugCaptures.
            </div>
        </div>
    </div>
</div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnYieldChanged { get; set; }
    private string? _overlayLayoutResetMessage;
    private Task CloseSettings() => OnClose.InvokeAsync();
    private void RestoreOverlayLayouts()
    {
        OverlayService.RestoreOverlayLayoutsToDefaults();
        _overlayLayoutResetMessage = "Positions et tailles des overlays restaurées.";
    }
    private void OnDataPriorityChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse(args.Value?.ToString(), out DataPriority priority))
            DataPriorityProvider.Priority = priority;
    }
    private async Task OnCrushYieldEstimationModeChanged(ChangeEventArgs args)
    {
        if (!Enum.TryParse(args.Value?.ToString(), out CrushYieldEstimationMode mode) ||
            BestCrushSettings.CrushYieldEstimationMode == mode) return;
        BestCrushSettings.CrushYieldEstimationMode = mode;
        await OverlayService.RefreshFocusedProfitabilityAsync();
        await OnYieldChanged.InvokeAsync();
    }
}
