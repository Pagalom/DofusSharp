@using BestCrush.Domain.Models
@using BestCrush.Models
<div id="search-items-form">
    <div class="crushing-search-row">
        <div class="crushing-search"><ServiceSearch Value="@Model.SearchText" ValueChanged="ChangeSearchAsync" Placeholder="Filtrer les équipements par nom…" Label="Rechercher dans la liste des équipements" Disabled="Disabled" /></div>
        @if (Actions is not null) { <div class="crushing-choice-actions">@Actions</div> }
    </div>
    <ServiceFilters Count="ActiveCount" Reset="ResetAllAsync" Disabled="Disabled" Label="Filtres avancés"
                    Expanded="_advancedVisible" ExpandedChanged="value => _advancedVisible = value">
        <Chips>
            @if (Model.CraftJobId is not null) { <FilterChip Label="@($"Métier : {JobOptions.FirstOrDefault(x => x.Value == Model.CraftJobId.ToString())?.Label}")" Removed="() => SelectJob(string.Empty)" Disabled="Disabled" /> }
            @foreach (var type in SelectedTypes) { <FilterChip Label="@type.ToDisplayName()" Removed="() => TypesChanged(SelectedTypes.Where(x => x != type).ToArray())" Disabled="Disabled" /> }
            @if (Model.LevelMin is { } min) { <FilterChip Label="@($"Niveau ≥ {min}")" Removed="() => Model.LevelMin = null" Disabled="Disabled" /> }
            @if (Model.LevelMax is { } max) { <FilterChip Label="@($"Niveau ≤ {max}")" Removed="() => Model.LevelMax = null" Disabled="Disabled" /> }
            @foreach (var criterion in Model.RuneFilters.ToArray()) { <FilterChip Label="@RuneLabel(criterion.RuneName)" Removed="() => RemoveRuneFilter(criterion)" Disabled="Disabled" /> }
            @if (Model.MinimumRoiPercent is { } roi) { <FilterChip Label="@($"ROI ≥ {roi:N0} %")" Removed="ClearMinimumRoi" Disabled="Disabled" /> }
            @if (Model.MinimumBenefit is { } gain) { <FilterChip Label="@($"Bénéfice ≥ {gain:N0} K")" Removed="ClearMinimumBenefit" Disabled="Disabled" /> }
            @if (Model.ProfitabilityMode != ProfitabilityFilterMode.Best) { <FilterChip Label="@(Model.ProfitabilityMode == ProfitabilityFilterMode.Craft ? "Craft uniquement" : "Achat uniquement")" Removed="() => Model.ProfitabilityMode = ProfitabilityFilterMode.Best" Disabled="Disabled" /> }
            @if (Model.CompleteDataOnly) { <FilterChip Label="Données complètes" Removed="() => Model.CompleteDataOnly = false" Disabled="Disabled" /> }
            @if (Model.FreshDataOnly) { <FilterChip Label="Données fraîches" Removed="() => Model.FreshDataOnly = false" Disabled="Disabled" /> }
            @if (Model.RespectJobLevels) { <FilterChip Label="Niveaux de métier" Removed="() => Model.RespectJobLevels = false" Disabled="Disabled" /> }
            @if (Model.RequireCoefficient) { <FilterChip Label="Coefficient connu" Removed="() => Model.RequireCoefficient = false" Disabled="Disabled" /> }
        </Chips>
        <ChildContent>
            <h3><i class="bi bi-box-seam" aria-hidden="true"></i>Équipements</h3>
    <div class="visual-equipment-fields">
        <div class="visual-equipment-field"><span class="d-block fw-semibold mb-1">Métier de fabrication</span>
            <JobFilter Inline="true" Options="JobOptions" SelectedValue="@(Model.CraftJobId?.ToString() ?? "")"
                SelectedValueChanged="SelectJob" Disabled="Disabled" DisclosureGroup="@_filterDisclosureGroup" />
        </div>
        <div class="visual-equipment-field"><span class="d-block fw-semibold mb-1">Types d’objet</span>
            <EquipmentTypeFilter Inline="true" AvailableTypes="AvailableTypes" SelectedTypes="SelectedTypes" SelectedTypesChanged="TypesChanged"
                Disabled="Disabled" DisclosureGroup="@_filterDisclosureGroup" AllTypesLabel="@(Model.CraftJobId is null ? "Tous" : "Tous du métier")"
                AllTypesDescription="@(Model.CraftJobId is null ? "Tous les types inclus" : "Tous les types du métier inclus")" />
        </div>
    </div>
            <label class="d-block mb-3" style="max-width:360px">Niveau
                <span class="input-group"><InputNumber @bind-Value="Model.LevelMin" @bind-Value:after="LevelBoundsChanged" class="form-control" placeholder="Min" aria-label="Niveau minimum" disabled="@Disabled" /><span class="input-group-text">à</span><InputNumber @bind-Value="Model.LevelMax" @bind-Value:after="LevelBoundsChanged" class="form-control" placeholder="Max" aria-label="Niveau maximum" disabled="@Disabled" /></span>
            </label>
    @if (JobsLoading)
    {
        <p class="small text-secondary" role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Chargement des métiers…</p>
    }
    @if (JobsError is not null)
    {
        <div class="small text-warning mb-3" role="status">@JobsError
            <button class="btn btn-sm btn-outline-secondary ms-2" type="button" @onclick="RetryJobs" disabled="@(Disabled || JobsLoading)">Réessayer</button>
        </div>
    }
            <div class="row g-4">
                <div class="col-12 col-xl-8">
                    <h3><i class="bi bi-gem" aria-hidden="true"></i>Runes / caractéristiques</h3>
                    <div class="rune-picker-toolbar">
                        <div class="rune-search"><ServiceSearch @bind-Value="_runeSearch" Placeholder="Chercher une rune…" Label="Chercher parmi les runes" Disabled="Disabled" /></div>
                        <label>Correspondance<InputSelect TValue="RuneFilterMatchMode" @bind-Value="Model.RuneMatchMode" class="form-select form-select-sm" disabled="@Disabled">
                            <option value="@RuneFilterMatchMode.Any">Au moins une</option><option value="@RuneFilterMatchMode.All">Toutes</option>
                        </InputSelect></label>
                    </div>
                    <div class="rune-families" role="group" aria-label="Famille des runes">
                        @foreach (var family in RuneFamilies)
                        {
                            <button type="button" class="btn btn-sm @(_runeFamily == family ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@(_runeFamily == family ? "true" : "false")" disabled="@Disabled" @onclick="() => _runeFamily = family">@family</button>
                        }
                    </div>
                    <div class="rune-choice-grid" role="group" aria-label="Runes à obtenir">
                        @foreach (var rune in VisibleRunes)
                        {
                            <VisualFilterChoice Label="@RuneLabel(rune.Name)" Image="@(rune.DofusDbIconId is { } icon ? $"img/runes/{icon}.png" : "img/runes/unknown.svg")" FallbackImage="img/runes/unknown.svg" Selected="@Model.RuneFilters.Any(x => x.DofusDbId == rune.DofusDbId)"
                                                Pressed="() => ToggleRuneFilter(rune)" Disabled="Disabled" />
                        }
                    </div>
                    @if (!VisibleRunes.Any()) { <p class="small text-secondary mt-2">Aucune rune ne correspond à cette recherche.</p> }
                </div>
                <div class="col-12 col-xl-4">
                    <h3><i class="bi bi-graph-up-arrow" aria-hidden="true"></i>Rentabilité</h3>

                    <label class="form-label small mb-1">Source économique</label>
                    <InputSelect TValue="ProfitabilityFilterMode"
                                 @bind-Value="Model.ProfitabilityMode"
                                 class="form-select form-select-sm mb-2"
                                 disabled="@Disabled">
                        <option value="@ProfitabilityFilterMode.Best">Meilleur achat / craft</option>
                        <option value="@ProfitabilityFilterMode.Purchase">Achat uniquement</option>
                        <option value="@ProfitabilityFilterMode.Craft">Craft uniquement</option>
                    </InputSelect>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small mb-1">ROI min.</label>
                            <div class="input-group input-group-sm">
                                <InputNumber @bind-Value="Model.MinimumRoiPercent"
                                             class="form-control"
                                             placeholder="—"
                                             disabled="@Disabled" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label small mb-1">Bénéfice min.</label>
                            <div class="input-group input-group-sm">
                                <InputNumber @bind-Value="Model.MinimumBenefit"
                                             class="form-control"
                                             placeholder="—"
                                             disabled="@Disabled" />
                                <span class="input-group-text">K</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-check form-switch">
                        <InputCheckbox @bind-Value="Model.CompleteDataOnly"
                                       class="form-check-input"
                                       disabled="@Disabled" />
                        <label class="form-check-label small">Données complètes uniquement</label>
                    </div>

                    <div class="form-check form-switch">
                        <InputCheckbox @bind-Value="Model.FreshDataOnly"
                                       class="form-check-input"
                                       disabled="@Disabled" />
                        <label class="form-check-label small">Données fraîches uniquement</label>
                    </div>

                    <label class="form-check form-switch" title="@ProfessionFilterUnavailableReason">
                        <input id="crushing-respect-job-levels" type="checkbox" class="form-check-input" checked="@(Model.RespectJobLevels && CanUseProfessionLevels)"
                               disabled="@(Disabled || !CanUseProfessionLevels)" @onchange="ToggleProfessionLevels" />
                        <span class="form-check-label small">Prise en compte niveau métier</span>
                    </label>
                    <div class="form-check form-switch">
                        <InputCheckbox @bind-Value="Model.RequireCoefficient"
                                       class="form-check-input"
                                       disabled="@Disabled" />
                        <label class="form-check-label small">Coefficient disponible</label>
                    </div>
                </div>
            </div>

        </ChildContent>
    </ServiceFilters>
</div>

@code {

    [Parameter]
    public required SearchItemsModel Model { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public IReadOnlyCollection<Rune> AvailableRunes { get; set; } =
        Array.Empty<Rune>();

    [Parameter] public BestCrush.Services.EquipmentJobFilterCatalog? JobCatalog { get; set; }
    [Parameter] public bool JobsLoading { get; set; }
    [Parameter] public string? JobsError { get; set; }
    [Parameter] public EventCallback RetryJobs { get; set; }
    [Parameter] public EventCallback JobSelectionChanged { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public EventCallback SearchChanged { get; set; }
    private async Task ChangeSearchAsync(string value)
    {
        Model.SearchText = value;
        await SearchChanged.InvokeAsync();
    }
    [Parameter] public int? PlayerLevel { get; set; }
    [Parameter] public IReadOnlyDictionary<string, int>? ProfessionLevels { get; set; }
    private bool CanUseProfessionLevels => BestCrush.Services.CrushingProfessionFilterRules.CanEnable(
        PlayerLevel, ProfessionLevels, Model.LevelMin, Model.LevelMax);
    private string? ProfessionFilterUnavailableReason => BestCrush.Services.CrushingProfessionFilterRules.UnavailableReason(
        PlayerLevel, ProfessionLevels, Model.LevelMin, Model.LevelMax);
    private void LevelBoundsChanged() { if (!CanUseProfessionLevels) Model.RespectJobLevels = false; }
    private void ToggleProfessionLevels(ChangeEventArgs args) => Model.RespectJobLevels = CanUseProfessionLevels && args.Value is true;
    private int ActiveCount => SelectedTypes.Count + Model.RuneFilters.Count +
        new[] { Model.CraftJobId is not null, Model.LevelMin is not null, Model.LevelMax is not null,
            Model.MinimumRoiPercent is not null, Model.MinimumBenefit is not null,
            Model.CompleteDataOnly, Model.FreshDataOnly, Model.RequireCoefficient, Model.RespectJobLevels,
            Model.ProfitabilityMode != ProfitabilityFilterMode.Best }.Count(x => x);
    private async Task ResetAllAsync()
    {
        Model.LevelMin = Model.LevelMax = null; Model.CraftJobId = null;
        Model.EquipmentType.SetSelectedTypes([]); ResetAdvanced();
        await JobSelectionChanged.InvokeAsync();
    }
    private SearchItemsModel? _previousModel;
    private BestCrush.Services.EquipmentJobFilterCatalog? _previousCatalog;
    private long? _previousJob;
    private readonly string _filterDisclosureGroup = $"crushing-filters-{Guid.NewGuid():N}";
    private IReadOnlyList<JobFilter.Option> JobOptions => (JobCatalog?.Jobs ?? Array.Empty<BestCrush.Services.CraftingJob>())
        .Select(job => new JobFilter.Option(job.Id.ToString(), job.Name))
        .Concat(Model.CraftJobId is { } selected && JobCatalog?.ContainsJob(selected) != true
            ? new[] { new JobFilter.Option(selected.ToString(), $"Métier #{selected} · indisponible") } : Array.Empty<JobFilter.Option>()).ToArray();
    private Task SelectJob(string value)
    {
        if (Disabled) return Task.CompletedTask;
        Model.CraftJobId = long.TryParse(value, out long id) ? id : null;
        return JobChanged();
    }
    private IReadOnlyCollection<EquipmentType> AvailableTypes => JobCatalog?.TypesFor(Model.CraftJobId) ??
        (Model.CraftJobId is null ? EquipmentTypesFilter.SupportedTypes : Array.Empty<EquipmentType>());
    private IReadOnlyCollection<EquipmentType> SelectedTypes => Model.EquipmentType.GetSelectedTypes();
    protected override void OnParametersSet()
    {
        LevelBoundsChanged();
        if (_previousModel != Model || _previousCatalog != JobCatalog || _previousJob != Model.CraftJobId)
        {
            if (Model.CraftJobId is { } job && JobCatalog?.ContainsJob(job) == true) NormalizeJobTypes();
            _previousModel = Model; _previousCatalog = JobCatalog; _previousJob = Model.CraftJobId;
        }
    }
    private Task JobChanged()
    {
        NormalizeJobTypes();
        return JobSelectionChanged.InvokeAsync();
    }
    private void NormalizeJobTypes()
    {
        if (Model.CraftJobId is { } job && JobCatalog?.ContainsJob(job) == true)
            Model.EquipmentType.SetSelectedTypes(SelectedTypes.Where(AvailableTypes.Contains));
    }
    private void TypesChanged(IReadOnlyCollection<EquipmentType> types)
    {
        if (!Disabled) Model.EquipmentType.SetSelectedTypes(types.Where(AvailableTypes.Contains));
    }

    public void CollapseAdvanced()
    {
        if (!_advancedVisible) return;
        _advancedVisible = false;
        StateHasChanged();
    }
    private static string RuneLabel(string name) => name.StartsWith("Rune de ", StringComparison.OrdinalIgnoreCase) ? name[8..] :
        name.StartsWith("Rune ", StringComparison.OrdinalIgnoreCase) ? name[5..] : name;

    private bool _advancedVisible;
    private string _runeSearch = "";
    private string _runeFamily = "Caractéristiques";
    private static readonly string[] RuneFamilies = ["Caractéristiques", "Dommages", "Résistances", "Toutes"];
    private static string RuneFamily(Rune rune) => rune.Characteristic.ToString().StartsWith("Damage", StringComparison.Ordinal) ? "Dommages" :
        rune.Characteristic.ToString().StartsWith("Resistance", StringComparison.Ordinal) ? "Résistances" : "Caractéristiques";
    private IEnumerable<Rune> VisibleRunes => AvailableRunes.Where(rune =>
        (string.IsNullOrWhiteSpace(_runeSearch) ? _runeFamily == "Toutes" || RuneFamily(rune) == _runeFamily :
            rune.Name.Contains(_runeSearch.Trim(), StringComparison.CurrentCultureIgnoreCase)))
        .OrderBy(rune => rune.Name, StringComparer.CurrentCultureIgnoreCase);
    private void ToggleRuneFilter(Rune rune)
    {
        if (Disabled) return;
        var existing = Model.RuneFilters.FirstOrDefault(x => x.DofusDbId == rune.DofusDbId);
        if (existing is not null) Model.RuneFilters.Remove(existing);
        else Model.RuneFilters.Add(new() { DofusDbId = rune.DofusDbId, Characteristic = rune.Characteristic, RuneName = rune.Name });
    }

    private void ToggleAdvanced()
    {
        _advancedVisible = !_advancedVisible;
    }

    private void RemoveRuneFilter(
        RuneFilterCriterion criterion)
    {
        Model.RuneFilters.Remove(criterion);
    }

    private void ClearMinimumRoi()
    {
        Model.MinimumRoiPercent = null;
    }

    private void ClearMinimumBenefit()
    {
        Model.MinimumBenefit = null;
    }

    private void ResetAdvanced()
    {
        Model.RuneFilters.Clear();
        Model.RuneMatchMode = RuneFilterMatchMode.Any;
        Model.ProfitabilityMode = ProfitabilityFilterMode.Best;
        Model.MinimumRoiPercent = null;
        Model.MinimumBenefit = null;
        Model.CompleteDataOnly = false;
        Model.FreshDataOnly = false;
        Model.RequireCoefficient = false;
        Model.RespectJobLevels = false;
    }

}
