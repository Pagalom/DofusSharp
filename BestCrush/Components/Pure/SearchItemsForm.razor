@using BestCrush.Domain.Models
@using BestCrush.Models
<div id="search-items-form">
    <div class="d-flex flex-column align-items-center mb-3">
        <div class="fw-semibold mb-1">Recherche</div>
        <InputText @bind-Value="Model.SearchText"
                   class="form-control"
                   style="max-width:420px"
                   placeholder="Nom de l'équipement"
                   disabled="@Disabled" />
    </div>
    <div class="d-flex flex-column align-items-center mb-3">
        <div class="fw-semibold mb-1">Niveau</div>
        <div class="input-group justify-content-center">
            <InputNumber @bind-Value="Model.LevelMin" class="form-control flex-grow-0" style="width:100px" placeholder="Min" aria-label="Min" disabled="@Disabled"/>
            <span class="input-group-text">à</span>
            <InputNumber @bind-Value="Model.LevelMax" class="form-control flex-grow-0" style="width:100px" placeholder="Max" aria-label="Max" disabled="@Disabled"/>
        </div>
    </div>
    <div class="d-flex justify-content-center gap-3 flex-wrap mb-3">
        <div class="d-flex flex-column align-items-center">
            <div class="fw-semibold mb-1">Équipements</div>
            <div class="input-group flex-nowrap">
                <InputCheckbox @bind-Value="Model.EquipmentType.Amulet" class="btn-check" id="btn-amulet" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-amulet" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Amulet.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Amulet" Href="img/necklace.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Ring" class="btn-check" id="btn-ring" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-ring" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Ring.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Ring" Href="img/ring.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Belt" class="btn-check" id="btn-belt" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-belt" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Belt.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Belt" Href="img/belt.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Boots" class="btn-check" id="btn-boots" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-boots" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Boots.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Boots" Href="img/boots.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Hat" class="btn-check" id="btn-hat" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-hat" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Hat.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Hat" Href="img/hat.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Cloak" class="btn-check" id="btn-cloak" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-cloak" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Cloak.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Cloak" Href="img/cape.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Shield" class="btn-check" id="btn-shield" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-shield" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Shield.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Shield" Href="img/shield.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Trophy" class="btn-check" id="btn-trophy" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-trophy" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Trophy.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Trophy" Href="img/trophy.svg"/>
                </label>

                <button type="button" class="btn btn-light border" @onclick="ResetEquipments" data-bs-toggle="tooltip" data-bs-title="Réinitialiser">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <div class="d-flex flex-column align-items-center">
            <div class="fw-semibold mb-1">Armes</div>
            <div class="input-group flex-nowrap">
                <InputCheckbox @bind-Value="Model.EquipmentType.Bow" class="btn-check" id="btn-bow" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-bow" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Bow.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Bow" Href="img/bow.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Wand" class="btn-check" id="btn-wand" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-wand" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Wand.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Wand" Href="img/wand.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Staff" class="btn-check" id="btn-staff" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-staff" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Staff.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Staff" Href="img/staff.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Dagger" class="btn-check" id="btn-dagger" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-dagger" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Dagger.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Dagger" Href="img/dagger.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Sword" class="btn-check" id="btn-sword" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-sword" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Sword.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Sword" Href="img/sword.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Scythe" class="btn-check" id="btn-scythe" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-scythe" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Scythe.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Scythe" Href="img/scythe.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Axe" class="btn-check" id="btn-axe" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-axe" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Axe.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Axe" Href="img/axe.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Lance" class="btn-check" id="btn-lance" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-lance" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Lance.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Lance" Href="img/lance.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Hammer" class="btn-check" id="btn-hammer" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-hammer" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Hammer.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Hammer" Href="img/hammer.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Shovel" class="btn-check" id="btn-shovel" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-shovel" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Shovel.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Shovel" Href="img/shovel.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Pickaxe" class="btn-check" id="btn-pickaxe" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-pickaxe" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Pickaxe.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Pickaxe" Href="img/pickaxe.svg"/>
                </label>

                <InputCheckbox @bind-Value="Model.EquipmentType.Tool" class="btn-check" id="btn-tool" autocomplete="off" disabled="@Disabled"/>
                <label class="btn btn-light border" for="btn-tool" data-bs-toggle="tooltip" data-bs-title="@EquipmentType.Tool.ToDisplayName()">
                    <Svg Width="24" Height="24" Alt="Tool" Href="img/tool.svg"/>
                </label>

                <button type="button" class="btn btn-light border" @onclick="ResetWeapons" data-bs-toggle="tooltip" data-bs-title="Réinitialiser">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-center mb-3">
        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                @onclick="ToggleAdvanced"
                disabled="@Disabled">
            @(_advancedVisible ? "Masquer les filtres avancés" : "Filtres avancés")
        </button>
    </div>

    @if (HasAdvancedFilters())
    {
        <div class="d-flex justify-content-center align-items-center gap-1 flex-wrap mb-3">
            <span class="small text-secondary me-1">Filtres actifs :</span>

            @foreach (RuneFilterCriterion criterion in Model.RuneFilters.ToArray())
            {
                <button type="button"
                        class="btn btn-outline-secondary btn-sm py-0"
                        title="Retirer ce filtre"
                        @onclick="() => RemoveRuneFilter(criterion)"
                        disabled="@Disabled">
                    @criterion.RuneName ×
                </button>
            }

            @if (Model.MinimumRoiPercent is double minimumRoi)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm py-0"
                        @onclick="ClearMinimumRoi" disabled="@Disabled">
                    ROI ≥ @minimumRoi.ToString("0.##") % ×
                </button>
            }

            @if (Model.MinimumBenefit is double minimumBenefit)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm py-0"
                        @onclick="ClearMinimumBenefit" disabled="@Disabled">
                    Bénéfice ≥ @minimumBenefit.ToString("N0") K ×
                </button>
            }

            @if (Model.CompleteDataOnly)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm py-0"
                        @onclick="() => Model.CompleteDataOnly = false" disabled="@Disabled">
                    Données complètes ×
                </button>
            }

            @if (Model.FreshDataOnly)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm py-0"
                        @onclick="() => Model.FreshDataOnly = false" disabled="@Disabled">
                    Données fraîches ×
                </button>
            }

            @if (Model.RequireCoefficient)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm py-0"
                        @onclick="() => Model.RequireCoefficient = false" disabled="@Disabled">
                    Coefficient connu ×
                </button>
            }
        </div>
    }

    @if (_advancedVisible)
    {
        <div class="border rounded p-3 mb-3">
            <div class="row g-3">
                <div class="col-12 col-lg-7">
                    <div class="fw-semibold mb-2">Runes / caractéristiques</div>

                    <div class="d-flex gap-2 align-items-end flex-wrap mb-2">
                        <div style="min-width:260px; flex:1">
                            <label class="form-label small mb-1">Ajouter une rune</label>
                            <InputSelect TValue="long?"
                                         @bind-Value="_runeToAdd"
                                         class="form-select form-select-sm"
                                         disabled="@Disabled">
                                <option value="">Choisir une rune...</option>
                                @foreach (Rune rune in AvailableRunes.OrderBy(r => r.Name))
                                {
                                    <option value="@rune.DofusDbId">@rune.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                @onclick="AddRuneFilter"
                                disabled="@(Disabled || _runeToAdd is null)">
                            Ajouter
                        </button>

                        <div style="min-width:170px">
                            <label class="form-label small mb-1">Correspondance</label>
                            <InputSelect TValue="RuneFilterMatchMode"
                                         @bind-Value="Model.RuneMatchMode"
                                         class="form-select form-select-sm"
                                         disabled="@Disabled">
                                <option value="@RuneFilterMatchMode.Any">Au moins une</option>
                                <option value="@RuneFilterMatchMode.All">Toutes</option>
                            </InputSelect>
                        </div>
                    </div>

                    @if (Model.RuneFilters.Count == 0)
                    {
                        <div class="text-secondary small">
                            Aucune rune sélectionnée.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (RuneFilterCriterion criterion in Model.RuneFilters.ToArray())
                            {
                                Rune? rune = AvailableRunes.FirstOrDefault(
                                    candidate => candidate.DofusDbId == criterion.DofusDbId);

                                <div class="d-flex align-items-center gap-2 border rounded px-2 py-1">
                                    @if (rune is not null)
                                    {
                                        <ItemIcon Item="rune"
                                                  Background="IconBackground.Slot"
                                                  Size="Size.Tiny" />
                                    }

                                    <span class="flex-grow-1 small fw-semibold text-decoration-underline"
                                          role="button"
                                          title="Cliquer pour copier le nom de la rune"
                                          @onclick="() => CopyTextAsync(criterion.RuneName)">
                                        @criterion.RuneName
                                    </span>

                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            title="Retirer"
                                            @onclick="() => RemoveRuneFilter(criterion)"
                                            disabled="@Disabled">
                                        ×
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="col-12 col-lg-5">
                    <div class="fw-semibold mb-2">Rentabilité</div>

                    <label class="form-label small mb-1">Source économique</label>
                    <InputSelect TValue="ProfitabilityFilterMode"
                                 @bind-Value="Model.ProfitabilityMode"
                                 class="form-select form-select-sm mb-2"
                                 disabled="@Disabled">
                        <option value="@ProfitabilityFilterMode.Best">Meilleur achat / craft</option>
                        <option value="@ProfitabilityFilterMode.Purchase">Achat uniquement</option>
                        <option value="@ProfitabilityFilterMode.Craft">Craft uniquement</option>
                    </InputSelect>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small mb-1">ROI min.</label>
                            <div class="input-group input-group-sm">
                                <InputNumber @bind-Value="Model.MinimumRoiPercent"
                                             class="form-control"
                                             placeholder="—"
                                             disabled="@Disabled" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label small mb-1">Bénéfice min.</label>
                            <div class="input-group input-group-sm">
                                <InputNumber @bind-Value="Model.MinimumBenefit"
                                             class="form-control"
                                             placeholder="—"
                                             disabled="@Disabled" />
                                <span class="input-group-text">K</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-check form-switch">
                        <InputCheckbox @bind-Value="Model.CompleteDataOnly"
                                       class="form-check-input"
                                       disabled="@Disabled" />
                        <label class="form-check-label small">Données complètes uniquement</label>
                    </div>

                    <div class="form-check form-switch">
                        <InputCheckbox @bind-Value="Model.FreshDataOnly"
                                       class="form-check-input"
                                       disabled="@Disabled" />
                        <label class="form-check-label small">Données fraîches uniquement</label>
                    </div>

                    <div class="form-check form-switch">
                        <InputCheckbox @bind-Value="Model.RequireCoefficient"
                                       class="form-check-input"
                                       disabled="@Disabled" />
                        <label class="form-check-label small">Coefficient disponible</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-3">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        @onclick="ResetAdvanced"
                        disabled="@Disabled">
                    Réinitialiser les filtres avancés
                </button>
            </div>
        </div>
    }
</div>

@code {

    [Parameter]
    public required SearchItemsModel Model { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public IReadOnlyCollection<Rune> AvailableRunes { get; set; } =
        Array.Empty<Rune>();

    private bool _advancedVisible;
    private long? _runeToAdd;

    private static Task CopyTextAsync(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
            value))
        {
            return Task.CompletedTask;
        }

        return Microsoft.Maui.ApplicationModel.DataTransfer
            .Clipboard
            .Default
            .SetTextAsync(
                value.Trim()
            );
    }

    private void ToggleAdvanced()
    {
        _advancedVisible = !_advancedVisible;
    }

    private void AddRuneFilter()
    {
        if (_runeToAdd is not long runeId)
        {
            return;
        }

        Rune? rune =
            AvailableRunes.FirstOrDefault(
                candidate =>
                    candidate.DofusDbId == runeId
            );

        if (rune is null ||
            Model.RuneFilters.Any(
                criterion =>
                    criterion.DofusDbId == runeId
            ))
        {
            _runeToAdd = null;
            return;
        }

        Model.RuneFilters.Add(
            new RuneFilterCriterion
            {
                DofusDbId = rune.DofusDbId,
                Characteristic = rune.Characteristic,
                RuneName = rune.Name
            }
        );

        _runeToAdd = null;
    }

    private void RemoveRuneFilter(
        RuneFilterCriterion criterion)
    {
        Model.RuneFilters.Remove(criterion);
    }

    private bool HasAdvancedFilters()
    {
        return Model.RuneFilters.Count > 0 ||
            Model.MinimumRoiPercent is not null ||
            Model.MinimumBenefit is not null ||
            Model.CompleteDataOnly ||
            Model.FreshDataOnly ||
            Model.RequireCoefficient ||
            Model.ProfitabilityMode !=
                ProfitabilityFilterMode.Best;
    }

    private void ClearMinimumRoi()
    {
        Model.MinimumRoiPercent = null;
    }

    private void ClearMinimumBenefit()
    {
        Model.MinimumBenefit = null;
    }

    private void ResetAdvanced()
    {
        Model.RuneFilters.Clear();
        Model.RuneMatchMode = RuneFilterMatchMode.Any;
        Model.ProfitabilityMode = ProfitabilityFilterMode.Best;
        Model.MinimumRoiPercent = null;
        Model.MinimumBenefit = null;
        Model.CompleteDataOnly = false;
        Model.FreshDataOnly = false;
        Model.RequireCoefficient = false;
    }

    void ResetEquipments()
    {
        Model.EquipmentType.Amulet = false;
        Model.EquipmentType.Ring = false;
        Model.EquipmentType.Belt = false;
        Model.EquipmentType.Boots = false;
        Model.EquipmentType.Hat = false;
        Model.EquipmentType.Cloak = false;
        Model.EquipmentType.Shield = false;
        Model.EquipmentType.Trophy = false;
    }

    void ResetWeapons()
    {
        Model.EquipmentType.Bow = false;
        Model.EquipmentType.Wand = false;
        Model.EquipmentType.Staff = false;
        Model.EquipmentType.Dagger = false;
        Model.EquipmentType.Sword = false;
        Model.EquipmentType.Scythe = false;
        Model.EquipmentType.Axe = false;
        Model.EquipmentType.Lance = false;
        Model.EquipmentType.Hammer = false;
        Model.EquipmentType.Shovel = false;
        Model.EquipmentType.Pickaxe = false;
        Model.EquipmentType.Tool = false;
    }

}