<button type="button" class="btn btn-outline-secondary btn-sm filter-chip" aria-label="@($"Retirer le filtre {Label}")" @onclick="Removed" disabled="@Disabled">
    @Label <i class="bi bi-x" aria-hidden="true"></i>
</button>
@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public EventCallback Removed { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
