@using BestCrush.Domain.Models

@if (Result is not null)
{
    <div class="border rounded px-3 py-2 mt-2">

        <div class="d-flex justify-content-between align-items-center gap-3">

            <span class="small text-secondary">
                @(StockPlan is null ? "Coût craft" : "Reste à payer (craft)")
            </span>

            @if (Result.IsComplete)
            {
                <strong>
                    @($"{Result.TotalCost!.Value:N0} k")
                </strong>
            }
            else
            {
                <div class="d-flex align-items-center gap-2">

                    @if (Result.KnownCost > 0)
                    {
                        <span>
                            @($"{Result.KnownCost:N0} k connus")
                        </span>
                    }

                    <span class="badge text-bg-warning">
                        ⚠ @Result.MissingResourceCount manquant(s)
                    </span>

                </div>
            }

        </div>
        @if (StockPlan is not null)
        {
            <div class="small text-secondary mt-1" title="Valeur indicative de revente des ingrédients utilisés. Les achats restants sont recalculés selon les lots disponibles.">
                Valeur des ingrédients possédés utilisés : @(StockPlan.OwnedValue is { } owned ? $"{owned:N0} k" : "prix inconnu")
            </div>
        }
        <CraftStockAvailability Result="Result" Equipment="Equipment" ServerName="@StockServerName" />

    </div>
}

@code
{
    [Parameter] public Equipment? Equipment { get; set; }
    [Parameter] public StockCraftPlan? StockPlan { get; set; }
    [Parameter] public string? StockServerName { get; set; }

    [Parameter]
    public CraftCostResult? Result { get; set; }

}
