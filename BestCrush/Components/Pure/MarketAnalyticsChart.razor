@using System.Globalization
@using BestCrush.Domain.Models
@using Microsoft.JSInterop
@using Microsoft.Extensions.DependencyInjection
@implements IAsyncDisposable
@inject IServiceProvider Services

<div class="analytics-chart @(Frameless ? "analytics-chart-frameless" : null)" @ref="_host">
    @if (ShowLegend)
    {
    <div class="d-flex flex-wrap gap-2 mb-2" aria-label="Courbes affichées">
        @foreach (var series in Series)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2" aria-pressed="@((!_hidden.Contains(series.Key)) ? "true" : "false")" @onclick="() => Toggle(series.Key)">
                <span class="analytics-swatch" style="background:@Color(series.Key)"></span>@series.Name
            </button>
        }
    </div>
    }
    @if (_geometry.Count == 0)
    { <div class="analytics-no-data" role="status">Aucun point comparable pour cet affichage.</div> }
    else
    {
        <svg viewBox="@($"0 0 {N(_width)} {N(_height)}")" role="img" aria-label="@(_scale == MarketAnalyticsTransformation.Base100 ? "Évolution comparée en base 100" : "Évolution comparée des prix en kamas")">
            <title>Comparaison des évolutions de prix</title>
            @for (int i = 0; i < 5; i++)
            {
                double y = 30+i*PlotHeight/4; double value = _max-i*(_max-_min)/4;
                <line x1="75" y1="@N(y)" x2="@N(_width-20)" y2="@N(y)" stroke="#c9c2af" stroke-width="1" />
                <foreignObject x="0" y="@N(y-10)" width="62" height="24"><div class="analytics-axis text-end">@Format(value)</div></foreignObject>
            }
            @for (int i = 0; i < TickCount; i++)
            {
                double x = 75+i*PlotWidth/(TickCount-1), labelX = i == 0 ? x : i == TickCount-1 ? x-120 : x-60;
                DateTime time = _from.AddTicks((long)((_to-_from).Ticks*i/(double)(TickCount-1)));
                <foreignObject x="@N(labelX)" y="@N(_height-52)" width="120" height="24"><div class="analytics-axis @(i == 0 ? "text-start" : i == TickCount-1 ? "text-end" : "text-center")">@time.ToLocalTime().ToString(_width < 500 ? "dd/MM" : "dd/MM HH:mm")</div></foreignObject>
            }
            <foreignObject x="75" y="@N(_height-23)" width="@N(PlotWidth)" height="23"><div class="analytics-axis">@(_scale == MarketAnalyticsTransformation.Base100 ? "Indice base 100" : "Prix (K)")</div></foreignObject>
            @foreach (var line in _geometry)
            {
                @if (line.Points.Count > 1)
                { <polyline class="analytics-connection" points="@line.Coordinates" fill="none" stroke="@line.Color" stroke-width="2.5" stroke-linejoin="round" /> }
                @foreach (var link in line.Links)
                {
                    <line class="analytics-link-hit" x1="@N(link.From.X)" y1="@N(link.From.Y)" x2="@N(link.To.X)" y2="@N(link.To.Y)" stroke="transparent" stroke-width="12" @onmouseenter="() => ShowLink(line.Name,link)" @onmouseleave="ClearHover" @onclick="() => ShowLink(line.Name,link)">
                        <title>@LinkDescription(link)</title>
                    </line>
                }
                @foreach (var point in line.Points)
                {
                    <circle class="analytics-observation" cx="@N(point.X)" cy="@N(point.Y)" r="3" fill="@line.Color" />
                    <circle cx="@N(point.X)" cy="@N(point.Y)" r="10" fill="transparent" class="analytics-hit" @onmouseenter="() => ShowPoint(line.Name,point.Sample)" @onmouseleave="ClearHover" @onclick="() => ShowPoint(line.Name,point.Sample)" />
                }
            }
        </svg>
        <div class="small mb-2">Points : créneaux avec relevés · Traits : liaisons visuelles entre ces points.</div>
        <div class="analytics-readout" aria-live="polite">
            @if (_hover is { } hover)
            {
                <strong>@hover.Name</strong><span>Créneau jusqu’au @Date(hover.Sample.AtUtc)</span>
                <span>@(_scale == MarketAnalyticsTransformation.Base100 ? $"Indice : {hover.Sample.Index:0.##}" : $"Prix : {hover.Sample.Price:N2} K")</span>
                @if (_scale == MarketAnalyticsTransformation.Base100) { <span>Prix : @hover.Sample.Price?.ToString("N2") K</span> }
                <span>@hover.Sample.ObservationCount @(hover.Sample.ObservationCount == 1 ? "nouveau relevé" : "nouveaux relevés") dans l’intervalle</span>
                @if (hover.Sample.IsCarried) { <span>Inclut aussi des prix précédemment relevés</span> }
            }
            else if (_hoverLink is { } hoveredLink)
            { <strong>@hoveredLink.Name</strong><span>@LinkDescription(hoveredLink.Link)</span> }
            else { <span>Survolez un point ou une liaison pour consulter son détail.</span> }
        </div>
    }
</div>

<style>
.analytics-chart { border:1px solid #d5cdb6;border-radius:.4rem;padding:1rem;background:#fff9e6;color:#212529; }
.analytics-chart-frameless { border:0;border-radius:0;padding:0;background:transparent; }
.analytics-chart svg { display:block;width:100%;height:auto; }
.analytics-chart .analytics-axis { font-size:13px;color:#495057;line-height:22px; }
.analytics-swatch { width:18px;height:3px;display:inline-block; }
.analytics-chart .analytics-hit { cursor:crosshair; }
.analytics-chart .analytics-link-hit { cursor:help;pointer-events:stroke; }
.analytics-readout { display:flex;flex-wrap:wrap;gap:.4rem 1rem;min-height:3rem;font-size:.85rem;padding-top:.6rem;border-top:1px solid #d5cdb6; }
.analytics-no-data { padding:2rem;text-align:center;color:#495057; }
</style>

@code {
    [Parameter] public IReadOnlyList<MarketAnalyticsPlotSeries> Series { get; set; } = [];
    [Parameter] public MarketAnalyticsTransformation Scale { get; set; }
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public bool Frameless { get; set; }
    [Parameter] public IReadOnlyDictionary<string,string>? SeriesColors { get; set; }
    private IReadOnlyList<MarketAnalyticsPlotSeries>? _previous;
    private IReadOnlyDictionary<string,string>? _previousColors;
    private MarketAnalyticsTransformation _scale;
    private readonly HashSet<string> _hidden = [];
    private readonly Dictionary<string,string> _colors = [];
    private static readonly string[] Palette = ["#78bae2","#ec939b","#91cba6","#e4c27a","#c2a9e8","#79cfcd","#e5a0cf","#c5d0cf"];
    private List<Line> _geometry = [];
    private double _min,_max;
    private DateTime _from,_to;
    private double _width = 1100, _height = 420;
    private double PlotWidth => _width-95;
    private double PlotHeight => _height-90;
    private int TickCount => _width < 500 ? 3 : 5;
    private ElementReference _host;
    private IJSObjectReference? _module, _observer;
    private DotNetObjectReference<MarketAnalyticsChart>? _self;
    private bool _disposed;
    private (string Name,MarketAnalyticsSample Sample)? _hover;
    private (string Name,Link Link)? _hoverLink;
    private sealed record Point(double X,double Y,MarketAnalyticsSample Sample);
    private sealed record Link(Point From,Point To,int SkippedIntervals,bool HasIntermediateReadings);
    private sealed record Line(string Name,string Color,string Coordinates,IReadOnlyList<Link> Links,IReadOnlyList<Point> Points);
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_previous,Series) && _scale == Scale && ReferenceEquals(_previousColors,SeriesColors)) return;
        _previous = Series; _scale = Scale; _previousColors = SeriesColors; ClearHover(); Rebuild();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Services.GetService<IJSRuntime>() is not { } js) return;
        _module = await js.InvokeAsync<IJSObjectReference>("import","./js/analytics-chart.js");
        if (_disposed) { await _module.DisposeAsync(); return; }
        _self = DotNetObjectReference.Create(this);
        _observer = await _module.InvokeAsync<IJSObjectReference>("observe",_host,_self);
    }
    [JSInvokable] public Task ResizeChart(double width) => InvokeAsync(() =>
    {
        if (_disposed || !double.IsFinite(width) || width <= 0) return;
        width = Math.Clamp(width,240,2400);
        if (Math.Abs(width-_width) < 1) return;
        _width = width; _height = width < 500 ? 320 : 400;
        ClearHover(); Rebuild(); StateHasChanged();
    });
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { if (_observer is not null) { await _observer.InvokeVoidAsync("dispose"); await _observer.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        finally
        {
            _self?.Dispose();
            if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
        }
    }
    private string Color(string key)
    {
        if (SeriesColors?.TryGetValue(key,out string? supplied) == true) return supplied;
        if (!_colors.TryGetValue(key,out var color)) _colors[key] = color = Palette[_colors.Count%Palette.Length];
        return color;
    }
    private double? Value(MarketAnalyticsSample sample) => _scale == MarketAnalyticsTransformation.Base100 ? sample.Index : sample.Price;
    private void Toggle(string key) { if (!_hidden.Add(key)) _hidden.Remove(key); ClearHover(); Rebuild(); }
    private void ClearHover() { _hover = null; _hoverLink = null; }
    private void ShowPoint(string name,MarketAnalyticsSample sample) { _hoverLink = null; _hover = (name,sample); }
    private void ShowLink(string name,Link link) { _hover = null; _hoverLink = (name,link); }
    private bool IsObserved(MarketAnalyticsSample sample) => sample.ObservationCount > 0 && Value(sample) is double value && double.IsFinite(value);
    private static string Date(DateTime at) => at.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    private static string LinkDescription(Link link)
    {
        string detail = link.SkippedIntervals == 0 ? ""
            : link.HasIntermediateReadings ? " Données insuffisantes pour afficher un point dans certains créneaux intermédiaires."
            : " Aucun relevé dans les créneaux intermédiaires.";
        return $"Liaison visuelle du {Date(link.From.Sample.AtUtc)} au {Date(link.To.Sample.AtUtc)}.{detail} Aucun prix intermédiaire calculé.";
    }
    private void Rebuild()
    {
        _geometry = [];
        var visible = Series.Where(s => !_hidden.Contains(s.Key)).ToArray();
        var values = visible.SelectMany(s => s.Samples).Where(IsObserved).Select(s => Value(s)!.Value).ToArray();
        if (values.Length == 0) return;
        _from = visible.SelectMany(s => s.Samples).Min(s => s.AtUtc); _to = visible.SelectMany(s => s.Samples).Max(s => s.AtUtc);
        if (_to <= _from) _to = _from.AddHours(1);
        double low = values.Min(), high = values.Max(), margin = Math.Max((high-low)*.05,Math.Abs(high)*.01);
        _min = Math.Max(0,low-margin); _max = high+Math.Max(margin,.01);
        foreach (var series in visible)
        {
            List<Point> points = []; List<Link> links = [];
            Point? previous = null;
            int skippedIntervals = 0;
            bool intermediateReadings = false;
            foreach (var sample in series.Samples)
            {
                if (!IsObserved(sample))
                {
                    if (previous is not null) { skippedIntervals++; intermediateReadings |= sample.ObservationCount > 0; }
                    continue;
                }
                double value = Value(sample)!.Value;
                double x = 75+(sample.AtUtc-_from).Ticks/(double)(_to-_from).Ticks*PlotWidth;
                double y = _height-60-(value-_min)/(_max-_min)*PlotHeight;
                var point = new Point(x,y,sample);
                points.Add(point);
                if (previous is not null) links.Add(new(previous,point,skippedIntervals,intermediateReadings));
                previous = point; skippedIntervals = 0; intermediateReadings = false;
            }
            if (points.Count > 0) _geometry.Add(new(series.Name,Color(series.Key),string.Join(" ",points.Select(p => $"{N(p.X)},{N(p.Y)}")),links,points));
        }
    }
    private string Format(double value) => _scale == MarketAnalyticsTransformation.Base100 ? value.ToString("0.#") : value >= 1000000 ? $"{value/1000000:0.#} M" : value >= 1000 ? $"{value/1000:0.#} k" : value.ToString("0.##");
    private static string N(double value) => value.ToString("0.##",CultureInfo.InvariantCulture);
}
