@using BestCrush.Domain.Models
@using BestCrush.Models
<span class="position-relative d-inline-flex">
    <ItemIcon Item="Item" Size="Size" Background="IconBackground.Slot" Tooltip="@Tooltip" TooltipIsHtml="@TooltipIsHtml"></ItemIcon>
    <span class="position-absolute text-bg-dark bg-opacity-25 fw-semibold px-1 @SizeClass" style="right: 2px; bottom: 2px; pointer-events: none;">
        @Count.ToString("0.##")
    </span>
</span>

@code {

    [Parameter]
    public required IItem Item { get; init; }

    [Parameter]
    public required double Count { get; init; }

    [Parameter]
    public bool TooltipIsHtml { get; init; }

    [Parameter]
    public string? Tooltip { get; init; }

    [Parameter]
    public Size Size { get; init; } = Size.Medium;

    string SizeClass =>
        Size switch
        {
            Size.Tiny => "smallest",
            Size.Small => "smaller",
            Size.Medium => "small",
            Size.Large or _ => ""
        };

}
