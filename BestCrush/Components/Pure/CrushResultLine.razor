@using BestCrush.Domain.Models
@using BestCrush.Models
@using BestCrush.Services
@using System.Globalization

@if (Equipment is not null)
{
    <div class="crush-detail">
        @if (!NoImage)
        {
            <div class="crush-detail-image">
                <StockItemArtwork ItemId="Equipment.DofusDbId" Stock="Stock"><ItemIcon Item="Equipment" Background="IconBackground.Slot" Size="Size.Medium" /></StockItemArtwork>
                @if (_focusedRune is not null)
                {
                    <StockItemArtwork ItemId="_focusedRune.DofusDbId" Stock="Stock"><ItemIcon Item="_focusedRune" Background="IconBackground.Slot" Size="Size.Tiny" Tooltip="Rune ciblée" /></StockItemArtwork>
                }
            </div>
        }
        <div class="crush-detail-main">
            <div class="crush-detail-top">
                <div class="crush-detail-identity"><strong role="button" class="text-decoration-underline" title="Cliquer pour copier le nom" @onclick="() => CopyTextAsync(Equipment.Name)">@Equipment.Name</strong>
                </div>
                @if (!NoImage)
                {
                    <div class="crush-recipe-icons">
                        @foreach (var input in RecipeInputs)
                        {
                            <StockItemArtwork ItemId="input.Item.DofusDbId" Stock="Stock">
                                <ItemIconWithCount Item="input.Item" Count="input.Count" Size="Size.Tiny" Tooltip="@ResourceTooltip(input.Item.DofusDbId, input.Item.Name)" TooltipIsHtml="true" />
                            </StockItemArtwork>
                        }
                    </div>
                }
                @if (Cost is not null)
                {
                    <div class="crush-detail-price"><span class="small text-secondary">Prix d’achat</span><span role="button" title="Prix d’achat" @onclick="() => CopyNumberAsync(Cost.Price)"><Kamas Amount="Cost.Price" Size="Size.Medium" /></span></div>
                }
            </div>
            <div class="crush-detail-runes">
                <div class="crush-rune-list">@if (Runes is { Count: > 0 }) { <strong>Runes</strong> }
                    @if (!NoImage && Runes is not null)
                    {
                        @foreach (var (rune, yield) in Runes)
                        {
                            var value = RuneValues?.GetValueOrDefault(rune);
                            <div class="crush-rune">
                                <StockItemArtwork ItemId="rune.DofusDbId" Stock="Stock"><ItemIconWithCount Item="rune" Count="yield" Size="Size.Small" /></StockItemArtwork>
                                @if (value is { } known) { <span role="button" title="Cliquer pour copier la valeur" @onclick="() => CopyNumberAsync(known.Value)"><Kamas Amount="known.Value" Size="Size.Tiny" /></span> }
                                else { <span class="small text-secondary" title="Prix de rune manquant">—</span> }
                                @if (value?.IsEstimated == true) { <span class="small text-secondary" title="Une partie de la valeur utilise des lots de vente estimés.">≈</span> }
                            </div>
                        }
                    }
                </div>
                @if (_estimatedPrice is { } price)
                {
                    <div class="crush-detail-price"><span class="small text-secondary">Valeur de revente</span><span role="button" title="Valeur de revente" @onclick="() => CopyNumberAsync(price)"><Kamas Amount="price" Size="Size.Medium" /></span></div>
                }
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] public BestCrush.Services.ItemCopyFeedback? CopyFeedback { get; set; }
    [Parameter] public Equipment? Equipment { get; set; }
    [Parameter] public CraftCostResult? CraftCost { get; set; }
    [Parameter] public MarketPriceObservation? Cost { get; set; }
    [Parameter] public Characteristic? FocusedCharacteristic { get; set; }
    [Parameter] public IReadOnlyDictionary<Rune, double>? Runes { get; set; }
    [Parameter] public IReadOnlyDictionary<Rune, MarketValueResult>? RuneValues { get; set; }
    [Parameter] public double? AdjustedRuneValue { get; set; }
    [Parameter] public bool NoImage { get; set; }
    [Parameter] public LiveStockSource? Stock { get; set; }
    private double? _estimatedPrice;
    private Rune? _focusedRune;
    private IEnumerable<(IItem Item, int Count)> RecipeInputs => Equipment is null ? [] : Equipment.Recipe.Select(x => ((IItem)x.Resource, x.Count))
        .Concat(Equipment.EquipmentRecipe.Select(x => ((IItem)x.IngredientEquipment, x.Count)));
    protected override void OnParametersSet()
    {
        _estimatedPrice = AdjustedRuneValue ?? RuneValues?.Values.Sum(x => x.Value);
        _focusedRune = Runes?.Keys.FirstOrDefault(r => r.Characteristic == FocusedCharacteristic);
    }
    private Task CopyTextAsync(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return Task.CompletedTask;
        return CopyFeedback is not null ? CopyFeedback.CopyAsync(value)
            : Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(value.Trim());
    }

    private Task CopyNumberAsync(double value) => CopyTextAsync(Math.Round(value).ToString("0", CultureInfo.InvariantCulture));

    private string ResourceTooltip(long id, string itemName)
    {
        CraftResourceCostLine? resourceCost =
            CraftCost?
                .Resources
                .FirstOrDefault(resource =>
                    resource.DofusDbId ==
                    id);

        string name =
            System.Net.WebUtility.HtmlEncode(
                itemName
            );

        if (resourceCost?.Purchase is null)
        {
            return
                $"{name}<br>" +
                "Prix indisponible";
        }

        return
            $"{name}<br>" +
            $"{resourceCost.Purchase.TotalCost:N0} " +
            "<img src=\"img/kama-10.png\" " +
            "width=\"10\" height=\"10\" " +
            "alt=\"Kamas\">";
    }
}
