@using BestCrush.Domain.Services
@using DofusSharp.Dofocus.ApiClients.Models.Servers
@using Microsoft.AspNetCore.Components.Routing
@inherits LayoutComponentBase
@implements IDisposable
@inject ServersService ServersService
@inject NavigationManager NavigationManager
@inject BestCrush.Services.CurrentServerState CurrentServerState
@inject BestCrush.Services.CurrentCharacterState CurrentCharacterState

<div class="min-vh-100 container-fluid px-3 px-xl-4 d-flex flex-column" data-bs-theme="@_theme">
    <header class="d-flex align-items-center justify-content-between gap-3 py-2">
        <div class="d-flex align-items-center gap-2">
            <img src="img/logo-48.png" width="40" height="40" alt="Logo BestCrush"/>
            <span class="fw-semibold">BestCrush</span>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2">
            @if (_servers is null)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Chargement du serveur...</span>
                </div>
            }
            else
            {
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle"
                            type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Serveur : @(_currentServer?.Name ?? "Choisir un serveur")
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @foreach (DofocusServer server in _servers)
                        {
                            <li>
                                <a class="dropdown-item @(server.Name == _currentServer?.Name ? "active" : null)"
                                   href="#" @onclick:preventDefault="true"
                                   @onclick="() => SelectServer(server)">
                                    @server.Name
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <a class="btn btn-outline-secondary"
               href="@KnownRoutes.Profile()"
               title="Profil du personnage actif"
               aria-label="Personnage">
                👤 @(!string.IsNullOrWhiteSpace(CurrentCharacterState.CharacterName)
                    ? CurrentCharacterState.CharacterName
                    : "Personnage")
            </a>

            @if (_currentServer is not null)
            {
                <a class="btn btn-outline-secondary"
                   href="@KnownRoutes.Settings(_currentServer.Name)"
                   title="Paramètres"
                   aria-label="Paramètres">
                    ⚙
                </a>
            }
        </div>
    </header>

    <nav class="workspace-tabs mb-3" aria-label="Modules BestCrush">
        @foreach (WorkspaceModule module in WorkspaceModules.All)
        {
            <a class="@TabClass(module)"
               href="@WorkspaceModules.Href(module, _currentServer?.Name)"
               aria-current="@(ActiveTab == module.Slug ? "page" : null)">
                @module.Name
            </a>
        }
    </nav>

    <NpcapRequirementBanner />

    <div class="flex-grow-1">
        @if (_servers is null)
        {
            <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden">Chargement de l'espace de travail...</span>
            </div>
        }
        else if (IsRouteCompatible)
        {
            @Body
        }
    </div>

    <Footer></Footer>
</div>

@code {
    private readonly string _theme =
        Application.Current?.RequestedTheme is AppTheme.Dark ? "dark" : "light";

    private IReadOnlyCollection<DofocusServer>? _servers;
    private DofocusServer? _currentServer;

    private string? ActiveTab =>
        WorkspaceModules.ActiveSlug(
            NavigationManager.ToBaseRelativePath(NavigationManager.Uri));

    private string TabClass(WorkspaceModule module) =>
        ActiveTab == module.Slug
            ? "workspace-tab active"
            : "workspace-tab";

    // Never instantiate legacy pages scoped to another selected server.
    private bool IsRouteCompatible =>
        WorkspaceModules.IsRouteCompatible(
            NavigationManager.ToBaseRelativePath(NavigationManager.Uri),
            _currentServer?.Name);

    private void GuardLegacyRoute()
    {
        if (IsRouteCompatible)
            return;

        NavigationManager.NavigateTo(
            _currentServer is null
                ? KnownRoutes.Module("concassage")
                : KnownRoutes.Server(_currentServer),
            replace: true);
    }

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;

        Task<IReadOnlyCollection<DofocusServer>> serversTask =
            ServersService.GetServers();
        Task<DofocusServer?> currentServerTask =
            ServersService.GetCurrentServer();

        await Task.WhenAll(serversTask, currentServerTask);

        _servers = serversTask.Result;
        _currentServer = currentServerTask.Result;

        if (_currentServer is null)
            CurrentServerState.Clear();
        else
            CurrentServerState.SelectServer(_currentServer.Name);

        CurrentCharacterState.SelectServer(_currentServer?.Name);
        CurrentCharacterState.Changed += OnCharacterChanged;
        GuardLegacyRoute();
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            GuardLegacyRoute();
            StateHasChanged();
        });
    }

    private void OnCharacterChanged() =>
        _ = InvokeAsync(StateHasChanged);

    private async Task SelectServer(DofocusServer server)
    {
        // Reject queued captures during the change; never activate a new
        // context until the preference and selection are both committed.
        bool changed = !string.Equals(
            CurrentServerState.ServerName, server.Name, StringComparison.Ordinal);
        if (changed)
            CurrentServerState.Clear();

        await ServersService.SetCurrentServerAsync(server);
        CurrentServerState.SelectServer(server.Name);
        _currentServer = server;
        CurrentCharacterState.SelectServer(server.Name);

        // Legacy routes are server-scoped; other module URLs are independent.
        if (ActiveTab == "concassage")
            NavigationManager.NavigateTo(KnownRoutes.Server(server), true);
        else
            StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        CurrentCharacterState.Changed -= OnCharacterChanged;
    }
}
