@using BestCrush.Domain
@using BestCrush.Domain.Services
@using Microsoft.EntityFrameworkCore
@using DofusSharp.Dofocus.ApiClients.Models.Servers
@using Microsoft.AspNetCore.Components.Routing
@inherits LayoutComponentBase
@implements IAsyncDisposable
@using BestCrush.Services
@inject ServersService ServersService
@inject IDbContextFactory<BestCrushDbContext> DbContextFactory
@inject IWorkspacePreferences WorkspacePreferences
@inject NavigationManager NavigationManager
@inject BestCrush.Services.CurrentServerState CurrentServerState
@inject BestCrush.Services.ServerViewFilterState ViewFilter
@inject BestCrush.Services.CurrentCharacterState CurrentCharacterState
@inject BestCrush.Services.CurrentDofusClientsState CurrentDofusClientsState
@inject BestCrush.Services.CurrentCandidateWindowCardsState CurrentCandidateWindowCardsState
@inject BestCrush.Services.WindowServerAttributionState WindowServerAttributionState
@inject BestCrush.Services.CurrentWindowProfessionsState CurrentWindowProfessionsState
@inject BestCrush.Services.LiveDofusClientNetworkBindings LiveClientNetworkBindings
@inject BestCrush.Services.WindowScopedNetworkEquipmentState WindowEquipmentState
@inject BestCrush.Services.DofusWindowService DofusWindowService
@inject DofusNetworkCaptureService NetworkCapture

@inject IDataPriorityProvider DataPriorityProvider
@inject IJSRuntime JS

<CascadingValue Value="_workspace" IsFixed="true">
<div class="bestcrush-workspace min-vh-100 container-fluid px-3 px-xl-4 d-flex flex-column" data-bs-theme="@_theme">
    <a class="workspace-skip-link" href="#workspace-main">Aller au contenu</a>
    <header class="d-flex align-items-center justify-content-between gap-3 py-2">
        <div class="d-flex align-items-center gap-2">
            <img src="img/logo-48.png" width="40" height="40" alt="Logo BestCrush"/>
            <span class="fw-semibold">BestCrush</span>
        </div>

        <div class="workspace-header-actions d-flex align-items-start justify-content-end gap-2">
            <button type="button" class="btn workspace-data-button"
                    aria-label="@(_workspace.DataOpen ? "Revenir aux activités" : "Ouvrir les données du marché")"
                    aria-controls="@(_workspace.DataOpen ? "workspace-activity" : "workspace-data")"
                    title="@(_workspace.DataOpen ? "Revenir aux activités" : "Prix, coefficients et historique")"
                    @onclick="ToggleWorkspaceAsync">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" aria-hidden="true">
                    @if (_workspace.DataOpen)
                    {
                        <rect x="3" y="3" width="7" height="7" rx="1" />
                        <rect x="14" y="3" width="7" height="7" rx="1" />
                        <rect x="3" y="14" width="7" height="7" rx="1" />
                        <rect x="14" y="14" width="7" height="7" rx="1" />
                    }
                    else
                    {
                        <ellipse cx="12" cy="5" rx="8" ry="3" />
                        <path d="M4 5v7c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12v7c0 1.7 3.6 3 8 3s8-1.3 8-3v-7" />
                    }
                </svg>
                @(_workspace.DataOpen ? "Activités" : "Données")
            </button>
            @if (OperatingSystem.IsWindows())
            {
                <NetworkCaptureIndicator Status="_networkCaptureStatus" />
            }
            <div class="dropdown">
                <button type="button"
                        class="btn btn-outline-secondary dropdown-toggle"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        title="Filtrer les prix, les coefficients et les historiques enregistrés par serveur. Cette sélection ne modifie pas les captures réseau.">
                    @if (ViewFilter.IsBrowsingManually)
                    {
                        <span>Consulter : @(_currentServer?.Name ?? "Serveur inconnu")</span>
                    }
                    else
                    {
                        <span>Serveur : @(_currentServer?.Name ?? "Identification en cours")</span>
                    }
                </button>
                <ul class="dropdown-menu dropdown-menu-end"
                    style="max-height: 55vh; overflow-y: auto;">
                    <li><h6 class="dropdown-header">Consulter les données d'un serveur</h6></li>
                    @if (_servers is not null)
                    {
                        @foreach (DofocusServer server in _servers)
                        {
                            <li>
                                <button type="button"
                                        class="dropdown-item @(ViewFilter.IsBrowsingManually && string.Equals(ViewFilter.ServerName, server.Name, StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                                        @onclick="() => BrowseServer(server)">
                                    @server.Name
                                </button>
                            </li>
                        }
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <button type="button"
                                class="dropdown-item"
                                disabled="@(CurrentDofusClientsState.SelectedClient is null)"
                                @onclick="FollowSelectedWindow">
                            Revenir au serveur du personnage ciblé
                        </button>
                    </li>
                </ul>
            </div>

            <div class="d-flex align-items-start gap-1"
                 role="group" aria-label="Fenêtres Dofus détectées cette session">
                @if (CurrentDofusClientsState.Clients.Count > 0)
                {
                    @foreach (DofusClientWindow client in CurrentDofusClientsState.Clients)
                    {
                        <div class="character-context" @key="client.Key">
                        <button type="button"
                                class="character-avatar @(CurrentDofusClientsState.SelectedClient?.Key == client.Key ? "active" : "") @(LiveClientNetworkBindings.IsLinked(client.Key) ? "network-linked" : "") @(client.HasCharacterTitle && CurrentCandidateWindowCardsState.HasCandidateLink(client.Key) ? "candidate-roster-linked" : "")"
                                title="@($"{client.DisplayName}{(client.ClassName is null ? "" : $" — {client.ClassName}")} — fenêtre Dofus (flux TCP {(LiveClientNetworkBindings.IsLinked(client.Key) ? "relié" : "non relié")}, groupe candidat {(client.HasCharacterTitle && CurrentCandidateWindowCardsState.HasCandidateLink(client.Key) ? "lié" : "non lié")}, compte non vérifié)")"
                                aria-label="@($"Cibler la fenêtre de {client.DisplayName}")"
                                aria-pressed="@(CurrentDofusClientsState.SelectedClient?.Key == client.Key)"
                                @onclick="() => SelectDofusClient(client.Key)">
                            <span class="character-avatar-face" aria-hidden="true">👤</span>
                            @if (DofusLocalArtwork.ClassPortrait(client.ClassName) is { } portrait &&
                                 !_missingAvatarArtwork.Contains(portrait))
                            {
                                <img class="character-avatar-local" src="@portrait" alt=""
                                     width="36" height="36"
                                     @onerror="() => MarkAvatarArtworkMissing(portrait)" />
                            }
                            <span class="character-avatar-initial" aria-hidden="true">
                                @(client.HasCharacterTitle ? client.DisplayName[..1].ToUpperInvariant() : "?")
                            </span>
                        </button>
                        <StockStatus Window="client.Key" />
                        </div>
                    }
                }
                else
                {
                    @foreach (CharacterSessionProfile character in CurrentCharacterState.Characters)
                    {
                        <div class="character-context" @key="character.Key">
                        <button type="button"
                                class="character-avatar @(CurrentCharacterState.ActiveCharacterKey == character.Key ? "active" : "")"
                                title="@($"{character.Name} — {character.Key.ServerName}")"
                                aria-label="@($"Cibler {character.Name}")"
                                aria-pressed="@(CurrentCharacterState.ActiveCharacterKey == character.Key)"
                                disabled="@(!CurrentCharacterState.IsCharacterConnected(character.Key))"
                                @onclick="() => SelectCharacter(character.Key)">
                            <span class="character-avatar-face" aria-hidden="true">👤</span>
                            @if (DofusLocalArtwork.ClassPortrait(DofusClassDisplayNames.ForId(character.ClassId)) is { } portrait &&
                                 !_missingAvatarArtwork.Contains(portrait))
                            {
                                <img class="character-avatar-local" src="@portrait" alt=""
                                     width="36" height="36"
                                     @onerror="() => MarkAvatarArtworkMissing(portrait)" />
                            }
                            <span class="character-avatar-initial" aria-hidden="true">
                                @(string.IsNullOrWhiteSpace(character.Name) ? "?" : character.Name[..1].ToUpperInvariant())
                            </span>
                        </button>
                        @if (CurrentCharacterState.WindowForCharacter(character.Key) is { } window)
                        {
                            <StockStatus Window="window" />
                        }
                        </div>
                    }
                }
            </div>

            <a class="btn btn-outline-secondary"
               href="@KnownRoutes.Profile()"
               title="Afficher les fiches vérifiées et les fenêtres candidates expérimentales séparément"
               aria-label="Ouvrir les fiches des personnages">
                @(CurrentDofusClientsState.SelectedClient?.DisplayName ?? CurrentCharacterState.ActiveProfile?.Name ?? "Personnages")
            </a>

            <button type="button" class="btn btn-outline-secondary"
                    title="Paramètres" aria-label="Paramètres" @onclick="_workspace.OpenSettings">⚙</button>
        </div>
    </header>

    <div class="workspace-frame flex-grow-1">
        <WorkspaceSidebar ServerName="@_currentServer?.Name" ActiveModule="@ActiveTab"
                          DataOpen="@_workspace.DataOpen" DataTab="@_workspace.DataTab"
                          OnDataTabSelected="SelectDataTabAsync" />
        <main class="workspace-main" id="workspace-main">
    <NpcapRequirementBanner />

    <div class="flex-grow-1" hidden="@_workspace.DataOpen">
        @if (_servers is null)
        {
            <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden">Chargement de l'espace de travail...</span>
            </div>
        }
        else if (IsRouteCompatible)
        {
            <div id="workspace-activity">
                <PreservedActivity ChildContent="@Body" Route="@NavigationManager.Uri" />
            </div>
        }
    </div>

    <div id="workspace-data" class="flex-grow-1" hidden="@(!_workspace.DataOpen)">
        @if (_dataVisited)
        {
            <DataWorkspace ServerName="@_currentServer?.Name" Tab="@_workspace.DataTab" IsActive="@_workspace.DataOpen" Priority="@DataPriorityProvider.Priority"
                           HistorySelection="@_workspace.HistorySelection" />
        }
    </div>

    <WorkspaceSettingsDialog Visible="@_workspace.SettingsOpen" OnClose="_workspace.CloseSettings"
                             OnYieldChanged="_workspace.NotifyCrushSettingsChanged" />
        </main>
    </div>
    <Footer></Footer>
</div>
</CascadingValue>

@code {
    private readonly WorkspaceNavigation _workspace = new();
    private bool _dataVisited;
    private string? _pendingViewport;
    private IJSObjectReference? _workspaceJs;
    private async Task<IJSObjectReference> WorkspaceJsAsync() =>
        _workspaceJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/workspace.js");

    private Task ToggleWorkspaceAsync() => _workspace.DataOpen ? CloseDataAsync() : OpenDataAsync();

    private async Task OpenDataAsync()
    {
        if (_workspace.DataOpen) return;
        await (await WorkspaceJsAsync()).InvokeVoidAsync("capture", "activity");
        _dataVisited = true;
        _pendingViewport = "data";
        _workspace.OpenData();
    }
    private async Task CloseDataAsync()
    {
        await (await WorkspaceJsAsync()).InvokeVoidAsync("capture", "data");
        _pendingViewport = "activity";
        _workspace.CloseData();
    }
    private async Task SelectDataTabAsync(WorkspaceDataTab tab)
    {
        if (_workspace.DataTab == tab) return;
        _workspace.SelectDataTab(tab);
        await (await WorkspaceJsAsync()).InvokeVoidAsync("scrollToTop");
    }
    private void OnWorkspaceChanged() => _ = InvokeAsync(() =>
    {
        if (_workspace.DataOpen) _dataVisited = true;
        StateHasChanged();
    });
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingViewport is not { } viewport) return;
        _pendingViewport = null;
        await (await WorkspaceJsAsync()).InvokeVoidAsync("restore", viewport);
    }
    private readonly HashSet<string> _missingAvatarArtwork = new(StringComparer.Ordinal);
    private void MarkAvatarArtworkMissing(string path) => _missingAvatarArtwork.Add(path);

    private readonly string _theme =
        Application.Current?.RequestedTheme is AppTheme.Dark ? "dark" : "light";

    private IReadOnlyCollection<DofocusServer>? _servers;
    private DofocusServer? _currentServer;

    private CancellationTokenSource? _clientPollingCancellation;
    private Task? _clientPollingTask;
    private NetworkCaptureStatus _networkCaptureStatus;

    private string? ActiveTab =>
        WorkspaceModules.ActiveSlug(
            NavigationManager.ToBaseRelativePath(NavigationManager.Uri));

    // Never instantiate legacy pages scoped to another selected server.
    private bool IsRouteCompatible =>
        WorkspaceModules.IsRouteCompatible(
            NavigationManager.ToBaseRelativePath(NavigationManager.Uri),
            _currentServer?.Name);

    private void GuardLegacyRoute()
    {
        if (IsRouteCompatible)
            return;

        string relativePath =
            NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.NavigateTo(
            WorkspaceModules.ReplaceServerInRoute(
                relativePath, _currentServer?.Name) ??
                (_currentServer is null
                    ? KnownRoutes.Module("concassage")
                    : KnownRoutes.Server(_currentServer)),
            replace: true);
    }

    protected override async Task OnInitializedAsync()
    {
        _networkCaptureStatus = NetworkCapture.Status;
        _workspace.Changed += OnWorkspaceChanged;
        NavigationManager.LocationChanged += OnLocationChanged;

        IReadOnlyCollection<DofocusServer> catalog =
            await ServersService.GetServers();

        // Make archived/local market servers browseable even if DoFocus
        // no longer lists them. Read distinct server names only: this
        // filter does not query, amend or persist character identities.
        await using (BestCrushDbContext database =
            await DbContextFactory.CreateDbContextAsync())
        {
            string[] recordedPrices = await database.MarketPriceObservations
                .AsNoTracking()
                .Select(row => row.ServerName).Distinct().ToArrayAsync();
            string[] recordedCoefficients = await database.CoefficientObservations
                .AsNoTracking()
                .Select(row => row.ServerName).Distinct().ToArrayAsync();
            string[] recordedCrushes = await database.CrushHistorySessions
                .AsNoTracking()
                .Select(row => row.ServerName).Distinct().ToArrayAsync();

            _servers = catalog.Concat(recordedPrices
                    .Concat(recordedCoefficients)
                    .Concat(recordedCrushes)
                    .Where(name => !string.IsNullOrWhiteSpace(name))
                    .Select(name => new DofocusServer { Name = name }))
                .GroupBy(server => server.Name, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderBy(server => server.Name,
                    StringComparer.CurrentCultureIgnoreCase)
                .ToArray();
        }
        // Legacy global choice is no longer used or restored.
        WorkspacePreferences.Remove(ServersService.LastServerPreferenceKey);
        _currentServer = null;

        // One-time compatibility cleanup: M2 briefly used preferences to
        // remember character names. No character data may survive app exit.
        foreach (DofocusServer knownServer in _servers)
            WorkspacePreferences.Remove($"Workspace.CharacterName.{knownServer.Name}");

        CurrentServerState.Clear();
        CurrentCharacterState.SelectServer(null);
        CurrentCharacterState.Changed += OnCharacterChanged;
        CurrentCharacterState.TargetRequested += OnVerifiedCharacterTargetRequested;
        CurrentDofusClientsState.Changed += OnDofusClientChanged;
        CurrentDofusClientsState.TargetRequested += OnWindowTargetRequested;
        CurrentDofusClientsState.GameActivated += OnGameWindowActivated;
        CurrentCandidateWindowCardsState.Changed += OnDofusClientChanged;
        WindowServerAttributionState.Changed += OnDofusClientChanged;
        LiveClientNetworkBindings.Changed += OnDofusClientChanged;
        SyncSelectedWindowServer();
        GuardLegacyRoute();

        if (OperatingSystem.IsWindows())
        {
            _clientPollingCancellation = new CancellationTokenSource();
            _clientPollingTask = PollDofusClientsAsync(_clientPollingCancellation.Token);
        }
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            string path = NavigationManager.ToBaseRelativePath(args.Location);
            if (WorkspaceModules.ServerFromRoute(path) is null && _workspace.DataOpen)
                _workspace.CloseData();
            GuardLegacyRoute();
            StateHasChanged();
        });
    }

    private void SelectCharacter(BestCrush.Services.CharacterKey key)
    {
        CurrentCharacterState.SelectCharacter(key);
    }

    private void OnCharacterChanged() =>
        _ = InvokeAsync(StateHasChanged);

    private void SelectDofusClient(DofusClientWindowKey key) =>
        CurrentDofusClientsState.SelectWindow(key);

    private void BrowseServer(DofocusServer server)
    {
        // A browsing filter is NOT a Dofus server selection. It never
        // changes network owners, capture leases or character profiles.
        // Arm a foreground transition even if the 1-second Win32 polling
        // loop missed the brief visit to BestCrush before returning to Dofus.
        CurrentDofusClientsState.ExpectGameActivationAfterBrowsing();
        ViewFilter.BrowseServer(server.Name);
        ApplyDisplayedServer(updateCharacterContext: false);

        if (ActiveTab == "concassage" &&
            WorkspaceModules.ServerFromRoute(
                NavigationManager.ToBaseRelativePath(NavigationManager.Uri)) is null)
            NavigationManager.NavigateTo(KnownRoutes.Server(server.Name));
        else
            GuardLegacyRoute();
    }

    private void FollowSelectedWindow()
    {
        if (CurrentDofusClientsState.SelectedClient is { } client)
            FollowWindow(client.Key);
    }

    private void OnWindowTargetRequested(DofusClientWindowKey key) =>
        _ = InvokeAsync(() => FollowWindow(key));

    private void OnGameWindowActivated(DofusClientWindowKey key) =>
        _ = InvokeAsync(() => FollowWindow(key));

    private void OnVerifiedCharacterTargetRequested(CharacterKey key) =>
        _ = InvokeAsync(() =>
        {
            // Prefer an independently verified Windows binding to a name.
            // It also targets the same client in the avatar strip.
            DofusClientWindowKey? window =
                CurrentCharacterState.WindowForCharacter(key);
            if (window is { } verified &&
                CurrentDofusClientsState.SelectWindow(verified))
            {
                ViewFilter.FollowWindow(verified,
                    ServerForTargetWindow(verified) ?? key.ServerName);
            }
            else
            {
                // A verified CharacterKey includes its server identity;
                // no association is inferred from a display name.
                ViewFilter.FollowWindow(null, key.ServerName);
            }

            ApplyDisplayedServer(updateCharacterContext: false);
            GuardLegacyRoute();
            StateHasChanged();
        });

    private void FollowWindow(DofusClientWindowKey key)
    {
        if (!CurrentDofusClientsState.Clients.Any(client => client.Key == key))
            return;

        ViewFilter.FollowWindow(key, ServerForTargetWindow(key));
        ApplyDisplayedServer(updateCharacterContext: true);
        GuardLegacyRoute();
        StateHasChanged();
    }

    private void OnDofusClientChanged() =>
        _ = InvokeAsync(() =>
        {
            SyncSelectedWindowServer();
            GuardLegacyRoute();
            StateHasChanged();
        });

    /// <summary>
    /// The protocol-owned window server always wins. An independently
    /// verified character key may supply its own server only for UI
    /// targeting, never for accepting network market writes.
    /// </summary>
    private string? ServerForTargetWindow(DofusClientWindowKey window)
    {
        string? detected =
            WindowServerAttributionState.ForWindow(window)?.ServerName;
        if (detected is not null)
            return detected;

        CharacterSessionProfile? verified = CurrentCharacterState.ActiveProfile;
        return verified is not null &&
            CurrentCharacterState.WindowForCharacter(verified.Key) == window
                ? verified.Key.ServerName
                : null;
    }

    private void SyncSelectedWindowServer()
    {
        DofusClientWindow? selected = CurrentDofusClientsState.SelectedClient;
        string? serverName = selected is { } client
            ? ServerForTargetWindow(client.Key)
            : null;

        // New network observations must not steal a deliberately selected
        // SQL browsing server. An explicit click or game activation does.
        if (ViewFilter.ReconcileTarget(selected?.Key, serverName))
            ApplyDisplayedServer(updateCharacterContext: true);
    }

    private void ApplyDisplayedServer(bool updateCharacterContext)
    {
        string? name = ViewFilter.ServerName;
        if (!string.Equals(_currentServer?.Name, name,
                StringComparison.OrdinalIgnoreCase))
        {
            _currentServer = name is null
                ? null
                : _servers?.FirstOrDefault(server =>
                    string.Equals(server.Name, name,
                        StringComparison.OrdinalIgnoreCase))
                  ?? new DofocusServer { Name = name };

            // In automatic routing mode, CurrentServerState is strictly a
            // UI/calculation context: its name never authorizes a network
            // write. All SQLite capture writes use per-Game server leases.
            if (_currentServer is null)
                CurrentServerState.Clear();
            else
                CurrentServerState.SelectServer(_currentServer.Name);
        }

        // A temporary SQL inspection must NEVER clear the active
        // character or hide character cards from the session.
        if (updateCharacterContext)
            CurrentCharacterState.SelectServer(name);
    }

    private async Task PollDofusClientsAsync(CancellationToken cancellationToken)
    {
        using PeriodicTimer timer = new(TimeSpan.FromSeconds(1));
        try
        {
            do
            {
                await InvokeAsync(() =>
                {
                    var captureStatus = NetworkCapture.Status;
                    if (_networkCaptureStatus != captureStatus)
                    {
                        _networkCaptureStatus = captureStatus;
                        StateHasChanged();
                    }

                    IReadOnlyList<DofusWindowInfo> windows =
                        DofusWindowService.ListVisibleDofusWindows();
                    DofusWindowInfo? foreground =
                        DofusWindowService.GetForegroundDofusWindow();

                    CurrentDofusClientsState.Update(
                        windows,
                        foreground is null ? null :
                            new DofusClientWindowKey(
                                foreground.Handle.ToInt64(), foreground.ProcessId));

                    // A closed window must lose its network marker even if
                    // its TCP connection produces no more captured packets.
                    DofusClientWindowKey[] liveClientKeys =
                        CurrentDofusClientsState.Clients
                            .Select(client => client.Key).ToArray();
                    LiveClientNetworkBindings.RemoveMissingWindows(liveClientKeys);
                    // Independent one-second Win32 inventory: a candidate
                    // character card disappears even with NO TCP traffic.
                    CurrentCandidateWindowCardsState.RemoveMissingWindows(liveClientKeys);
                    WindowServerAttributionState.RemoveMissingWindows(liveClientKeys);
                    CurrentWindowProfessionsState.RemoveMissingWindows(liveClientKeys);
                    WindowServerAttributionState.ReconcileCharacterTitles(
                        CurrentDofusClientsState.Clients);
                    // Remove ephemeral per-window equipment even when the
                    // closed Dofus client generates no further TCP traffic.
                    WindowEquipmentState.RemoveMissingWindows(liveClientKeys);
                    // Identity-verified character cards are ephemeral too:
                    // only their previously proven OS window can revoke them.
                    CurrentCharacterState.RemoveMissingWindows(liveClientKeys);
                });
            }
            while (await timer.WaitForNextTickAsync(cancellationToken));
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Layout disposed; stop polling without retaining client metadata.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _workspace.Changed -= OnWorkspaceChanged;
        if (_workspaceJs is not null)
        {
            try { await _workspaceJs.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        NavigationManager.LocationChanged -= OnLocationChanged;
        CurrentCharacterState.Changed -= OnCharacterChanged;
        CurrentCharacterState.TargetRequested -= OnVerifiedCharacterTargetRequested;
        CurrentDofusClientsState.Changed -= OnDofusClientChanged;
        CurrentDofusClientsState.TargetRequested -= OnWindowTargetRequested;
        CurrentDofusClientsState.GameActivated -= OnGameWindowActivated;
        CurrentCandidateWindowCardsState.Changed -= OnDofusClientChanged;
        WindowServerAttributionState.Changed -= OnDofusClientChanged;
        LiveClientNetworkBindings.Changed -= OnDofusClientChanged;

        if (_clientPollingCancellation is { } cancellation)
        {
            await cancellation.CancelAsync();
            if (_clientPollingTask is { } task)
                await task;
            cancellation.Dispose();
        }
    }
}
