@using BestCrush.Services
@using BestCrush.Components.Pure

<section class="pet-market-overlay" aria-label="Achats et nourriture des familiers">
    <PetFoodSelector PriceTooltip="@(Report?.BestFoodValue is {} foodValue ? Report.FoodPriceTooltip(foodValue.Food.Id) : null)" Value="Report?.BestFoodValue" Loading="@(Report is null || !Report.AnalysisComplete)" ContextKey="@Report?.Server"
        UseStocks="UseStocks" SkippedCount="SkippedFoods" UseStocksChanged="UseStocksChanged" NextRequested="NextFoodRequested"
        PreviousRequested="PreviousFoodRequested" ResetRequested="ResetFoodsRequested" />
    <nav class="pet-copy-tools" aria-label="Listes à actualiser">
        <button disabled="@(Report?.PetPriceChecks.Count is not >0)" aria-label="Copier les prix des familiers à actualiser"
            title="@($"Prix familier ({Report?.PetPriceChecks.Count??0})")" @onclick="CopyPetPrices">
            <i class="bi bi-heart" aria-hidden="true"></i><span>@(Report?.PetPriceChecks.Count??0)</span>
        </button>
        <button disabled="@(Report?.FoodPriceChecks.Count is not >0)" aria-label="Copier les prix des ressources à actualiser"
            title="@($"Prix ressources ({Report?.FoodPriceChecks.Count??0})")" @onclick="CopyResourcePrices">
            <i class="bi bi-basket" aria-hidden="true"></i><span>@(Report?.FoodPriceChecks.Count??0)</span>
        </button>
    </nav>
    @if(!ServerKnown)
    {<p class="empty"><i class="bi bi-globe warning" title="Choisissez le serveur joué avec son bouton radio dans BestCrush."></i> Serveur joué à sélectionner</p>}
    else if((Report is null || !Report.AnalysisComplete) && Error is null)
    {<p class="empty" role="status"><i class="bi bi-hourglass-split" aria-hidden="true"></i> Analyse en cours…</p>}
    @if(Error is not null){<p class="warning" role="status"><i class="bi bi-exclamation-triangle"></i> @Error</p>}
    @if(Report is { } report)
    {
        var rows=report.OverlayPurchases.Count>0?report.OverlayPurchases:report.Purchases;
        @foreach(var group in rows.Where(p=>p.Purchase is not null && p.Best is not null).GroupBy(p=>p.Purchase!.Level))
        {
            <h3 class="pet-buy-level">Plus rentables · niv. @group.Key</h3>
            @foreach(var pet in group.Take(3))
            {
                var plan=pet.Best!;
                <article class="pet-buy-card">
                    <div class="pet-buy-heading"><TradeItemImage Name="@pet.Species.Name" ItemId="pet.Species.Id" IconId="pet.Species.IconId" Size="34" /><strong>@pet.Species.Name</strong><span class="positive">+@Money(plan.Margin)</span></div>
                    <div class="pet-buy-route"><small>Niv. @group.Key → @plan.Level</small><small>Achat @Money(pet.AcquisitionCost) · Revente @Money(plan.SalePrice)</small></div>
                    <div class="pet-feed-cost">
                        <small>Nourrissage :</small>
                        @foreach(var meal in plan.Nutrition.Meals)
                        {
                            <span class="pet-feed-food" title="@report.FoodPriceTooltip(meal.Food.Id)">
                                <TradeItemImage Name="@meal.Food.Name" ItemId="meal.Food.Id" IconId="meal.Food.IconId" Tooltip="@report.FoodPriceTooltip(meal.Food.Id)" Size="18" />
                                <button class="pet-feed-name" title="@report.FoodPriceTooltip(meal.Food.Id)" @onclick="()=>CopyRequested.InvokeAsync(new[]{meal.Food.Name}.AsEnumerable())">@meal.Food.Name</button>
                                <span class="pet-feed-quantity">× @meal.Quantity.ToString("N0")</span>
                            </span>
                        }
                        <strong class="pet-feed-total">- @Money(plan.Nutrition.CashRequired)</strong>
                    </div>
                    @if(plan.Nutrition.Crafts.Count>0)
                    {
                        <details class="pet-craft-details"><summary>Achats et fabrication</summary>
                        @foreach(var purchase in plan.Nutrition.Purchases)
                        {<button class="pet-meal" @onclick="()=>CopyRequested.InvokeAsync(new[]{purchase.Name}.AsEnumerable())"><span>@purchase.Name</span><small>× @purchase.Purchase.PurchasedQuantity</small><strong>@Money(purchase.Purchase.TotalCost)</strong></button>}
                        @foreach(var craft in plan.Nutrition.Crafts)
                        {<div class="pet-meal"><i class="bi bi-hammer"></i><span>@craft.Recipe.Product.Name</span><strong>× @craft.Quantity</strong></div>}
                        </details>
                    }
                </article>
            }
        }
        @if(report.AnalysisComplete && rows.Count==0 && Error is null)
        {<p class="empty"><i class="bi bi-shop" aria-hidden="true"></i> Aucune opportunité chiffrée</p>}
    }
</section>

@code {
    [Parameter] public PetOpportunityReport? Report {get;set;}
    [Parameter] public bool ServerKnown {get;set;}
    [Parameter] public string? Error {get;set;}
    [Parameter] public EventCallback<IEnumerable<string>> CopyRequested {get;set;}
    [Parameter] public bool UseStocks {get;set;}=true;
    [Parameter] public int SkippedFoods {get;set;}
    [Parameter] public EventCallback<bool> UseStocksChanged {get;set;}
    [Parameter] public EventCallback<long> NextFoodRequested {get;set;}
    [Parameter] public EventCallback PreviousFoodRequested {get;set;}
    [Parameter] public EventCallback ResetFoodsRequested {get;set;}
    private Task CopyPetPrices()=>CopyRequested.InvokeAsync(Report?.PetPriceChecks.Select(c=>c.Name) ?? []);
    private Task CopyResourcePrices()=>CopyRequested.InvokeAsync(Report is {} report
        ? PetOpportunityService.FoodPriceNames(report.FoodPriceChecks,report.KnownFoodExperienceItems) : []);
    private static string Money(double? amount)=>amount is {} value?$"{value:N0} K":"—";
}
