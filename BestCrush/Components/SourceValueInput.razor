<div class="source-value-input">
    <input type="number"
           min="@Min"
           step="@Step"
           class="source-value-control"
           value="@Value"
           @onchange="OnChange" />

    <div class="source-value-origin @SourceCssClass"
         title="@Tooltip">
        @SourceLetter
    </div>
</div>

@code
{
    [Parameter]
    public object? Value { get; set; }

    [Parameter]
    public string? Min { get; set; }

    [Parameter]
    public string? Step { get; set; }

    [Parameter]
    public string SourceLetter { get; set; } = "–";

    [Parameter]
    public string SourceCssClass { get; set; } = "source-none";

    [Parameter]
    public string Tooltip { get; set; } =
        "Aucune donnée disponible";

    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }
}