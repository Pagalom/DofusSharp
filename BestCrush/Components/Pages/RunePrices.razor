@page "/servers/{ServerName}/rune-prices"
@implements IDisposable

@using BestCrush.Domain.Models
@using BestCrush.Domain.Services
@using BestCrush.Services

@inject RunesService RunesService
@inject MarketPriceService MarketPriceService
@inject MarketDataChangeNotifier MarketDataChangeNotifier

<div class="container-fluid py-4 px-5">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2>Prix locaux des runes</h2>

            <p class="text-secondary mb-0">
                Serveur : <strong>@ServerName</strong>
            </p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary"
                    type="button"
                    @onclick="RefreshAsync">
                Rafraîchir
            </button>
            <a class="btn btn-outline-secondary"
           href="@($"/servers/{ServerName}")">
            Retour
        </a>
        </div>

    </div>

    <p class="text-secondary">
        Les prix sont enregistrés automatiquement lorsque vous quittez une case.
    </p>

    @if (!string.IsNullOrWhiteSpace(_lastSavedMessage))
    {
        <div class="alert alert-success py-2">
            @_lastSavedMessage
        </div>
    }

    @if (_rows is null)
    {
        <p>Chargement des runes...</p>
    }
    else
    {
        <div class="table-responsive">

            <div class="mb-3">
                <input type="text"
                    class="form-control"
                    placeholder="Rechercher une rune..."
                    @bind="_searchText"
                    @bind:event="oninput" />
            </div>

            <table class="table table-dark table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th style="width: 36%;">Rune</th>
                        <th style="width: 16%;">Prix x1</th>
                        <th style="width: 16%;">Prix x10</th>
                        <th style="width: 16%;">Prix x100</th>
                        <th style="width: 16%;">Prix x1000</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (RunePriceRow row in FilteredRows)
                    {
                        <tr>
                            <td>
                                <strong>@row.Name</strong>
                            </td>

                            <td>
                                <SourceValueInput
                                    Value="@row.Price1"
                                    Min="1"
                                    SourceLetter="@GetSourceLetter(row.Source1)"
                                    SourceCssClass="@GetSourceCss(row.Source1)"
                                    Tooltip="@BuildTooltip(row, 1)"
                                    OnChange="e => SavePriceAsync(row, 1, e)" />
                            </td>

                            <td>
                                <SourceValueInput
                                    Value="@row.Price10"
                                    Min="1"
                                    SourceLetter="@GetSourceLetter(row.Source10)"
                                    SourceCssClass="@GetSourceCss(row.Source10)"
                                    Tooltip="@BuildTooltip(row, 10)"
                                    OnChange="e => SavePriceAsync(row, 10, e)" />
                            </td>

                            <td>
                                <SourceValueInput
                                    Value="@row.Price100"
                                    Min="1"
                                    SourceLetter="@GetSourceLetter(row.Source100)"
                                    SourceCssClass="@GetSourceCss(row.Source100)"
                                    Tooltip="@BuildTooltip(row, 100)"
                                    OnChange="e => SavePriceAsync(row, 100, e)" />
                            </td>

                            <td>
                                <SourceValueInput
                                    Value="@row.Price1000"
                                    Min="1"
                                    SourceLetter="@GetSourceLetter(row.Source1000)"
                                    SourceCssClass="@GetSourceCss(row.Source1000)"
                                    Tooltip="@BuildTooltip(row, 1000)"
                                    OnChange="e => SavePriceAsync(row, 1000, e)" />
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>

@code
{
    [Parameter]
    public required string ServerName { get; set; }

    private List<RunePriceRow>? _rows;

    private string? _lastSavedMessage;
    private string _searchText = "";

    private IEnumerable<RunePriceRow> FilteredRows
    {
        get
        {
            if (_rows is null)
            {
                return [];
            }

            IEnumerable<RunePriceRow> result = _rows;

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                result = result.Where(row =>
                    row.Name.Contains(
                        _searchText,
                        StringComparison.OrdinalIgnoreCase
                    ));
            }

            return result;
        }
    }
    private readonly System.Threading.SemaphoreSlim
        _refreshLock = new(1, 1);

    protected override async Task OnInitializedAsync()
    {
        MarketDataChangeNotifier.Changed +=
            OnMarketDataChanged;

        await LoadRowsAsync();
    }

    private async Task LoadRowsAsync()
    {
        IReadOnlyCollection<Rune> runes =
            await RunesService.GetLocalRunesAsync();

        IReadOnlyDictionary<(long DofusDbId, int Quantity), MarketPriceObservation>
            observations =
                await MarketPriceService.GetLatestObservationsForServerAsync(
                    MarketObjectType.Rune,
                    ServerName
                );
        IReadOnlyDictionary<
        (
            long DofusDbId,
            int Quantity,
            MarketPriceSource Source
        ),
        MarketPriceObservation>
        sourceObservations =
            await MarketPriceService
                .GetLatestLocalSourceObservationsForServerAsync(
                    MarketObjectType.Rune,
                    ServerName
                );

        _rows = runes
            .OrderBy(r => r.Name)
            .Select(rune =>
            {
                RunePriceRow row = new()
                {
                    DofusDbId = rune.DofusDbId,
                    Name = rune.Name
                };

                if (observations.TryGetValue(
                    (rune.DofusDbId, 1),
                    out MarketPriceObservation? price1))
                {
                    row.Price1 = price1.Price;
                    row.Source1 = price1.Source;
                }

                if (observations.TryGetValue(
                    (rune.DofusDbId, 10),
                    out MarketPriceObservation? price10))
                {
                    row.Price10 = price10.Price;
                    row.Source10 = price10.Source;
                }

                if (observations.TryGetValue(
                    (rune.DofusDbId, 100),
                    out MarketPriceObservation? price100))
                {
                    row.Price100 = price100.Price;
                    row.Source100 = price100.Source;
                }

                if (observations.TryGetValue(
                    (rune.DofusDbId, 1000),
                    out MarketPriceObservation? price1000))
                {
                    row.Price1000 = price1000.Price;
                    row.Source1000 = price1000.Source;
                }

                foreach (int quantity in new[] { 1, 10, 100, 1000 })
                {
                    if (sourceObservations.TryGetValue(
                        (
                            rune.DofusDbId,
                            quantity,
                            MarketPriceSource.Manual
                        ),
                        out MarketPriceObservation? manual))
                    {
                        row.SetManualPrice(
                            quantity,
                            manual.Price
                        );
                    }

                    if (sourceObservations.TryGetValue(
                        (
                            rune.DofusDbId,
                            quantity,
                            MarketPriceSource.InGameAutomatic
                        ),
                        out MarketPriceObservation? game))
                    {
                        row.SetGamePrice(
                            quantity,
                            game.Price
                        );
                    }
                }

                return row;
            })
            .ToList();
        }

    private Task RefreshAsync()
    {
        return ReloadFromMarketAsync();
    }

    private void OnMarketDataChanged(
        object? sender,
        MarketDataChangedEventArgs e)
    {
        if (e.ObjectType !=
                MarketObjectType.Rune ||
            !string.Equals(
                e.ServerName,
                ServerName,
                StringComparison.Ordinal))
        {
            return;
        }

        _ = InvokeAsync(
            ReloadFromMarketAsync
        );
    }

    private async Task ReloadFromMarketAsync()
    {
        if (!await _refreshLock.WaitAsync(0))
        {
            return;
        }

        try
        {
            await LoadRowsAsync();
            StateHasChanged();
        }
        finally
        {
            _refreshLock.Release();
        }
    }

    public void Dispose()
    {
        MarketDataChangeNotifier.Changed -=
            OnMarketDataChanged;
        _refreshLock.Dispose();
    }

    private async Task SavePriceAsync(
        RunePriceRow row,
        int quantity,
        ChangeEventArgs args)
    {
        string? value = args.Value?.ToString();

        if (string.IsNullOrWhiteSpace(value))
        {
            await MarketPriceService.ClearManualAsync(
                MarketObjectType.Rune,
                row.DofusDbId,
                ServerName,
                quantity
            );

            MarketPriceObservation? effective =
                await MarketPriceService.GetLatestObservationAsync(
                    MarketObjectType.Rune,
                    row.DofusDbId,
                    ServerName,
                    quantity
                );

            row.SetObservation(
                quantity,
                effective
            );
            row.SetManualPrice(
                quantity,
                null
            );

            _lastSavedMessage =
                $"{row.Name} x{quantity} : valeur manuelle réinitialisée.";
            MarketDataChangeNotifier.Notify(
                MarketObjectType.Rune,
                row.DofusDbId,
                ServerName,
                quantity
            );

            return;
        }

        if (!long.TryParse(value, out long price) || price <= 0)
        {
            return;
        }

        await MarketPriceService.AddObservationAsync(
            MarketObjectType.Rune,
            row.DofusDbId,
            ServerName,
            price,
            quantity,
            MarketPriceSource.Manual
        );

        row.SetPrice(
            quantity,
            price,
            MarketPriceSource.Manual
        );

        row.SetManualPrice(
            quantity,
            price
        );

        _lastSavedMessage =
            $"{row.Name} x{quantity} : {price:N0} kamas enregistré.";
        MarketDataChangeNotifier.Notify(
            MarketObjectType.Rune,
            row.DofusDbId,
            ServerName,
            quantity
        );
    }

    private static string GetSourceLetter(
        MarketPriceSource? source)
    {
        return source switch
        {
            MarketPriceSource.Manual => "M",
            MarketPriceSource.InGameAutomatic => "J",
            _ => "–"
        };
    }

    private static string GetSourceCss(
        MarketPriceSource? source)
    {
        return source switch
        {
            MarketPriceSource.Manual =>
                "source-manual",

            MarketPriceSource.InGameAutomatic =>
                "source-game",

            _ =>
                "source-none"
        };
    }

    private static string BuildTooltip(
        RunePriceRow row,
        int quantity)
    {
        long? manual =
            row.GetManualPrice(quantity);

        long? game =
            row.GetGamePrice(quantity);

        List<string> lines = [];

        if (manual is long manualPrice)
        {
            lines.Add(
                $"Manuel : {manualPrice:N0} kamas"
            );
        }

        if (game is long gamePrice)
        {
            lines.Add(
                $"Jeu : {gamePrice:N0} kamas"
            );
        }

        return lines.Count > 0
            ? string.Join("\n", lines)
            : "Aucune donnée disponible";
    }

    private class RunePriceRow
    {
        public required long DofusDbId { get; init; }

        public required string Name { get; init; }

        public long? Price1 { get; set; }
        public MarketPriceSource? Source1 { get; set; }

        public long? Price10 { get; set; }
        public MarketPriceSource? Source10 { get; set; }

        public long? Price100 { get; set; }
        public MarketPriceSource? Source100 { get; set; }

        public long? Price1000 { get; set; }
        public MarketPriceSource? Source1000 { get; set; }

        public long? ManualPrice1 { get; set; }
        public long? GamePrice1 { get; set; }

        public long? ManualPrice10 { get; set; }
        public long? GamePrice10 { get; set; }

        public long? ManualPrice100 { get; set; }
        public long? GamePrice100 { get; set; }

        public long? ManualPrice1000 { get; set; }
        public long? GamePrice1000 { get; set; }

        public void SetPrice(
            int quantity,
            long? price,
            MarketPriceSource? source)
        {
            switch (quantity)
            {
                case 1:
                    Price1 = price;
                    Source1 = source;
                    break;

                case 10:
                    Price10 = price;
                    Source10 = source;
                    break;

                case 100:
                    Price100 = price;
                    Source100 = source;
                    break;

                case 1000:
                    Price1000 = price;
                    Source1000 = source;
                    break;
            }
        }

        public void SetManualPrice(
            int quantity,
            long? price)
        {
            switch (quantity)
            {
                case 1:
                    ManualPrice1 = price;
                    break;

                case 10:
                    ManualPrice10 = price;
                    break;

                case 100:
                    ManualPrice100 = price;
                    break;

                case 1000:
                    ManualPrice1000 = price;
                    break;
            }
        }

        public void SetGamePrice(
            int quantity,
            long? price)
        {
            switch (quantity)
            {
                case 1:
                    GamePrice1 = price;
                    break;

                case 10:
                    GamePrice10 = price;
                    break;

                case 100:
                    GamePrice100 = price;
                    break;

                case 1000:
                    GamePrice1000 = price;
                    break;
            }
        }

        public long? GetManualPrice(
            int quantity)
        {
            return quantity switch
            {
                1 => ManualPrice1,
                10 => ManualPrice10,
                100 => ManualPrice100,
                1000 => ManualPrice1000,
                _ => null
            };
        }

        public long? GetGamePrice(
            int quantity)
        {
            return quantity switch
            {
                1 => GamePrice1,
                10 => GamePrice10,
                100 => GamePrice100,
                1000 => GamePrice1000,
                _ => null
            };
        }

        public void SetObservation(
            int quantity,
            MarketPriceObservation? observation)
        {
            SetPrice(
                quantity,
                observation?.Price,
                observation?.Source
            );
        }
    }
}