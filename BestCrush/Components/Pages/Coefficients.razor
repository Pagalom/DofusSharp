@using Microsoft.Extensions.DependencyInjection
@inject IServiceScopeFactory DataScopes
@page "/servers/{ServerName}/coefficients"

@using BestCrush.Domain.Models
@using BestCrush.Domain.Services
@using BestCrush.Services

@inject ItemsService ItemsService
@inject CoefficientService CoefficientService
@inject MarketDataChangeNotifier MarketDataChangeNotifier

@inject ServerViewFilterState ServerViewFilter
@implements IDisposable

<div class="container-fluid workspace-page px-3 px-lg-4">

    <PageHeading Title="@(IsEmbedded ? "Coefficients" : "Coefficients de brisage")" Description="Les coefficients sont enregistrés automatiquement lorsque vous quittez une case. Une valeur manuelle remplace la valeur initiale provenant de DoFocus.">
        <ChildContent>@if (!IsEmbedded) { <p class="small text-secondary mb-0">Serveur : <strong>@ServerName</strong></p> }</ChildContent>
        <Actions>
        @if (!IsEmbedded)
        {


        <a class="btn btn-outline-secondary"
           href="@($"/servers/{ServerName}")">
            Retour
        </a>
        }
        </Actions>
    </PageHeading>

    <div class="mb-3">
        <input type="text"
               class="form-control"
               placeholder="Rechercher un équipement..."
               @bind="_searchText"
               @bind:event="oninput" />
    </div>

    @if (ServerViewFilter.IsBrowsingManually)
    {
        <p class="small text-secondary">Consultation des prix enregistrés : lecture seule. Revenir à un personnage pour modifier les valeurs.</p>
    }

    @if (!string.IsNullOrWhiteSpace(_lastSavedMessage))
    {
        <div class="alert alert-success py-2">
            @_lastSavedMessage
        </div>
    }

    <DataLoadingIndicator Busy="@_background.IsLoading" Failed="@(_background.Error is not null)"
                          Label="@(_rows is null ? "Chargement des données…" : "Actualisation des données…")" Retry="ReloadFromMarketAsync" />
    @if (_rows is not null)
    {
        <PagedDataTable Items="@FilteredRows" ResetKey="@($"{ServerName}|{_searchText}")">
            <RowContent Context="pageRows">
        <div class="table-responsive">

            <table class="table table-dark table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Équipement</th>
                        <th>Niveau</th>
                        <th>Type</th>
                        <th style="width: 20%;">Coefficient (%)</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (CoefficientRow row in pageRows)
                    {
                        <tr @key="row.DofusDbId">
                            <td>
                                @if (Workspace is not null)
                                {
                                    <button type="button" class="btn btn-link text-info p-0 text-start fw-bold"
                                            title="Voir l’historique de @row.Name"
                                            @onclick="() => Workspace.ShowHistory(MarketObjectType.Equipment, row.DofusDbId, row.Name)">@row.Name</button>
                                }
                                else { <strong>@row.Name</strong> }
                            </td>

                            <td>
                                @row.Level
                            </td>

                            <td>
                                @row.Type
                            </td>

                            <td>
                                <SourceValueInput ReadOnly="@ServerViewFilter.IsBrowsingManually"
                                    Value="@row.CoefficientPercent"
                                    Min="0.01"
                                    Step="0.01"
                                    SourceLetter="@GetSourceLetter(row.Source)"
                                    SourceCssClass="@GetSourceCss(row.Source)"
                                    Tooltip="@BuildTooltip(row)"
                                    OnChange="e => SaveCoefficientAsync(row, e)" />
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
            </RowContent>
        </PagedDataTable>
    }

</div>

@code
{
    [Parameter] public bool IsEmbedded { get; set; }
    [Parameter] public DataPriority Priority { get; set; }
    private DataPriority? _loadedPriority;
    [Parameter] public bool IsActive { get; set; } = true;
    private readonly BackgroundDataLoad<List<CoefficientRow>> _background = new();
    private bool _disposed, _reloadPending;
    private int _reloadCycle;
    [CascadingParameter] public WorkspaceNavigation? Workspace { get; set; }

    [Parameter]
    public required string ServerName { get; set; }

    private List<CoefficientRow>? _rows;

    private string _searchText = "";

    private string? _lastSavedMessage;

    private IEnumerable<CoefficientRow> FilteredRows
    {
        get
        {
            if (_rows is null)
            {
                return [];
            }

            IEnumerable<CoefficientRow> result = _rows;

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                result = result.Where(row =>
                    row.Name.Contains(
                        _searchText,
                        StringComparison.OrdinalIgnoreCase
                    ));
            }

            return result;
        }
    }

    private string? _loadedServerName;
    protected override void OnInitialized()
    {
        MarketDataChangeNotifier.Changed += OnMarketDataChanged;
        ServerViewFilter.Changed += OnBrowseModeChanged;
    }
    protected override async Task OnParametersSetAsync()
    {
        if (!IsActive)
        {
            _reloadPending |= _background.IsLoading;
            _background.Cancel();
            return;
        }
        if (_loadedPriority != Priority || !string.Equals(_loadedServerName, ServerName, StringComparison.OrdinalIgnoreCase))
        {
            _background.Cancel();
            _loadedServerName = ServerName;
            _loadedPriority = Priority;
            _rows = null;
            _lastSavedMessage = null;
            _reloadPending = true;
        }
        if (_rows is null || _reloadPending) await ReloadFromMarketAsync();
    }
    private Task RefreshAsync() => ReloadFromMarketAsync();
    private void OnMarketDataChanged(object? sender, MarketDataChangedEventArgs args)
    {
        if (args.ObjectType != MarketObjectType.Equipment ||
            !string.Equals(args.ServerName, ServerName, StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(ReloadFromMarketAsync);
    }
    private async Task ReloadFromMarketAsync()
    {
        if (_disposed || !IsActive || _background.IsLoading) { _reloadPending = true; return; }
        int cycle = ++_reloadCycle;
        do
        {
            _reloadPending = false;
            string server = ServerName;
            var pending = _background.RunAsync(token => ReadRowsAsync(server, token));
            StateHasChanged();
            bool loaded = await pending;
            if (_disposed || cycle != _reloadCycle) return;
            if (loaded && IsActive && string.Equals(server, ServerName, StringComparison.OrdinalIgnoreCase))
                _rows = _background.Value;
        } while (_reloadPending && IsActive && !_disposed);
        if (!_disposed) StateHasChanged();
    }
    private void OnBrowseModeChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    public void Dispose()
    {
        _disposed = true;
        _reloadCycle++;
        _background.Dispose();
        ServerViewFilter.Changed -= OnBrowseModeChanged;
        MarketDataChangeNotifier.Changed -= OnMarketDataChanged;
    }

    private async Task<List<CoefficientRow>> ReadRowsAsync(string loadedFromServer, CancellationToken cancellationToken)
    {
        using var scope = DataScopes.CreateScope();
        var itemsService = scope.ServiceProvider.GetRequiredService<ItemsService>();
        var coefficientService = scope.ServiceProvider.GetRequiredService<CoefficientService>();
        IReadOnlyCollection<Equipment> equipments =
            await itemsService.GetEquipmentValueCatalogAsync(cancellationToken: cancellationToken);

        IReadOnlyDictionary<long, CoefficientObservation> coefficients =
            await coefficientService.GetLatestObservationsForServerAsync(
                loadedFromServer, cancellationToken);
        
        IReadOnlyDictionary<
            (long DofusDbId, CoefficientSource Source),
            CoefficientObservation>
            sourceObservations =
                await coefficientService
                    .GetLatestLocalSourceObservationsForServerAsync(
                        loadedFromServer, cancellationToken);

        return equipments
            .OrderBy(e => e.Name)
            .Select(equipment =>
            {
                CoefficientRow row = new()
                {
                    DofusDbId = equipment.DofusDbId,
                    Name = equipment.Name,
                    Level = equipment.Level,
                    Type = equipment.Type.ToString()
                };

                if (coefficients.TryGetValue(
                    equipment.DofusDbId,
                    out CoefficientObservation? coefficient))
                {
                    row.CoefficientPercent =
                        coefficient.CoefficientPercent;

                    row.Source =
                        coefficient.Source;
                }
                
                if (sourceObservations.TryGetValue(
                    (
                        equipment.DofusDbId,
                        CoefficientSource.Manual
                    ),
                    out CoefficientObservation? manual))
                {
                    row.ManualCoefficient =
                        manual.CoefficientPercent;
                }

                if (sourceObservations.TryGetValue(
                    (
                        equipment.DofusDbId,
                        CoefficientSource.InGameAutomatic
                    ),
                    out CoefficientObservation? game))
                {
                    row.GameCoefficient =
                        game.CoefficientPercent;
                }

                return row;
            })
            .ToList();
    }

    private async Task SaveCoefficientAsync(
        CoefficientRow row,
        ChangeEventArgs args)
    {
        // A server picked for SQL browsing must never be a write target.
        if (ServerViewFilter.IsBrowsingManually)
            return;

        string? value = args.Value?.ToString();

        if (string.IsNullOrWhiteSpace(value))
        {
            await CoefficientService.ClearLocalAsync(
                row.DofusDbId,
                ServerName
            );

            row.ManualCoefficient = null;
            row.GameCoefficient = null;

            bool refreshedFromDofocus =
                await TryRefreshDofocusCoefficientAsync(
                    row
                );

            CoefficientObservation? effective =
                await CoefficientService.GetLatestObservationAsync(
                    row.DofusDbId,
                    ServerName
                );

            row.CoefficientPercent =
                effective?.CoefficientPercent;

            row.Source =
                effective?.Source;

            _lastSavedMessage =
                effective?.Source ==
                    CoefficientSource.DofocusInitial
                    ? refreshedFromDofocus
                        ? $"{row.Name} : valeurs locales réinitialisées, coefficient DoFocus actualisé."
                        : $"{row.Name} : valeurs locales réinitialisées, coefficient DoFocus utilisé."
                    : $"{row.Name} : valeurs locales réinitialisées, aucun coefficient DoFocus disponible.";

            MarketDataChangeNotifier.Notify(
                MarketObjectType.Equipment,
                row.DofusDbId,
                ServerName,
                0
            );

            return;
        }

        if (!double.TryParse(value, out double coefficient) ||
            coefficient <= 0)
        {
            return;
        }

        await CoefficientService.AddObservationAsync(
            row.DofusDbId,
            ServerName,
            coefficient,
            CoefficientSource.Manual
        );

        row.CoefficientPercent = coefficient;
        row.Source = CoefficientSource.Manual;

        _lastSavedMessage =
            $"{row.Name} : coefficient {coefficient:0.##}% enregistré.";
        
        row.ManualCoefficient = coefficient;

        MarketDataChangeNotifier.Notify(
            MarketObjectType.Equipment,
            row.DofusDbId,
            ServerName,
            0
        );
    }

    private async Task<bool>
        TryRefreshDofocusCoefficientAsync(
            CoefficientRow row)
    {
        try
        {
            var detailedItem =
                await ItemsService.GetItemAsync(
                    row.DofusDbId,
                    forceRefresh: true
                );

            var dofocusCoefficient =
                detailedItem.Coefficients
                    .Where(record =>
                        record.ServerName ==
                            ServerName)
                    .OrderByDescending(record =>
                        record.LastUpdate)
                    .FirstOrDefault();

            if (dofocusCoefficient is null ||
                dofocusCoefficient.Coefficient <= 0)
            {
                return false;
            }

            await CoefficientService
                .AddObservationAsync(
                    row.DofusDbId,
                    ServerName,
                    dofocusCoefficient.Coefficient,
                    CoefficientSource.DofocusInitial
                );

            return true;
        }
        catch
        {
            // Si DoFocus est indisponible, l'ancien
            // coefficient DoFocus déjà stocké reste
            // utilisable comme fallback.
            return false;
        }
    }

    private static string GetSourceLetter(
        CoefficientSource? source)
    {
        return source switch
        {
            CoefficientSource.Manual => "M",
            CoefficientSource.InGameAutomatic => "J",
            CoefficientSource.DofocusInitial => "D",
            _ => "–"
        };
    }

    private static string GetSourceCss(
        CoefficientSource? source)
    {
        return source switch
        {
            CoefficientSource.Manual =>
                "source-manual",

            CoefficientSource.InGameAutomatic =>
                "source-game",

            _ =>
                "source-none"
        };
    }

    private static string BuildTooltip(
        CoefficientRow row)
    {
        List<string> lines = [];

        if (row.ManualCoefficient is double manual)
        {
            lines.Add(
                $"Manuel : {manual:0.##} %"
            );
        }

        if (row.GameCoefficient is double game)
        {
            lines.Add(
                $"Jeu : {game:0.##} %"
            );
        }

        if (row.Source ==
                CoefficientSource.DofocusInitial &&
            row.CoefficientPercent is double dofocus)
        {
            lines.Add(
                $"DoFocus : {dofocus:0.##} %"
            );
        }

        return lines.Count > 0
            ? string.Join("\n", lines)
            : "Aucune donnée disponible";
    }

    private class CoefficientRow
    {
        public required long DofusDbId { get; init; }

        public required string Name { get; init; }

        public required int Level { get; init; }

        public required string Type { get; init; }

        public double? CoefficientPercent { get; set; }

        public double? ManualCoefficient { get; set; }

        public double? GameCoefficient { get; set; }

        public CoefficientSource? Source { get; set; }
    }
}