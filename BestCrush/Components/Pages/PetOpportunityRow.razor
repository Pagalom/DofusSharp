@using BestCrush.Services
@using BestCrush.Models
@using BestCrush.Network.Protocol

<details class="card mb-2">
    <summary class="card-header d-flex align-items-center gap-3">
        <StockItemArtwork Stock="Report.Stock" ItemId="Assessment.Species.Id">
            <ItemIcon Item="Assessment.Species" Size="Size.Small" />
        </StockItemArtwork>
        <span class="flex-grow-1">
            <strong><CopyTextButton Value="@Assessment.Species.Name" Tooltip="Copier le nom">@Assessment.Species.Name</CopyTextButton></strong>
            <span class="d-block small">@SourceDescription</span>
        </span>
        @if (Progress is { } percent)
        {
            <span class="pet-goal-progress" data-bs-toggle="tooltip" data-bs-title="Progression automatique : obtention, nourriture, XP puis mise en vente.">
                <progress value="@percent" max="100" aria-label="Progression du familier"></progress><strong>@percent %</strong>
            </span>
        }
        @if(Assessment.Issue is { } issue)
        {
            <StatusIcon Icon="exclamation-triangle" Tooltip="@issue" Label="Données à compléter" CssClass="text-warning" />
        }
        @if(Analyzing && Assessment.Best is null)
        { <span role="status" class="spinner-border spinner-border-sm" aria-label="Calcul des conseils"></span> }
        @if(Assessment.Best is { } header)
        {
            @if(header.RemainingListings==0)
            { <StatusIcon Icon="x-circle" Tooltip="Quota de mise en vente atteint." Label="Ne plus mettre en vente" CssClass="text-danger" /> }
            else if(header.RemainingListings is { } remaining)
            {
                <span class="text-nowrap text-warning" tabindex="0" data-bs-toggle="tooltip" data-bs-custom-class="multiline-tooltip"
                      data-bs-title="@($"Encore {remaining:N0} à mettre en vente. Estimation globale de l’espèce, tous niveaux et pouvoirs confondus.")">× @remaining.ToString("N0")</span>
            }
            else
            { <StatusIcon Icon="clock-history" Tooltip="Volume de ventes à relever." CssClass="text-warning" /> }
            <span class="text-end">@(Assessment.Owned is not null && Assessment.CurrentResale is null ? "Niveau étudié" : "Niveau conseillé") <strong>@header.Level</strong><br />
                @(Assessment.Owned is null ? "Marge estimée" : "Gain supplémentaire")
                <strong class="@(header.Margin>0 ? "text-success" : "")">@Money(header.Margin)</strong>
            </span>
        }
    </summary>
    <div class="card-body">
        @if(Assessment.Best is { } choice)
        {
            <div class="d-flex flex-wrap gap-4 mb-3 pet-price-summary">
                <span>@(Assessment.Owned is null ? "Prix d’achat" : "Vente au niveau actuel")<br /><strong>@Money(Assessment.Owned is null ? Assessment.AcquisitionCost : Assessment.CurrentResale)</strong></span>
                <span>À débourser en nourriture<br /><strong>@Money(choice.Nutrition.CashRequired)</strong></span>
                <span>Valeur du stock consommé<br /><strong>@Money(choice.Nutrition.StockValue)</strong></span>
                <span>Prix de vente conseillé<br /><strong>@Money(choice.SalePrice)</strong></span>
                <StatusIcon Tooltip="Avant taxes. Stocks simulés séparément pour chaque familier ; recalcul après consommation." />
            </div>
            @if(choice.Level==CurrentLevel && Assessment.Owned is not null)
            {
                <p><i class="bi bi-shop" aria-hidden="true"></i> Vendre au niveau @CurrentLevel
                    <StatusIcon Tooltip="Nourrir davantage n’améliore pas la marge parmi les niveaux relevés." />
                </p>
            }
            else
            {
                <div class="pet-feeding-route">
                    <p><i class="bi bi-cart pet-route-icon" role="img" aria-label="Achat" title="Achat"></i> Niveau @CurrentLevel · <strong>@Money(Assessment.Owned is null ? Assessment.AcquisitionCost : Assessment.CurrentResale)</strong></p>
                    <div class="pet-food-line">
                        <i class="bi bi-fork-knife pet-route-icon" role="img" aria-label="Nourriture" title="Nourriture"></i>
                        @foreach(var meal in choice.Nutrition.Meals.GroupBy(meal=>meal.Food.Id))
                        {
                            var food=meal.First().Food;
                            <span class="pet-food-item">
                                <StockItemArtwork Stock="Report.Stock" ItemId="food.Id"><ItemIcon Item="food" Size="Size.Tiny" Tooltip="@Report.FoodPriceTooltip(food.Id)" /></StockItemArtwork>
                                <CopyTextButton Value="@food.Name" Tooltip="@Report.FoodPriceTooltip(food.Id)">@food.Name</CopyTextButton>
                                <span>× @meal.Sum(line=>line.Quantity).ToString("N0")</span>
                            </span>
                        }
                        <span>- <strong>@Money(choice.Nutrition.CashRequired)</strong></span>
                        <span class="pet-route-arrows" role="group" aria-label="Choisir la nourriture">
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(!CanChoosePrevious || Analyzing)" title="Revenir au meilleur aliment" aria-label="Revenir au meilleur aliment" @onclick="ResetFoodsRequested"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(!CanChoosePrevious || Analyzing)" title="Aliment précédent" aria-label="Aliment précédent" @onclick="PreviousFoodRequested"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
                            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(Analyzing || choice.Nutrition.Meals.Count==0)" title="Aliment suivant par coût d’XP" aria-label="Aliment suivant" @onclick="()=>NextFoodRequested.InvokeAsync(choice.Nutrition.Meals[0].Food.Id)"><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                        </span>
                    </div>
                    <p><i class="bi bi-shop pet-route-icon" role="img" aria-label="Revente" title="Revente"></i> Niveau @choice.Level · <strong>@Money(choice.SalePrice)</strong></p>
                </div>
            }
            @if(choice.Nutrition.StockConsumed.Count>0)
            {
                <details><summary>Ressources à prendre dans les stocks</summary><ul>
                    @foreach(var use in choice.Nutrition.StockConsumed)
                    {
                        int inventory=(int)System.Numerics.BigInteger.Min(use.Value,Report.Inventory.GetValueOrDefault(use.Key));
                        <li>@StockName(use.Key) · <StatusIcon Icon="box-seam" Tooltip="Inventaire" /> @inventory.ToString("N0") · <StatusIcon Icon="bank" Tooltip="Banque" /> @((use.Value-inventory).ToString("N0"))</li>
                    }
                </ul></details>
            }
            <details class="mt-2"><summary>Comparer les niveaux relevés (@Assessment.Options.Count)</summary>
                <table class="table table-dark table-striped">
                    <thead><tr><th>Niveau</th><th>À débourser</th><th>Stock utilisé</th><th>Vente conseillée</th><th>Gain estimé</th></tr></thead>
                    <tbody>@foreach(var option in Assessment.Options.OrderBy(option=>option.Level))
                        {<tr class="@(option==choice ? "table-active" : "")"><td>@option.Level</td><td>@Money(option.Nutrition.CashRequired)</td><td>@Money(option.Nutrition.StockValue)</td><td>@Money(option.SalePrice)</td><td>@Money(option.Margin)</td></tr>}
                    </tbody>
                </table>
            </details>
        }
    </div>
</details>

@code{
    [Parameter,EditorRequired] public PetAssessment Assessment {get;set;}=null!;
    [Parameter,EditorRequired] public PetOpportunityReport Report {get;set;}=null!;
    [Parameter] public DofusClientWindowKey? TargetWindow {get;set;}
    [Parameter] public int? Progress {get;set;}
    [Parameter] public bool Analyzing {get;set;}
    [Parameter] public bool CanChoosePrevious {get;set;}
    [Parameter] public EventCallback<long> NextFoodRequested {get;set;}
    [Parameter] public EventCallback PreviousFoodRequested {get;set;}
    [Parameter] public EventCallback ResetFoodsRequested {get;set;}
    private int? CurrentLevel=>Assessment.Owned?.Reading?.Level ?? Assessment.Purchase?.Level;
    private string SourceDescription=>Assessment.Owned is { } own
        ? $"{(own.Container=="bank" ? "Banque" : "Inventaire")} · niveau {own.Reading?.Level.ToString() ?? "inconnu"} · {own.Reading?.Experience?.ToString("N0") ?? "—"} XP · × {own.Quantity}"
        : $"Achat HDV · niveau {Assessment.Purchase?.Level}";
    private static string Money(double? value)=>value is { } amount ? $"{amount:N0} K" : "—";
    private string StockName(long id)=>Assessment.Best?.Nutrition.Meals.FirstOrDefault(line=>line.Food.Id==id)?.Food.Name ??
        Assessment.Best?.Nutrition.Crafts.SelectMany(craft=>craft.Ingredients).FirstOrDefault(line=>line.ItemId==id)?.Name ?? $"Objet #{id}";
}
