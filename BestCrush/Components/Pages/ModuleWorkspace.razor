@page "/modules/{Slug}"
@using BestCrush.Components
@using BestCrush.Services
@inject ServerViewFilterState ServerViewFilter
@implements IDisposable

<div class="@(_module?.Slug == "analyses" ? "container-fluid workspace-page" : "container workspace-page")">
    @if (_module is null)
    {
        <PageHeading Title="Module introuvable" Description="Ce module n’est pas défini dans BestCrush." />
    }
    else if (_module.Slug == "routine")
    {
        <RoutineWorkspace ServerName="@ServerViewFilter.ServerName" />
    }
    else if (_module.Slug == "analyses")
    {
        @if (ServerViewFilter.ServerName is { } analysisServer)
        {
            <AnalyticsWorkspace ServerName="@analysisServer" />
        }
        else
        {
            <PageHeading Title="Analyses" Description="Comparez l’évolution des prix d’objets et de groupes, en kamas ou en base 100." />
            <p class="text-secondary">Choisissez un serveur en haut pour consulter vos analyses.</p>
        }
    }
    else if (_module.Slug == "concassage")
    {
        <PageHeading Title="Concassage" Description="Comparez les équipements à briser selon leur coût d’achat ou de craft et la valeur estimée des runes." />
        @if (ServerViewFilter.ServerName is { } viewServer)
        {
            <a href="@KnownRoutes.Server(viewServer)">Voir les données du serveur</a>
        }
        else
        {
            <div class="alert alert-info mt-4" role="status">
                Pas de serveur sélectionné. Veuillez sélectionner un serveur
            </div>
        }
    }
    else if (_module.Slug == "forgemagie")
    {
        <ForgemagingWorkspace ServerName="@ServerViewFilter.ServerName" />
    }
    else if (_module.Slug == "craft")
    {
        <StockOpportunities OriginFilter="craft" ItemId="ItemId" InitialQuantity="@(Quantity ?? 1)" />
    }
    else if (_module.Slug == "opportunites")
    {
        <ActivityOpportunities @key="_module.Slug" ItemId="ItemId" />
    }
    else if (_module.Slug is "achat-vente" or "pierres-ame" or "farming")
    {
        <ActivityOpportunities @key="_module.Slug" Module="@_module.Slug" ItemId="ItemId" />
    }
    else
    {
        <PageHeading Title="@_module.Name" Description="Service en préparation." />
        <div class="alert alert-secondary mt-4" role="status">
            <strong>Module en préparation.</strong>
            Son interface est disponible dans la nouvelle navigation.
            Les fonctionnalités métier seront intégrées dans les prochains lots.
        </div>
        <p class="text-secondary">
            Les données de marché et les captures existantes ne sont pas
            modifiées par ce module pour le moment.
        </p>
    }
</div>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name="item")] public long? ItemId {get;set;}
    [SupplyParameterFromQuery(Name="quantity")] public int? Quantity {get;set;}
    private WorkspaceModule? _module;

    protected override void OnInitialized() => ServerViewFilter.Changed += ServerChanged;

    private void ServerChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ServerViewFilter.Changed -= ServerChanged;

    protected override void OnParametersSet()
    {
        _module = WorkspaceModules.Find(Slug);
    }
}
