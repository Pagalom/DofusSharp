@page "/modules/{Slug}"
@using BestCrush.Components
@using BestCrush.Services
@inject ServerViewFilterState ServerViewFilter

<div class="container py-4">
    @if (_module is null)
    {
        <h1>Module introuvable</h1>
        <p>Ce module n'est pas défini dans BestCrush.</p>
    }
    else if (_module.Slug == "concassage")
    {
        <h1>Concassage</h1>
        @if (ServerViewFilter.ServerName is { } viewServer)
        {
            <div class="alert alert-info mt-4" role="status">
                Le serveur <strong>@viewServer</strong> est sélectionné pour
                consulter les prix et les historiques déjà enregistrés.
                Ce filtre ne change pas le serveur des personnages ni celui
                des nouvelles observations réseau.
            </div>
            <a href="@KnownRoutes.Server(viewServer)">Voir les données du serveur</a>
        }
        else
        {
            <div class="alert alert-info mt-4" role="status">
                Aucun serveur de consultation défini. Choisissez un serveur
                dans le filtre en haut à droite pour consulter son historique,
                ou ciblez un personnage dont le serveur a été identifié.
                Les captures réseau restent associées automatiquement au
                serveur réel de chaque connexion Dofus.
            </div>
            <a href="@KnownRoutes.Profile()">Consulter les fiches des personnages</a>
        }
    }
    else
    {
        <h1>@_module.Name</h1>
        <div class="alert alert-secondary mt-4" role="status">
            <strong>Module en préparation.</strong>
            Son interface est disponible dans la nouvelle navigation.
            Les fonctionnalités métier seront intégrées dans les prochains lots.
        </div>
        <p class="text-secondary">
            Les données de marché et les captures existantes ne sont pas
            modifiées par ce module pour le moment.
        </p>
    }
</div>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private WorkspaceModule? _module;

    protected override void OnParametersSet()
    {
        _module = WorkspaceModules.Find(Slug);
    }
}
