@inject ItemsService ItemsService
@inject RunesService RunesService
@inject BestCrush.Services.BestCrushSettingsService BestCrushSettings
@inject CrushService CrushService
@inject ILogger<Server> Logger
@inject CoefficientService CoefficientService
@inject BestCrush.Services.OverlayService OverlayService
@inject BestCrush.Services.CurrentServerState CurrentServerState
@inject IDataPriorityProvider DataPriorityProvider
@inject MarketPriceService MarketPriceService
@inject CraftCostService CraftCostService
@inject EquipmentProfitabilityService EquipmentProfitabilityService

@implements IDisposable

@page "/servers/{ServerName}"
@using BestCrush.Components.Pure
@using BestCrush.Domain.Models
@using BestCrush.Domain.Services
@using BestCrush.Models
@using DofusSharp.Dofocus.ApiClients.Models.Items
@using Microsoft.Extensions.Logging


<div class="container">
    <div class="d-flex justify-content-end gap-2 mb-3">
        
        <a class="btn btn-outline-secondary"
        href="@($"/servers/{ServerName}/equipment-prices")">
            Prix locaux des équipements
        </a>

        <a class="btn btn-outline-secondary"
        href="@($"/servers/{ServerName}/rune-prices")">
            Prix locaux des runes
        </a>
        <a class="btn btn-outline-secondary"
        href="@($"/servers/{ServerName}/resource-prices")">
            Prix locaux des ressources
        </a>
        <a class="btn btn-outline-secondary"
        href="@($"/servers/{ServerName}/coefficients")">
            Coefficients
        </a>
        <button type="button"
                class="btn btn-outline-info"
                @onclick="OverlayService.Toggle">
            Overlay
        </button>
        <button class="btn btn-outline-secondary"
                title="Paramètres"
                aria-label="Paramètres"
                @onclick="OpenSettings">
            ⚙
        </button>

        @if (_showSettings)
        {
            <div style="
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.45);
                z-index: 2000;
                display: flex;
                align-items: center;
                justify-content: center;"
                @onclick="CloseSettings">

                <div class="card shadow"
                    style="
                        width: 460px;
                        max-width: calc(100vw - 40px);
                        padding: 20px;
                        max-height: calc(100vh - 40px);
                        overflow-y: auto;"
                    @onclick:stopPropagation="true">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="m-0">
                            Paramètres
                        </h4>

                        <button type="button"
                                class="btn-close"
                                @onclick="CloseSettings">
                        </button>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            Données capturées automatiquement
                        </label>

                        <div class="text-muted small mb-3">
                            Choisis quelles données BestCrush est autorisé
                            à enregistrer automatiquement depuis Dofus.
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input"
                                type="checkbox"
                                id="capture-equipment"
                                @bind="BestCrushSettings.EquipmentCaptureEnabled" />

                            <label class="form-check-label"
                                for="capture-equipment">
                                Prix des équipements
                            </label>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input"
                                type="checkbox"
                                id="capture-runes"
                                @bind="BestCrushSettings.RuneCaptureEnabled" />

                            <label class="form-check-label"
                                for="capture-runes">
                                Prix des runes
                            </label>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input"
                                type="checkbox"
                                id="capture-resources"
                                @bind="BestCrushSettings.ResourceCaptureEnabled" />

                            <label class="form-check-label"
                                for="capture-resources">
                                Prix des ressources
                            </label>
                        </div>

                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                type="checkbox"
                                id="capture-coefficients"
                                @bind="BestCrushSettings.CoefficientCaptureEnabled" />

                            <label class="form-check-label"
                                for="capture-coefficients">
                                Coefficients de brisage
                            </label>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            Priorité des données
                        </label>

                        <div class="text-muted small mb-2">
                            Détermine quelle source est utilisée lorsqu'une
                            valeur manuelle et une capture jeu sont disponibles.
                        </div>

                        <select class="form-select"
                                value="@DataPriorityProvider.Priority"
                                @onchange="OnDataPriorityChanged">

                            <option value="@DataPriority.Manual">
                                Manuel
                            </option>

                            <option value="@DataPriority.InGameAutomatic">
                                Capture jeu
                            </option>

                        </select>
                    </div>

                    <hr />

                    <div class="mb-2">
                        <label class="form-label fw-bold"
                            for="crush-yield-estimation-mode">
                            Estimation du jet de concassage
                        </label>

                        <div class="text-muted small mb-2">
                            Détermine le jet utilisé pour estimer le nombre
                            de runes obtenu lors du concassage.
                        </div>

                        <select id="crush-yield-estimation-mode"
                                class="form-select"
                                value="@BestCrushSettings.CrushYieldEstimationMode"
                                @onchange="OnCrushYieldEstimationModeChanged">

                            <option value="@CrushYieldEstimationMode.Conservative">
                                Jet prudent de concassage
                            </option>

                            <option value="@CrushYieldEstimationMode.Average">
                                Jet moyen de concassage
                            </option>

                        </select>

                        <div class="text-muted small mt-2">
                            Prudent : utilise le jet minimum de chaque caractéristique.
                            Moyen : utilise la moyenne entre le minimum et le maximum.
                        </div>
                    </div>

                    <hr />

                    <div class="mb-2">
                        <label class="form-label fw-bold"
                            for="target-roi">
                            Objectif de rentabilité
                        </label>

                        <div class="text-muted small mb-2">
                            Rendement minimum souhaité pour déterminer
                            le prix maximal d'achat d'un équipement.
                        </div>

                        <div class="input-group">
                            <input id="target-roi"
                                type="number"
                                class="form-control"
                                min="0"
                                max="1000"
                                step="1"
                                @bind="BestCrushSettings.TargetRoiPercent" />

                            <span class="input-group-text">
                                %
                            </span>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-2">
                        <label class="form-label fw-bold">
                            Outils développeur
                        </label>

                        <div class="text-muted small mb-3">
                            Permet de conserver temporairement les captures
                            et les crops OCR pour analyser les détections.
                        </div>

                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                type="checkbox"
                                id="devtool-remove-screenshots"
                                @bind="BestCrushSettings.DevTool_RemoveScreenshotsByDefault" />

                            <label class="form-check-label"
                                for="devtool-remove-screenshots">
                                DevTool_RemoveScreenshotsByDefault
                            </label>
                        </div>

                        <div class="text-muted small mt-2">
                            Activé : les captures sont supprimées après traitement.
                            Désactivé : les captures et crops de debug sont conservés.
                        </div>
                    <hr />

                    <div class="mb-2">
                        <label class="form-label fw-bold">
                            Disposition des overlays
                        </label>

                        <div class="text-muted small mb-3">
                            Les positions et tailles sont conservées automatiquement
                            entre les lancements et les mises à jour.
                        </div>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="RestoreOverlayLayouts">
                            Restaurer la position par défaut des overlays
                        </button>

                        @if (!string.IsNullOrWhiteSpace(
                            _overlayLayoutResetMessage))
                        {
                            <div class="text-success small mt-2">
                                @_overlayLayoutResetMessage
                            </div>
                        }
                    </div>
                    </div>

                </div>
            </div>
        }

    </div>

    <form method="post" @onsubmit="Count" @formname="search-form">
        <SearchItemsForm Model="Model" Disabled="_searching"></SearchItemsForm>
        <div class="d-flex justify-content-center my-4">
            <button class="btn btn-primary" type="submit" disabled="@_searching">Rechercher les objets</button>
        </div>
    </form>

    @if (_allItems is not null && _rankedItems is null)
    {
        <div class="text-center">@_allItems.Length objet(s) correspondent aux critères de recherche.</div>

        <div class="d-flex justify-content-center my-4">
            <button class="btn btn-primary" @onclick="() => Search(false)" disabled="@_searching">Trouver le <span class="fw-semibold">Best Crush</span></button>
        </div>

    }

    @if (_allItems is not null && _searching)
    {
        int ranked = _rankedItems?.GroupBy(i => i.Equipment).Count() ?? 0;
        int unranked = _unrankedItems?.Count ?? 0;
        int done = ranked + unranked;
        double ratio = (double)done / _allItems.Length;
        int percent = (int)(ratio * 100);

        {
            <div class="progress mb-4" role="progressbar" aria-label="Basic example" aria-valuenow="@done" aria-valuemin="0" aria-valuemax="@_allItems.Length">
                <div class="progress-bar progress-bar-striped progress-bar-animated text-bg-warning" style="width: @percent%">@done / @_allItems.Length</div>
            </div>
        }
    }

    @if (_unrankedItems is not null && _rankedItems is not null)
    {
        @if (_rankedItems.Count > 0)
        {
            IEnumerable<IGrouping<Equipment, ItemCrushResult>> equipments =
                _rankedItems.GroupBy(i => i.Equipment);

            IEnumerable<ItemCrushResult> bestLines =
                equipments.Select(group =>
                    _sortOrder == SortOrder.BestYield
                        ? group.MaxBy(result => result.Yield)
                        : group.MaxBy(result => result.Benefits));

            IEnumerable<ItemCrushResult> bestLinesOrdered =
                _sortOrder switch
                {
                    SortOrder.BestYield =>
                        bestLines.OrderByDescending(
                            result => result.Yield
                        ),

                    SortOrder.NameAscending =>
                        bestLines.OrderBy(
                            result => result.Equipment.Name,
                            StringComparer.CurrentCultureIgnoreCase
                        ),

                    SortOrder.HighestCoefficient =>
                        bestLines
                            .OrderByDescending(
                                result =>
                                    result.Coefficient
                                        .CoefficientPercent
                            )
                            .ThenBy(
                                result => result.Equipment.Name,
                                StringComparer.CurrentCultureIgnoreCase
                            ),

                    _ =>
                        bestLines.OrderByDescending(
                            result => result.Benefits
                        )
                };

            <div class="my-4">
                <div class="d-flex align-items-center justify-content-end gap-2 mb-2 px-3">
                    <div class="d-flex gap-2">
                        <label for="sort-order" class="col-form-label col-form-label-sm text-nowrap">Tri par</label>
                        <InputSelect TValue="SortOrder" @bind-Value="_sortOrder" class="form-select form-select-sm" id="sort-order">
                            <option value="">Sélectionner l'ordre de tri...</option>
                            <option value="@SortOrder.BestBenefit" checked="@(_sortOrder == SortOrder.BestBenefit)">Bénéfice (flat)</option>
                            <option value="@SortOrder.BestYield" checked="@(_sortOrder == SortOrder.BestYield)">Rendement (%)</option>
                            <option value="@SortOrder.NameAscending" checked="@(_sortOrder == SortOrder.NameAscending)">Nom (A → Z)</option>
                            <option value="@SortOrder.HighestCoefficient" checked="@(_sortOrder == SortOrder.HighestCoefficient)">Coefficient (décroissant)</option>
                        </InputSelect>
                    </div>
                    <div>
                        <button class="btn btn-light border" @onclick="() => Search(true)">Tout rafraîchir</button>
                    </div>
                </div>
                <ul class="list-group list-group-flush rounded">
                    @{
                        ItemCrushResult[] completeLines =
                            bestLinesOrdered
                                .Where(item => !IsPartial(item))
                                .ToArray();

                        ItemCrushResult[] partialLines =
                            bestLinesOrdered
                                .Where(IsPartial)
                                .ToArray();
                    }
                    @if (completeLines.Length > 0)
                    {
                        <h5 class="mt-4 mb-3">
                            Résultats complets
                            <span class="badge text-bg-success">
                                @completeLines.Length
                            </span>
                        </h5>

                        @foreach (ItemCrushResult item in completeLines)
                        {
                            <li class="list-group-item">
                                <CrushResultLine Equipment="item.Equipment"
                                                Cost="item.Cost"
                                                CraftCost="item.CraftCost"
                                                Coefficient="item.Coefficient"
                                                FocusedCharacteristic="item.FocusedCharacteristic"
                                                Runes="item.Runes"
                                                RuneValues="item.RuneValues"
                                                SortOrder="_sortOrder"
                                                NoImage="_searching"
                                                Refresh="() => Refresh(item.Equipment)"
                                                Focus="() => FocusInOverlay(item.Equipment)" />
                                <CraftCostSummary Result="item.CraftCost" />
                            </li>
                        }
                    }
                    @if (partialLines.Length > 0)
                    {
                        <h5 class="mt-5 mb-1">
                            Résultats partiels
                            <span class="badge text-bg-warning">
                                @partialLines.Length
                            </span>
                        </h5>

                        <p class="text-secondary small">
                            Hors classement : le meilleur scénario réel peut être différent tant que certains prix sont manquants.
                        </p>

                        @foreach (ItemCrushResult item in partialLines)
                        {
                            <li class="list-group-item">

                                <CrushResultLine Equipment="item.Equipment"
                                                Cost="item.Cost"
                                                CraftCost="item.CraftCost"
                                                Coefficient="item.Coefficient"
                                                FocusedCharacteristic="item.FocusedCharacteristic"
                                                Runes="item.Runes"
                                                RuneValues="item.RuneValues"
                                                SortOrder="_sortOrder"
                                                NoImage="_searching"
                                                Refresh="() => Refresh(item.Equipment)"
                                                Focus="() => FocusInOverlay(item.Equipment)" />
                                
                                <CraftCostSummary Result="item.CraftCost" />

                                @if (_missingDataByItem.TryGetValue(
                                    item.Equipment.DofusDbId,
                                    out HashSet<string>? warnings))
                                {
                                    <div class="alert alert-warning py-2 px-3 mt-2 mb-0 small">

                                        <strong>
                                            ⚠ Résultat partiel — meilleur scénario connu
                                        </strong>

                                        <div class="mt-1">
                                            Certaines possibilités de brisage ne peuvent pas encore être valorisées :
                                        </div>

                                        <ul class="mb-0 mt-1">
                                            @foreach (string warning in warnings)
                                            {
                                                <li>@warning</li>
                                            }
                                        </ul>

                                    </div>
                                }

                            </li>
                        }
                    }
                </ul>
            </div>
        }

        @if (_unrankedItems is { Count: > 0 } unrankedItems)
        {
            IEnumerable<Equipment> unrankedItemsOrdered =
                _sortOrder switch
                {
                    SortOrder.NameAscending =>
                        unrankedItems.OrderBy(
                            item => item.Name,
                            StringComparer.CurrentCultureIgnoreCase
                        ),

                    SortOrder.HighestCoefficient =>
                        unrankedItems
                            .OrderByDescending(
                                item =>
                                    _coefficients.TryGetValue(
                                        item.DofusDbId,
                                        out CoefficientObservation? coefficient
                                    )
                                        ? coefficient.CoefficientPercent
                                        : double.MinValue
                            )
                            .ThenBy(
                                item => item.Name,
                                StringComparer.CurrentCultureIgnoreCase
                            ),

                    _ =>
                        unrankedItems
                };

            <div class="my-4">

                <h5>
                    Objets avec données manquantes
                    <span class="badge text-bg-secondary">
                        @unrankedItems.Count
                    </span>
                </h5>

                <div class="list-group">

                    @foreach (Equipment item in unrankedItemsOrdered)
                    {
                        <div class="list-group-item">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <strong>@item.Name</strong>
                                    <span class="text-secondary">
                                        Niv. @item.Level
                                    </span>
                                </div>

                                <span class="badge text-bg-secondary">
                                    Rentabilité indisponible
                                </span>

                            </div>

                            @if (_coefficients.TryGetValue(
                                item.DofusDbId,
                                out CoefficientObservation? coefficient))
                            {
                                <div class="small mt-1 @(coefficient.Source == CoefficientSource.DofocusInitial ? "text-primary" : "text-secondary")">
                                    Coeff. @coefficient.CoefficientPercent.ToString("0.##") %
                                </div>
                            }

                            @if (_craftCostsByItem.TryGetValue(
                                item.DofusDbId,
                                out CraftCostResult? craftCost))
                            {
                                <CraftCostSummary Result="craftCost" />
                            }

                            @if (_missingDataByItem.TryGetValue(
                                item.DofusDbId,
                                out HashSet<string>? missingData))
                            {
                                <ul class="small text-secondary mb-0 mt-2">

                                    @foreach (string message in missingData)
                                    {
                                        <li>@message</li>
                                    }

                                </ul>
                            }
                            else
                            {
                                <div class="small text-secondary mt-2">
                                    Calcul indisponible pour une raison inconnue.
                                </div>
                            }
                            <div class="d-flex justify-content-end mt-2">
                                <div class="btn-group btn-group-sm">

                                    <button class="btn btn-light"
                                            @onclick="async () => await Refresh(item)">
                                        Rafraîchir
                                    </button>

                                    <button class="btn btn-light"
                                            title="Mettre cet équipement en focus dans l'overlay"
                                            aria-label="Mettre cet équipement en focus dans l'overlay"
                                            @onclick="async () => await FocusInOverlay(item)">
                                        ◎
                                    </button>

                                </div>
                            </div>

                        </div>
                    }

                </div>

            </div>
        }
    }
</div>

@code {
    private string?
        _overlayLayoutResetMessage;

    private void RestoreOverlayLayouts()
    {
        OverlayService
            .RestoreOverlayLayoutsToDefaults();

        _overlayLayoutResetMessage =
            "Positions et tailles des overlays restaurées.";
    }


    private static readonly Dictionary<string, ServerPageState>
        _sessionStates =
            new(StringComparer.OrdinalIgnoreCase);

    private ServerPageState? _sessionState;

    private string? _loadedServerName;

    private bool _searching;
    private bool _showSettings;
    private void OpenSettings()
    {
        _showSettings = true;
    }
    private void CloseSettings()
    {
        _showSettings = false;
    }
    Equipment[]? _allItems;
    List<ItemCrushResult>? _rankedItems;
    List<Equipment>? _unrankedItems;
    Dictionary<long, HashSet<string>> _missingDataByItem = new();
    IReadOnlyDictionary<(long DofusDbId, int Quantity), MarketPriceObservation> _runePrices =
    new Dictionary<(long DofusDbId, int Quantity), MarketPriceObservation>();
    IReadOnlyDictionary<(long DofusDbId, int Quantity), MarketPriceObservation> _equipmentPrices =
    new Dictionary<(long DofusDbId, int Quantity), MarketPriceObservation>();
    IReadOnlyDictionary<
        (long DofusDbId, int Quantity),
        MarketPriceObservation> _resourcePrices =
            new Dictionary<
                (long DofusDbId, int Quantity),
                MarketPriceObservation>();

    Dictionary<long, CraftCostResult>
        _craftCostsByItem = new();
    Dictionary<long, CoefficientObservation> _coefficients = new();
    SortOrder _sortOrder;

    [Parameter]
    public required string ServerName { get; set; }

    [SupplyParameterFromForm]
    private SearchItemsModel? Model { get; set; }

    protected override void OnParametersSet()
    {
        CurrentServerState.SelectServer(
            ServerName
        );

        if (string.Equals(
            _loadedServerName,
            ServerName,
            StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        bool firstLoad =
            _loadedServerName is null;

        SaveSessionState();

        _loadedServerName =
            ServerName;

        LoadSessionState(
            useSuppliedModel: firstLoad
        );
    }

    async Task FocusInOverlay(
        Equipment equipment)
    {
        CurrentServerState.SelectServer(
            ServerName
        );

        await OverlayService
            .FocusEquipmentAsync(
                equipment
            );

        // Action explicite de l'utilisateur :
        // le bouton Focus copie aussi le nom exact afin
        // de pouvoir le rechercher immédiatement dans Dofus.
        await Microsoft.Maui.ApplicationModel.DataTransfer
            .Clipboard
            .Default
            .SetTextAsync(
                equipment.Name
            );
    }

    private void LoadSessionState(
        bool useSuppliedModel)
    {
        if (!_sessionStates.TryGetValue(
            ServerName,
            out ServerPageState? state))
        {
            state =
                new ServerPageState();

            _sessionStates[ServerName] =
                state;
        }

        _sessionState = state;

        if (useSuppliedModel &&
            Model is not null)
        {
            state.Model = Model;
        }
        else
        {
            Model = state.Model;
        }

        _allItems =
            state.AllItems;

        _rankedItems =
            state.RankedItems;

        _unrankedItems =
            state.UnrankedItems;

        _missingDataByItem =
            state.MissingDataByItem;

        _runePrices =
            state.RunePrices;

        _equipmentPrices =
            state.EquipmentPrices;

        _resourcePrices =
            state.ResourcePrices;

        _craftCostsByItem =
            state.CraftCostsByItem;

        _coefficients =
            state.Coefficients;

        _sortOrder =
            state.SortOrder;
    }

    private void SaveSessionState()
    {
        if (_sessionState is null)
        {
            return;
        }

        if (Model is not null)
        {
            _sessionState.Model =
                Model;
        }

        _sessionState.AllItems =
            _allItems;

        _sessionState.RankedItems =
            _rankedItems;

        _sessionState.UnrankedItems =
            _unrankedItems;

        _sessionState.MissingDataByItem =
            _missingDataByItem;

        _sessionState.RunePrices =
            _runePrices;

        _sessionState.EquipmentPrices =
            _equipmentPrices;

        _sessionState.ResourcePrices =
            _resourcePrices;

        _sessionState.CraftCostsByItem =
            _craftCostsByItem;

        _sessionState.Coefficients =
            _coefficients;

        _sessionState.SortOrder =
            _sortOrder;
    }

    public void Dispose()
    {
        SaveSessionState();
    }

    private void OnDataPriorityChanged(
        ChangeEventArgs args)
    {
        if (Enum.TryParse(
            args.Value?.ToString(),
            out DataPriority priority))
        {
            DataPriorityProvider.Priority =
                priority;
        }
    }

    private async Task OnCrushYieldEstimationModeChanged(
        ChangeEventArgs args)
    {
        if (!Enum.TryParse(
            args.Value?.ToString(),
            out CrushYieldEstimationMode mode))
        {
            return;
        }

        if (BestCrushSettings.CrushYieldEstimationMode ==
            mode)
        {
            return;
        }

        BestCrushSettings.CrushYieldEstimationMode =
            mode;

        await OverlayService
            .RefreshFocusedProfitabilityAsync();

        if (_allItems is not null &&
            (_rankedItems is not null ||
             _unrankedItems is not null))
        {
            await Search(
                forceRefresh: false
            );
        }
    }

    async Task Count()
    {
        if (_searching)
        {
            return;
        }

        _rankedItems = null;
        _unrankedItems = null;

        StateHasChanged();

        IReadOnlyCollection<Equipment> allItems = await ItemsService.GetEquipmentsAsync();
        Equipment[] items = FilterItems(allItems).ToArray();
        _allItems = items;
    }

    async Task Search(
        bool forceRefresh)
    {
        if (_searching)
        {
            return;
        }

        _rankedItems = null;
        _unrankedItems = null;
        _searching = true;
        _missingDataByItem.Clear();

        await InvokeAsync(
            StateHasChanged
        );

        try
        {
            Task<IReadOnlyCollection<Equipment>> itemsTask =
                ItemsService.GetEquipmentsAsync();

            Task<IReadOnlyDictionary<Characteristic, Rune>>
                runesByCharacteristicAsync =
                    RunesService.GetRunesByCharacteristicAsync();

            await Task.WhenAll(
                itemsTask,
                runesByCharacteristicAsync
            );

            Equipment[] items =
                FilterItems(
                    await itemsTask
                )
                .ToArray();

            _allItems = items;

            await InvokeAsync(
                StateHasChanged
            );

            _rankedItems = [];
            _unrankedItems = [];

            EquipmentProfitabilityContext profitabilityContext =
                await EquipmentProfitabilityService
                    .LoadContextAsync(
                        ServerName
                    );

            _runePrices =
                profitabilityContext.RunePrices;

            _equipmentPrices =
                profitabilityContext.EquipmentPrices;

            _resourcePrices =
                profitabilityContext.ResourcePrices;

            _coefficients =
                profitabilityContext.Coefficients;

            _craftCostsByItem.Clear();

            foreach (Equipment item in items)
            {
                try
                {
                    EquipmentProfitabilityResult profitability =
                        await EquipmentProfitabilityService
                            .CalculateAsync(
                                item,
                                ServerName,
                                profitabilityContext,
                                forceRefresh
                            );

                    _craftCostsByItem[item.DofusDbId] =
                        profitability.CraftCost;

                    foreach (string missingData
                        in profitability.MissingData)
                    {
                        AddMissingData(
                            item,
                            missingData
                        );
                    }

                    List<ItemCrushResult> result =
                        profitability.Scenarios
                            .Select(ToItemCrushResult)
                            .ToList();

                    if (result.Count == 0)
                    {
                        _unrankedItems.Add(item);
                    }
                    else
                    {
                        _rankedItems.AddRange(result);
                    }

                    await InvokeAsync(
                        StateHasChanged
                    );
                }
                catch (Exception exn)
                {
                    _unrankedItems.Add(item);

                    AddMissingData(
                        item,
                        "Erreur lors de la récupération des données de brisage"
                    );

                    Logger.LogError(
                        exn,
                        "Error while processing item {ItemName} ({ItemId})",
                        item.Name,
                        item.DofusDbId
                    );

                    await InvokeAsync(
                        StateHasChanged
                    );
                }
            }
        }
        catch (Exception exn)
        {
            Logger.LogError(
                exn,
                "An error occured while searching for best crush."
            );
        }
        finally
        {
            _searching = false;

            await InvokeAsync(
                StateHasChanged
            );
        }
    }

    async Task Refresh(
        Equipment equipment)
    {
        if (_searching ||
            _unrankedItems is null ||
            _rankedItems is null)
        {
            return;
        }

        _searching = true;

        await InvokeAsync(
            StateHasChanged
        );

        try
        {
            EquipmentProfitabilityContext
                profitabilityContext =
                    await EquipmentProfitabilityService
                        .LoadContextAsync(
                            ServerName
                        );

            _runePrices =
                profitabilityContext.RunePrices;

            _equipmentPrices =
                profitabilityContext.EquipmentPrices;

            _resourcePrices =
                profitabilityContext.ResourcePrices;

            _coefficients =
                profitabilityContext.Coefficients;

            _missingDataByItem.Remove(
                equipment.DofusDbId
            );

            EquipmentProfitabilityResult
                profitability =
                    await EquipmentProfitabilityService
                        .CalculateAsync(
                            equipment,
                            ServerName,
                            profitabilityContext,
                            true
                        );

            _craftCostsByItem[
                equipment.DofusDbId
            ] =
                profitability.CraftCost;

            foreach (string missingData
                    in profitability.MissingData)
            {
                AddMissingData(
                    equipment,
                    missingData
                );
            }

            _unrankedItems.RemoveAll(
                item =>
                    item.DofusDbId ==
                    equipment.DofusDbId
            );

            _rankedItems.RemoveAll(
                result =>
                    result.Equipment.DofusDbId ==
                    equipment.DofusDbId
            );

            List<ItemCrushResult> result =
                profitability.Scenarios
                    .Select(
                        ToItemCrushResult
                    )
                    .ToList();

            if (result.Count == 0)
            {
                _unrankedItems.Add(
                    equipment
                );
            }
            else
            {
                _rankedItems.AddRange(
                    result
                );
            }

            SaveSessionState();
        }
        catch (Exception exn)
        {
            Logger.LogError(
                exn,
                "Error while refreshing item {ItemName} ({ItemId})",
                equipment.Name,
                equipment.DofusDbId
            );
        }
        finally
        {
            _searching = false;

            await InvokeAsync(
                StateHasChanged
            );
        }
    }

    void AddMissingData(Equipment equipment, string message)
    {
        if (!_missingDataByItem.TryGetValue(
            equipment.DofusDbId,
            out HashSet<string>? messages))
        {
            messages = [];
            _missingDataByItem[equipment.DofusDbId] = messages;
        }

        messages.Add(message);
    }

    bool IsPartial(ItemCrushResult item)
    {
        return _missingDataByItem.TryGetValue(
            item.Equipment.DofusDbId,
            out HashSet<string>? warnings)
            && warnings.Count > 0;
    }

    async Task<IReadOnlyCollection<ItemCrushResult>> ComputeBenefit(
        Equipment equipment,
        IReadOnlyDictionary<(long DofusDbId, int Quantity), MarketPriceObservation> runePrices,
        IReadOnlyDictionary<(long DofusDbId, int Quantity), MarketPriceObservation> equipmentPrices,
        bool forceRefresh)
    {
        CoefficientObservation? itemCoefficient;

        if (!_coefficients.TryGetValue(
            equipment.DofusDbId,
            out itemCoefficient))
        {
            DofocusItem detailedItem;

            try
            {
                detailedItem =
                    await ItemsService.GetItemAsync(
                        equipment.DofusDbId,
                        forceRefresh
                    );
            }
            catch
            {
                AddMissingData(
                    equipment,
                    "Coefficient de brisage indisponible"
                );

                return [];
            }

            DofocusCoefficientRecord? dofocusCoefficient =
                detailedItem.Coefficients
                    .Where(c => c.ServerName == ServerName)
                    .OrderByDescending(c => c.LastUpdate)
                    .FirstOrDefault();

            if (dofocusCoefficient is null)
            {
                AddMissingData(
                    equipment,
                    "Coefficient de brisage indisponible"
                );

                return [];
            }

            itemCoefficient =
                await CoefficientService.AddObservationAsync(
                    equipment.DofusDbId,
                    ServerName,
                    dofocusCoefficient.Coefficient,
                    CoefficientSource.DofocusInitial
                );

            _coefficients[equipment.DofusDbId] =
                itemCoefficient;
        }

        double coefficient =
            itemCoefficient.CoefficientPercent / 100;

        equipmentPrices.TryGetValue(
            (equipment.DofusDbId, 1),
            out MarketPriceObservation? itemCost
        );

        if (itemCost is null)
        {
            AddMissingData(
                equipment,
                "Prix local de l'équipement manquant"
            );
        }

        CraftCostResult craftCost =
            _craftCostsByItem.TryGetValue(
                equipment.DofusDbId,
                out CraftCostResult? knownCraftCost)
                ? knownCraftCost
                : CraftCostService.Calculate(
                    equipment,
                    _resourcePrices
                );

        if (!craftCost.IsComplete)
        {
            AddMissingData(
                equipment,
                $"Craft incomplet : {craftCost.MissingResourceCount} prix de ressource manquant(s)"
            );
        }

        if (itemCost is null &&
            craftCost.TotalCost is null)
        {
            return [];
        }

        List<ItemCrushResult> result = [];
        Dictionary<Characteristic, double> averageLines = equipment.Characteristics.ToDictionary(c => c.Characteristic, c => (double)(c.From + c.To) / 2);
        IReadOnlyDictionary<Rune, double> runesWithoutFocus = CrushService.GetCrushResult(averageLines, equipment.Level, coefficient);
        
        IReadOnlyDictionary<Rune, MarketValueResult>? valuesWithoutFocus =
        CalculateRuneValues(
            equipment,
            runesWithoutFocus,
            runePrices
        );
        if (valuesWithoutFocus is not null)
        {
            double priceWithoutFocus =
                valuesWithoutFocus.Values.Sum(value =>
                    value.Value);

            double? purchaseBenefitWithoutFocus =
                itemCost is null
                    ? null
                    : priceWithoutFocus - itemCost.Price;

            double? purchaseYieldWithoutFocus =
                itemCost is null
                    ? null
                    : itemCost.Price == 0
                        ? 0
                        : purchaseBenefitWithoutFocus /
                        itemCost.Price;

            double? craftBenefitWithoutFocus =
                craftCost.TotalCost is long craftPrice
                    ? priceWithoutFocus - craftPrice
                    : null;

            double? craftYieldWithoutFocus =
                craftCost.TotalCost is long craftCostValue
                    ? craftCostValue == 0
                        ? 0
                        : craftBenefitWithoutFocus /
                        craftCostValue
                    : null;

            result.Add(
                new ItemCrushResult(
                    equipment,
                    itemCoefficient,
                    itemCost,
                    craftCost,
                    purchaseBenefitWithoutFocus,
                    purchaseYieldWithoutFocus,
                    craftBenefitWithoutFocus,
                    craftYieldWithoutFocus,
                    null,
                    runesWithoutFocus,
                    valuesWithoutFocus
                )
            );
        }
        
        foreach ((Characteristic characteristic, double value) in averageLines)
        {
            if (value <= 0)
            {
                continue;
            }

            IReadOnlyDictionary<Rune, double> runesWithFocus = CrushService.GetFocusedCrushResult(averageLines, characteristic, equipment.Level, coefficient);
            
            
            IReadOnlyDictionary<Rune, MarketValueResult>? valuesWithFocus =
                CalculateRuneValues(
                    equipment,
                    runesWithFocus,
                    runePrices
                );

            if (valuesWithFocus is null)
            {
                continue;
            }

            double priceWithFocus =
                valuesWithFocus.Values.Sum(value =>
                    value.Value);

            double? purchaseBenefitWithFocus =
                itemCost is null
                    ? null
                    : priceWithFocus - itemCost.Price;

            double? purchaseYieldWithFocus =
                itemCost is null
                    ? null
                    : itemCost.Price == 0
                        ? 0
                        : purchaseBenefitWithFocus /
                        itemCost.Price;

            double? craftBenefitWithFocus =
                craftCost.TotalCost is long craftPrice
                    ? priceWithFocus - craftPrice
                    : null;

            double? craftYieldWithFocus =
                craftCost.TotalCost is long craftCostValue
                    ? craftCostValue == 0
                        ? 0
                        : craftBenefitWithFocus /
                        craftCostValue
                    : null;

            result.Add(
                new ItemCrushResult(
                    equipment,
                    itemCoefficient,
                    itemCost,
                    craftCost,
                    purchaseBenefitWithFocus,
                    purchaseYieldWithFocus,
                    craftBenefitWithFocus,
                    craftYieldWithFocus,
                    characteristic,
                    runesWithFocus,
                    valuesWithFocus
                )
            );
        }

        return result;
    }

    IReadOnlyDictionary<Rune, MarketValueResult>? CalculateRuneValues(
        Equipment equipment,
        IReadOnlyDictionary<Rune, double> runes,
        IReadOnlyDictionary<(long DofusDbId, int Quantity), MarketPriceObservation> prices)
    {
        Dictionary<Rune, MarketValueResult> result = [];

        bool hasMissingPrice = false;

        foreach ((Rune rune, double quantity) in runes)
        {
            if (quantity <= 0)
            {
                continue;
            }

            MarketValueResult? value =
                MarketPriceService.CalculateValue(
                    rune.DofusDbId,
                    quantity,
                    prices
                );

            if (value is null)
            {
                AddMissingData(
                    equipment,
                    $"Prix de rune manquant : {rune.Name}"
                );

                hasMissingPrice = true;
                continue;
            }

            result[rune] = value.Value;
        }

        return hasMissingPrice
            ? null
            : result;
    }

    IEnumerable<Equipment> FilterItems(IReadOnlyCollection<Equipment> items)
    {
        IEnumerable<Equipment> result = items;

        if (Model?.LevelMin is not null)
        {
            result = result.Where(i => i.Level >= Model.LevelMin);
        }

        if (Model?.LevelMax is not null)
        {
            result = result.Where(i => i.Level <= Model.LevelMax);
        }

        HashSet<EquipmentType> equipmentTypes = ComputeEquipmentTypes();
        if (equipmentTypes.Count > 0)
        {
            result = result.Where(i => equipmentTypes.Contains(i.Type));
        }

        return result;
    }

