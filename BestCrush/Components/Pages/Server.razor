@inject ItemsService ItemsService
@inject RunesService RunesService
@inject BestCrush.Services.BestCrushSettingsService BestCrushSettings
@inject ILogger<Server> Logger
@inject BestCrush.Services.OverlayService OverlayService
@inject BestCrush.Services.CurrentServerState CurrentServerState
@inject IDataPriorityProvider DataPriorityProvider
@inject EquipmentProfitabilityService EquipmentProfitabilityService

@implements IDisposable

@page "/servers/{ServerName}"
@using BestCrush.Components.Pure
@using BestCrush.Domain.Models
@using BestCrush.Domain.Services
@using BestCrush.Models
@using DofusSharp.Dofocus.ApiClients.Models.Items
@using Microsoft.Extensions.Logging
@using System.Text.Json


<div class="container">
    <div class="d-flex justify-content-end gap-2 mb-3">
        
        <a class="btn btn-outline-secondary"
        href="@($"/servers/{ServerName}/equipment-prices")">
            Prix locaux des équipements
        </a>

        <a class="btn btn-outline-secondary"
        href="@($"/servers/{ServerName}/rune-prices")">
            Prix locaux des runes
        </a>
        <a class="btn btn-outline-secondary"
        href="@($"/servers/{ServerName}/resource-prices")">
            Prix locaux des ressources
        </a>
        <a class="btn btn-outline-secondary"
        href="@($"/servers/{ServerName}/coefficients")">
            Coefficients
        </a>
        <a class="btn btn-outline-secondary"
           href="@BestCrush.Components.KnownRoutes.History(ServerName)">
            Historique
        </a>
        <button type="button"
                class="btn btn-outline-info"
                @onclick="OverlayService.Toggle">
            Overlay
        </button>
        <button class="btn btn-outline-secondary"
                title="Paramètres"
                aria-label="Paramètres"
                @onclick="OpenSettings">
            ⚙
        </button>

        @if (_showSettings)
        {
            <div style="
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.45);
                z-index: 2000;
                display: flex;
                align-items: center;
                justify-content: center;"
                @onclick="CloseSettings">

                <div class="card shadow"
                    style="
                        width: 540px;
                        max-width: calc(100vw - 40px);
                        padding: 20px;
                        max-height: calc(100vh - 40px);
                        overflow-y: auto;"
                    @onclick:stopPropagation="true">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="m-0">
                            Paramètres
                        </h4>

                        <button type="button"
                                class="btn-close"
                                @onclick="CloseSettings">
                        </button>
                    </div>

                    <div class="border rounded p-3 mb-3">
                        <h6 class="mb-3">Marché &amp; capture</h6>

                        <label class="form-label fw-bold">
                            Données capturées automatiquement
                        </label>

                        <div class="text-muted small mb-3">
                            Choisis quelles données BestCrush est autorisé
                            à enregistrer automatiquement depuis Dofus.
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="capture-equipment"
                                   @bind="BestCrushSettings.EquipmentCaptureEnabled" />
                            <label class="form-check-label" for="capture-equipment">
                                Prix des équipements
                            </label>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="capture-runes"
                                   @bind="BestCrushSettings.RuneCaptureEnabled" />
                            <label class="form-check-label" for="capture-runes">
                                Prix des runes
                            </label>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="capture-resources"
                                   @bind="BestCrushSettings.ResourceCaptureEnabled" />
                            <label class="form-check-label" for="capture-resources">
                                Prix des ressources
                            </label>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="capture-coefficients"
                                   @bind="BestCrushSettings.CoefficientCaptureEnabled" />
                            <label class="form-check-label" for="capture-coefficients">
                                Coefficients de brisage
                            </label>
                        </div>

                        <label class="form-label fw-bold">
                            Priorité des données
                        </label>

                        <div class="text-muted small mb-2">
                            Détermine quelle source est utilisée lorsqu'une
                            valeur manuelle et une capture jeu sont disponibles.
                        </div>

                        <select class="form-select"
                                value="@DataPriorityProvider.Priority"
                                @onchange="OnDataPriorityChanged">
                            <option value="@DataPriority.Manual">Manuel</option>
                            <option value="@DataPriority.InGameAutomatic">Capture jeu</option>
                        </select>
                    </div>

                    <div class="border rounded p-3 mb-3">
                        <h6 class="mb-3">Concassage &amp; rentabilité</h6>

                        <label class="form-label fw-bold"
                               for="crush-yield-estimation-mode">
                            Estimation du jet de concassage
                        </label>

                        <div class="text-muted small mb-2">
                            Détermine le jet utilisé pour estimer le nombre
                            de runes obtenu lors du concassage.
                        </div>

                        <select id="crush-yield-estimation-mode"
                                class="form-select"
                                value="@BestCrushSettings.CrushYieldEstimationMode"
                                @onchange="OnCrushYieldEstimationModeChanged">
                            <option value="@CrushYieldEstimationMode.Conservative">
                                Jet prudent de concassage
                            </option>
                            <option value="@CrushYieldEstimationMode.Average">
                                Jet moyen de concassage
                            </option>
                        </select>

                        <div class="text-muted small mt-2 mb-4">
                            Prudent : utilise le jet minimum de chaque caractéristique.
                            Moyen : utilise la moyenne entre le minimum et le maximum.
                        </div>

                        <label class="form-label fw-bold"
                               for="crush-value-discount">
                            Décote de valorisation du concassage
                        </label>

                        <div class="text-muted small mb-2">
                            Réduit la valeur théorique des runes pour estimer
                            plus prudemment la valeur réellement récupérable.
                            Cette décote est aussi utilisée pour les bénéfices et rendements.
                        </div>

                        <div class="input-group mb-4">
                            <input id="crush-value-discount"
                                   type="number"
                                   class="form-control"
                                   min="0"
                                   max="100"
                                   step="0.5"
                                   @bind="BestCrushSettings.CrushValueDiscountPercent" />
                            <span class="input-group-text">%</span>
                        </div>

                        <label class="form-label fw-bold"
                               for="target-roi">
                            Objectif de rentabilité
                        </label>

                        <div class="text-muted small mb-2">
                            Rendement minimum souhaité pour déterminer
                            le prix maximal d'achat d'un équipement.
                        </div>

                        <div class="input-group">
                            <input id="target-roi"
                                   type="number"
                                   class="form-control"
                                   min="0"
                                   max="1000"
                                   step="1"
                                   @bind="BestCrushSettings.TargetRoiPercent" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>

                    <div class="border rounded p-3 mb-3">
                        <h6 class="mb-3">Interface &amp; overlays</h6>

                        <div class="text-muted small mb-3">
                            Les positions et tailles sont conservées automatiquement
                            entre les lancements et les mises à jour.
                        </div>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="RestoreOverlayLayouts">
                            Restaurer la position par défaut des overlays
                        </button>

                        @if (!string.IsNullOrWhiteSpace(
                            _overlayLayoutResetMessage))
                        {
                            <div class="text-success small mt-2">
                                @_overlayLayoutResetMessage
                            </div>
                        }
                    </div>

                    <div class="border rounded p-3">
                        <h6 class="mb-3">Développement</h6>

                        <div class="text-muted small mb-3">
                            Permet de conserver temporairement les captures
                            et les crops OCR pour analyser les détections.
                        </div>

                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="devtool-remove-screenshots"
                                   @bind="BestCrushSettings.DevTool_RemoveScreenshotsByDefault" />
                            <label class="form-check-label"
                                   for="devtool-remove-screenshots">
                                DevTool_RemoveScreenshotsByDefault
                            </label>
                        </div>

                        <div class="text-muted small mt-2">
                            Activé : les captures sont supprimées après traitement.
                            Désactivé : les captures et crops de debug sont conservés.
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>

    <div class="card border-0 bg-light mb-3">
        <div class="card-body py-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <label class="small fw-semibold text-nowrap" for="saved-filter-select">
                    Filtres enregistrés
                </label>

                <select id="saved-filter-select"
                        class="form-select form-select-sm"
                        style="width:auto; min-width:220px"
                        value="@(_selectedPresetId?.ToString() ?? string.Empty)"
                        @onchange="ApplyPresetAsync"
                        disabled="@_searching">
                    <option value="">— Aucun —</option>
                    @foreach (SearchFilterPreset preset in _filterPresets.OrderBy(p => p.Name))
                    {
                        <option value="@preset.Id">
                            @PresetDisplayName(preset)
                        </option>
                    }
                </select>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        @onclick="BeginNewPreset"
                        disabled="@_searching">
                    Nouveau
                </button>

                <button type="button"
                        class="btn btn-outline-primary btn-sm"
                        @onclick="SaveCurrentPreset"
                        disabled="@_searching">
                    Enregistrer
                </button>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        @onclick="BeginRenamePreset"
                        disabled="@(_searching || _selectedPresetId is null)">
                    Renommer
                </button>

                @if (_confirmDeletePreset)
                {
                    <button type="button"
                            class="btn btn-danger btn-sm"
                            @onclick="DeleteSelectedPreset"
                            disabled="@_searching">
                        Confirmer la suppression
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            @onclick="() => _confirmDeletePreset = false">
                        Annuler
                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            @onclick="() => _confirmDeletePreset = true"
                            disabled="@(_searching || _selectedPresetId is null)">
                        Supprimer
                    </button>
                }

                <button type="button"
                        class="btn btn-outline-success btn-sm ms-auto"
                        title="Données complètes et fraîches, coefficient connu"
                        @onclick="ApplyOpportunitiesAsync"
                        disabled="@_searching">
                    Opportunités
                </button>
            </div>

            @if (_presetEditorMode is not null)
            {
                <div class="d-flex align-items-center gap-2 mt-2">
                    <input class="form-control form-control-sm"
                           style="max-width:320px"
                           placeholder="Nom du filtre"
                           @bind="_presetNameDraft" />
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            @onclick="ConfirmPresetEditor">
                        Valider
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            @onclick="CancelPresetEditor">
                        Annuler
                    </button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_presetMessage))
            {
                <div class="small @PresetMessageCssClass() mt-2">@_presetMessage</div>
            }
        </div>
    </div>

    <form method="post" @onsubmit="Count" @formname="search-form">
        <SearchItemsForm Model="Model"
                         AvailableRunes="_availableRunes"
                         Disabled="_searching" />
        <div class="d-flex justify-content-center my-4">
            <button class="btn btn-primary" type="submit" disabled="@_searching">Rechercher les objets</button>
        </div>
    </form>

    @if (_allItems is not null && _rankedItems is null)
    {
        <div class="text-center">
            @_allItems.Length objet(s) correspondent aux critères structurels.
            @if (HasEconomicFilters())
            {
                <span class="text-secondary">Les filtres économiques seront appliqués pendant le calcul.</span>
            }
        </div>

        <div class="d-flex justify-content-center my-4">
            <button class="btn btn-primary" @onclick="() => Search(false)" disabled="@_searching">Trouver le <span class="fw-semibold">Best Crush</span></button>
        </div>

    }

    @if (_allItems is not null && _searching)
    {
        int done = _processedItems;
        double ratio = _allItems.Length == 0
            ? 1
            : (double)done / _allItems.Length;
        int percent = (int)(ratio * 100);

        {
            <div class="progress mb-4" role="progressbar" aria-label="Basic example" aria-valuenow="@done" aria-valuemin="0" aria-valuemax="@_allItems.Length">
                <div class="progress-bar progress-bar-striped progress-bar-animated text-bg-warning" style="width: @percent%">@done / @_allItems.Length</div>
            </div>
        }
    }

    @if (_unrankedItems is not null && _rankedItems is not null)
    {
        @if (_rankedItems.Count > 0)
        {
            IEnumerable<IGrouping<Equipment, ItemCrushResult>> equipments =
                _rankedItems.GroupBy(i => i.Equipment);

            IEnumerable<ItemCrushResult> bestLines =
                equipments.Select(
                    SelectBestScenarioForCurrentSort
                );

            IEnumerable<ItemCrushResult> bestLinesOrdered =
                OrderResults(
                    bestLines
                );

            <div class="my-4">
                <div class="d-flex align-items-center justify-content-end gap-2 mb-2 px-3">
                    <div class="d-flex gap-2">
                        <label for="sort-order" class="col-form-label col-form-label-sm text-nowrap">Tri par</label>
                        <InputSelect TValue="SortOrder" @bind-Value="_sortOrder" class="form-select form-select-sm" id="sort-order">
                            <option value="@SortOrder.BestBenefit">Bénéfice — meilleur mode</option>
                            <option value="@SortOrder.BestYield">ROI — meilleur mode</option>
                            <option value="@SortOrder.PurchaseBenefit">Bénéfice achat</option>
                            <option value="@SortOrder.PurchaseYield">ROI achat</option>
                            <option value="@SortOrder.CraftBenefit">Bénéfice craft</option>
                            <option value="@SortOrder.CraftYield">ROI craft</option>
                            <option value="@SortOrder.HighestTargetMargin">Marge avant seuil</option>
                            <option value="@SortOrder.HighestRuneValue">Valeur runes ajustée</option>
                            <option value="@SortOrder.NameAscending">Nom (A → Z)</option>
                            <option value="@SortOrder.HighestCoefficient">Coefficient (décroissant)</option>
                            <option value="@SortOrder.LevelAscending">Niveau (croissant)</option>
                            <option value="@SortOrder.LevelDescending">Niveau (décroissant)</option>
                        </InputSelect>
                    </div>
                    <div>
                        <button class="btn btn-light border" @onclick="() => Search(true)">Tout rafraîchir</button>
                    </div>
                </div>
                <ul class="list-group list-group-flush rounded">
                    @{
                        ItemCrushResult[] completeLines =
                            bestLinesOrdered
                                .Where(item => !IsPartial(item))
                                .ToArray();

                        ItemCrushResult[] partialLines =
                            bestLinesOrdered
                                .Where(IsPartial)
                                .ToArray();
                    }
                    @if (completeLines.Length > 0)
                    {
                        <h5 class="mt-4 mb-3">
                            Résultats complets
                            <span class="badge text-bg-success">
                                @completeLines.Length
                            </span>
                        </h5>

                        @foreach (ItemCrushResult item in completeLines)
                        {
                            <li class="list-group-item">
                                <CrushResultLine Equipment="item.Equipment"
                                                Cost="item.Cost"
                                                CraftCost="item.CraftCost"
                                                Coefficient="item.Coefficient"
                                                FocusedCharacteristic="item.FocusedCharacteristic"
                                                Runes="item.Runes"
                                                RuneValues="item.RuneValues"
                                                AdjustedRuneValue="item.AdjustedRuneValue"
                                                CalculatedPurchaseBenefit="item.PurchaseBenefit"
                                                CalculatedPurchaseYield="item.PurchaseYield"
                                                CalculatedCraftBenefit="item.CraftBenefit"
                                                CalculatedCraftYield="item.CraftYield"
                                                TargetRoiPercent="item.TargetRoiPercent"
                                                PurchaseState="item.PurchaseState"
                                                CraftState="item.CraftState"
                                                SortOrder="_sortOrder"
                                                NoImage="_searching"
                                                Refresh="() => Refresh(item.Equipment)"
                                                Focus="() => FocusInOverlay(item.Equipment)" />
                                <CraftCostSummary Result="item.CraftCost" />
                            </li>
                        }
                    }
                    @if (partialLines.Length > 0)
                    {
                        <h5 class="mt-5 mb-1">
                            Résultats partiels
                            <span class="badge text-bg-warning">
                                @partialLines.Length
                            </span>
                        </h5>

                        <p class="text-secondary small">
                            Hors classement : le meilleur scénario réel peut être différent tant que certains prix sont manquants.
                        </p>

                        @foreach (ItemCrushResult item in partialLines)
                        {
                            <li class="list-group-item">

                                <CrushResultLine Equipment="item.Equipment"
                                                Cost="item.Cost"
                                                CraftCost="item.CraftCost"
                                                Coefficient="item.Coefficient"
                                                FocusedCharacteristic="item.FocusedCharacteristic"
                                                Runes="item.Runes"
                                                RuneValues="item.RuneValues"
                                                AdjustedRuneValue="item.AdjustedRuneValue"
                                                CalculatedPurchaseBenefit="item.PurchaseBenefit"
                                                CalculatedPurchaseYield="item.PurchaseYield"
                                                CalculatedCraftBenefit="item.CraftBenefit"
                                                CalculatedCraftYield="item.CraftYield"
                                                TargetRoiPercent="item.TargetRoiPercent"
                                                PurchaseState="item.PurchaseState"
                                                CraftState="item.CraftState"
                                                SortOrder="_sortOrder"
                                                NoImage="_searching"
                                                Refresh="() => Refresh(item.Equipment)"
                                                Focus="() => FocusInOverlay(item.Equipment)" />
                                
                                <CraftCostSummary Result="item.CraftCost" />

                                @if (_missingDataByItem.TryGetValue(
                                    item.Equipment.DofusDbId,
                                    out HashSet<string>? warnings))
                                {
                                    <div class="alert alert-warning py-2 px-3 mt-2 mb-0 small">

                                        <strong>
                                            ⚠ Résultat partiel — meilleur scénario connu
                                        </strong>

                                        <div class="mt-1">
                                            Certaines possibilités de brisage ne peuvent pas encore être valorisées :
                                        </div>

                                        <ul class="mb-0 mt-1">
                                            @foreach (string warning in warnings)
                                            {
                                                <li>@warning</li>
                                            }
                                        </ul>

                                    </div>
                                }

                            </li>
                        }
                    }
                </ul>
            </div>
        }

        @if (_unrankedItems is { Count: > 0 } unrankedItems && !HasEconomicFilters())
        {
            IEnumerable<Equipment> unrankedItemsOrdered =
                _sortOrder switch
                {
                    SortOrder.NameAscending =>
                        unrankedItems.OrderBy(
                            item => item.Name,
                            StringComparer.CurrentCultureIgnoreCase
                        ),

                    SortOrder.HighestCoefficient =>
                        unrankedItems
                            .OrderByDescending(
                                item =>
                                    _coefficients.TryGetValue(
                                        item.DofusDbId,
                                        out CoefficientObservation? coefficient
                                    )
                                        ? coefficient.CoefficientPercent
                                        : double.MinValue
                            )
                            .ThenBy(
                                item => item.Name,
                                StringComparer.CurrentCultureIgnoreCase
                            ),

                    SortOrder.LevelAscending =>
                        unrankedItems
                            .OrderBy(item => item.Level)
                            .ThenBy(
                                item => item.Name,
                                StringComparer.CurrentCultureIgnoreCase
                            ),

                    SortOrder.LevelDescending =>
                        unrankedItems
                            .OrderByDescending(item => item.Level)
                            .ThenBy(
                                item => item.Name,
                                StringComparer.CurrentCultureIgnoreCase
                            ),

                    _ =>
                        unrankedItems
                };

            <div class="my-4">

                <h5>
                    Objets avec données manquantes
                    <span class="badge text-bg-secondary">
                        @unrankedItems.Count
                    </span>
                </h5>

                <div class="list-group">

                    @foreach (Equipment item in unrankedItemsOrdered)
                    {
                        <div class="list-group-item">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <strong role="button"
                                            class="text-decoration-underline"
                                            title="Cliquer pour copier le nom"
                                            @onclick="() => CopyTextAsync(item.Name)">
                                        @item.Name
                                    </strong>
                                    <span class="text-secondary">
                                        Niv. @item.Level
                                    </span>
                                </div>

                                <span class="badge text-bg-secondary">
                                    Rentabilité indisponible
                                </span>

                            </div>

                            @if (_coefficients.TryGetValue(
                                item.DofusDbId,
                                out CoefficientObservation? coefficient))
                            {
                                <div class="small mt-1 @(coefficient.Source == CoefficientSource.DofocusInitial ? "text-primary" : "text-secondary")">
                                    Coeff.
                                    <span role="button"
                                          class="text-decoration-underline"
                                          title="Cliquer pour copier le coefficient"
                                          @onclick="() => CopyPercentAsync(coefficient.CoefficientPercent)">
                                        @coefficient.CoefficientPercent.ToString("0.##") %
                                    </span>
                                </div>
                            }

                            @if (_craftCostsByItem.TryGetValue(
                                item.DofusDbId,
                                out CraftCostResult? craftCost))
                            {
                                <CraftCostSummary Result="craftCost" />
                            }

                            @if (_missingDataByItem.TryGetValue(
                                item.DofusDbId,
                                out HashSet<string>? missingData))
                            {
                                <ul class="small text-secondary mb-0 mt-2">

                                    @foreach (string message in missingData)
                                    {
                                        <li>@message</li>
                                    }

                                </ul>
                            }
                            else
                            {
                                <div class="small text-secondary mt-2">
                                    Calcul indisponible pour une raison inconnue.
                                </div>
                            }
                            <div class="d-flex justify-content-end mt-2">
                                <div class="btn-group btn-group-sm">

                                    <button class="btn btn-light"
                                            @onclick="async () => await Refresh(item)">
                                        Rafraîchir
                                    </button>

                                    <button class="btn btn-light"
                                            title="Mettre cet équipement en focus dans l'overlay"
                                            aria-label="Mettre cet équipement en focus dans l'overlay"
                                            @onclick="async () => await FocusInOverlay(item)">
                                        ◎
                                    </button>

                                </div>
                            </div>

                        </div>
                    }

                </div>

            </div>
        }

        @if (_rankedItems.Count == 0 &&
            (HasEconomicFilters() || _unrankedItems.Count == 0))
        {
            <div class="text-center text-secondary border rounded py-4 my-4">
                Aucun équipement ne satisfait les filtres actuels.
            </div>
        }
    }
</div>

@code {
    private string?
        _overlayLayoutResetMessage;

    private void RestoreOverlayLayouts()
    {
        OverlayService
            .RestoreOverlayLayoutsToDefaults();

        _overlayLayoutResetMessage =
            "Positions et tailles des overlays restaurées.";
    }


    private static readonly Dictionary<string, ServerPageState>
        _sessionStates =
            new(StringComparer.OrdinalIgnoreCase);

    private ServerPageState? _sessionState;

    private string? _loadedServerName;

    private bool _searching;
    private int _processedItems;
    private bool _showSettings;

    private IReadOnlyList<Rune> _availableRunes =
        Array.Empty<Rune>();

    private List<SearchFilterPreset> _filterPresets = [];
    private Guid? _selectedPresetId;
    private string? _presetEditorMode;
    private string _presetNameDraft = string.Empty;
    private bool _confirmDeletePreset;
    private string? _presetMessage;
    private void OpenSettings()
    {
        _showSettings = true;
    }
    private void CloseSettings()
    {
        _showSettings = false;
    }
    Equipment[]? _allItems;
    List<ItemCrushResult>? _rankedItems;
    List<Equipment>? _unrankedItems;
    Dictionary<long, HashSet<string>> _missingDataByItem = new();
    IReadOnlyDictionary<(long DofusDbId, int Quantity), MarketPriceObservation> _runePrices =
    new Dictionary<(long DofusDbId, int Quantity), MarketPriceObservation>();
    IReadOnlyDictionary<(long DofusDbId, int Quantity), MarketPriceObservation> _equipmentPrices =
    new Dictionary<(long DofusDbId, int Quantity), MarketPriceObservation>();
    IReadOnlyDictionary<
        (long DofusDbId, int Quantity),
        MarketPriceObservation> _resourcePrices =
            new Dictionary<
                (long DofusDbId, int Quantity),
                MarketPriceObservation>();

    Dictionary<long, CraftCostResult>
        _craftCostsByItem = new();
    Dictionary<long, CoefficientObservation> _coefficients = new();
    SortOrder _sortOrder;

    [Parameter]
    public required string ServerName { get; set; }

    [SupplyParameterFromForm]
    private SearchItemsModel? Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _availableRunes =
            (await RunesService.GetRunesAsync())
                .OrderBy(
                    rune => rune.Name,
                    StringComparer.CurrentCultureIgnoreCase
                )
                .ToArray();

        _filterPresets =
            BestCrushSettings
                .GetSearchFilterPresets()
                .OrderBy(
                    preset => preset.Name,
                    StringComparer.CurrentCultureIgnoreCase
                )
                .ToList();
    }

    protected override void OnParametersSet()
    {
        CurrentServerState.SelectServer(
            ServerName
        );

        if (string.Equals(
            _loadedServerName,
            ServerName,
            StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        bool firstLoad =
            _loadedServerName is null;

        SaveSessionState();

        _loadedServerName =
            ServerName;

        LoadSessionState(
            useSuppliedModel: firstLoad
        );
    }

    private static Task CopyTextAsync(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
            value))
        {
            return Task.CompletedTask;
        }

        return Microsoft.Maui.ApplicationModel.DataTransfer
            .Clipboard
            .Default
            .SetTextAsync(
                value.Trim()
            );
    }

    private static Task CopyPercentAsync(
        double value)
    {
        return CopyTextAsync(
            value.ToString(
                "0.##",
                System.Globalization.CultureInfo.CurrentCulture
            )
        );
    }

    async Task FocusInOverlay(
        Equipment equipment)
    {
        CurrentServerState.SelectServer(
            ServerName
        );

        await OverlayService
            .FocusEquipmentAsync(
                equipment
            );

        // Action explicite de l'utilisateur :
        // le bouton Focus copie aussi le nom exact afin
        // de pouvoir le rechercher immédiatement dans Dofus.
        await Microsoft.Maui.ApplicationModel.DataTransfer
            .Clipboard
            .Default
            .SetTextAsync(
                equipment.Name
            );
    }

    private void LoadSessionState(
        bool useSuppliedModel)
    {
        if (!_sessionStates.TryGetValue(
            ServerName,
            out ServerPageState? state))
        {
            state =
                new ServerPageState();

            _sessionStates[ServerName] =
                state;
        }

        _sessionState = state;

        if (useSuppliedModel &&
            Model is not null)
        {
            state.Model = Model;
        }
        else
        {
            Model = state.Model;
        }

        _allItems =
            state.AllItems;

        _rankedItems =
            state.RankedItems;

        _unrankedItems =
            state.UnrankedItems;

        _missingDataByItem =
            state.MissingDataByItem;

        _runePrices =
            state.RunePrices;

        _equipmentPrices =
            state.EquipmentPrices;

        _resourcePrices =
            state.ResourcePrices;

        _craftCostsByItem =
            state.CraftCostsByItem;

        _coefficients =
            state.Coefficients;

        _sortOrder =
            state.SortOrder;
    }

    private void SaveSessionState()
    {
        if (_sessionState is null)
        {
            return;
        }

        if (Model is not null)
        {
            _sessionState.Model =
                Model;
        }

        _sessionState.AllItems =
            _allItems;

        _sessionState.RankedItems =
            _rankedItems;

        _sessionState.UnrankedItems =
            _unrankedItems;

        _sessionState.MissingDataByItem =
            _missingDataByItem;

        _sessionState.RunePrices =
            _runePrices;

        _sessionState.EquipmentPrices =
            _equipmentPrices;

        _sessionState.ResourcePrices =
            _resourcePrices;

        _sessionState.CraftCostsByItem =
            _craftCostsByItem;

        _sessionState.Coefficients =
            _coefficients;

        _sessionState.SortOrder =
            _sortOrder;
    }

    public void Dispose()
    {
        SaveSessionState();
    }

    private void OnDataPriorityChanged(
        ChangeEventArgs args)
    {
        if (Enum.TryParse(
            args.Value?.ToString(),
            out DataPriority priority))
        {
            DataPriorityProvider.Priority =
                priority;
        }
    }

    private async Task OnCrushYieldEstimationModeChanged(
        ChangeEventArgs args)
    {
        if (!Enum.TryParse(
            args.Value?.ToString(),
            out CrushYieldEstimationMode mode))
        {
            return;
        }

        if (BestCrushSettings.CrushYieldEstimationMode ==
            mode)
        {
            return;
        }

        BestCrushSettings.CrushYieldEstimationMode =
            mode;

        await OverlayService
            .RefreshFocusedProfitabilityAsync();

        if (_allItems is not null &&
            (_rankedItems is not null ||
             _unrankedItems is not null))
        {
            await Search(
                forceRefresh: false
            );
        }
    }

    async Task Count()
    {
        if (_searching)
        {
            return;
        }

        _rankedItems = null;
        _unrankedItems = null;
        _processedItems = 0;

        StateHasChanged();

        IReadOnlyCollection<Equipment> allItems = await ItemsService.GetEquipmentsAsync();
        Equipment[] items = FilterItems(allItems).ToArray();
        _allItems = items;
    }

    async Task Search(
        bool forceRefresh)
    {
        if (_searching)
        {
            return;
        }

        _rankedItems = null;
        _unrankedItems = null;
        _processedItems = 0;
        _searching = true;
        _missingDataByItem.Clear();

        await InvokeAsync(
            StateHasChanged
        );

        try
        {
            Task<IReadOnlyCollection<Equipment>> itemsTask =
                ItemsService.GetEquipmentsAsync();

            Task<IReadOnlyDictionary<Characteristic, Rune>>
                runesByCharacteristicAsync =
                    RunesService.GetRunesByCharacteristicAsync();

            await Task.WhenAll(
                itemsTask,
                runesByCharacteristicAsync
            );

            Equipment[] items =
                FilterItems(
                    await itemsTask
                )
                .ToArray();

            _allItems = items;

            await InvokeAsync(
                StateHasChanged
            );

            _rankedItems = [];
            _unrankedItems = [];

            EquipmentProfitabilityContext profitabilityContext =
                await EquipmentProfitabilityService
                    .LoadContextAsync(
                        ServerName
                    );

            _runePrices =
                profitabilityContext.RunePrices;

            _equipmentPrices =
                profitabilityContext.EquipmentPrices;

            _resourcePrices =
                profitabilityContext.ResourcePrices;

            _coefficients =
                profitabilityContext.Coefficients;

            _craftCostsByItem.Clear();

            foreach (Equipment item in items)
            {
                try
                {
                    EquipmentProfitabilityResult profitability =
                        await EquipmentProfitabilityService
                            .CalculateAsync(
                                item,
                                ServerName,
                                profitabilityContext,
                                forceRefresh
                            );

                    _craftCostsByItem[item.DofusDbId] =
                        profitability.CraftCost;

                    foreach (string missingData
                        in profitability.MissingData)
                    {
                        AddMissingData(
                            item,
                            missingData
                        );
                    }

                    List<ItemCrushResult> allResults =
                        profitability.Scenarios
                            .Select(ToItemCrushResult)
                            .ToList();

                    List<ItemCrushResult> result =
                        allResults
                            .Where(MatchesExactRuneFilters)
                            .Where(PassesEconomicFilters)
                            .ToList();

                    if (Model?.CompleteDataOnly == true &&
                        profitability.MissingData.Count > 0)
                    {
                        result.Clear();
                    }

                    if (allResults.Count == 0)
                    {
                        _unrankedItems.Add(item);
                    }
                    else if (result.Count > 0)
                    {
                        _rankedItems.AddRange(result);
                    }
                }
                catch (Exception exn)
                {
                    _unrankedItems.Add(item);

                    AddMissingData(
                        item,
                        "Erreur lors de la récupération des données de brisage"
                    );

                    Logger.LogError(
                        exn,
                        "Error while processing item {ItemName} ({ItemId})",
                        item.Name,
                        item.DofusDbId
                    );

                    await InvokeAsync(
                        StateHasChanged
                    );
                }

                _processedItems++;

                await InvokeAsync(
                    StateHasChanged
                );
            }
        }
        catch (Exception exn)
        {
            Logger.LogError(
                exn,
                "An error occured while searching for best crush."
            );
        }
        finally
        {
            _searching = false;

            await InvokeAsync(
                StateHasChanged
            );
        }
    }

    async Task Refresh(
        Equipment equipment)
    {
        if (_searching ||
            _unrankedItems is null ||
            _rankedItems is null)
        {
            return;
        }

        _searching = true;

        await InvokeAsync(
            StateHasChanged
        );

        try
        {
            EquipmentProfitabilityContext
                profitabilityContext =
                    await EquipmentProfitabilityService
                        .LoadContextAsync(
                            ServerName
                        );

            _runePrices =
                profitabilityContext.RunePrices;

            _equipmentPrices =
                profitabilityContext.EquipmentPrices;

            _resourcePrices =
                profitabilityContext.ResourcePrices;

            _coefficients =
                profitabilityContext.Coefficients;

            _missingDataByItem.Remove(
                equipment.DofusDbId
            );

            EquipmentProfitabilityResult
                profitability =
                    await EquipmentProfitabilityService
                        .CalculateAsync(
                            equipment,
                            ServerName,
                            profitabilityContext,
                            true
                        );

            _craftCostsByItem[
                equipment.DofusDbId
            ] =
                profitability.CraftCost;

            foreach (string missingData
                    in profitability.MissingData)
            {
                AddMissingData(
                    equipment,
                    missingData
                );
            }

            _unrankedItems.RemoveAll(
                item =>
                    item.DofusDbId ==
                    equipment.DofusDbId
            );

            _rankedItems.RemoveAll(
                result =>
                    result.Equipment.DofusDbId ==
                    equipment.DofusDbId
            );

            List<ItemCrushResult> allResults =
                profitability.Scenarios
                    .Select(ToItemCrushResult)
                    .ToList();

            List<ItemCrushResult> result =
                allResults
                    .Where(MatchesExactRuneFilters)
                    .Where(PassesEconomicFilters)
                    .ToList();

            if (Model?.CompleteDataOnly == true &&
                profitability.MissingData.Count > 0)
            {
                result.Clear();
            }

            if (allResults.Count == 0)
            {
                _unrankedItems.Add(
                    equipment
                );
            }
            else if (result.Count > 0)
            {
                _rankedItems.AddRange(
                    result
                );
            }

            SaveSessionState();
        }
        catch (Exception exn)
        {
            Logger.LogError(
                exn,
                "Error while refreshing item {ItemName} ({ItemId})",
                equipment.Name,
                equipment.DofusDbId
            );
        }
        finally
        {
            _searching = false;

            await InvokeAsync(
                StateHasChanged
            );
        }
    }

    void AddMissingData(Equipment equipment, string message)
    {
        if (!_missingDataByItem.TryGetValue(
            equipment.DofusDbId,
            out HashSet<string>? messages))
        {
            messages = [];
            _missingDataByItem[equipment.DofusDbId] = messages;
        }

        messages.Add(message);
    }

    bool IsPartial(ItemCrushResult item)
    {
        return _missingDataByItem.TryGetValue(
            item.Equipment.DofusDbId,
            out HashSet<string>? warnings)
            && warnings.Count > 0;
    }

    private string PresetMessageCssClass()
    {
        return _presetMessage?.StartsWith(
            "⚠",
            StringComparison.Ordinal
        ) == true
            ? "text-danger"
            : "text-success";
    }

    private SearchFilterPreset? GetSelectedPreset()
    {
        if (_selectedPresetId is not Guid id)
        {
            return null;
        }

        return _filterPresets.FirstOrDefault(
            preset => preset.Id == id
        );
    }

    private string PresetDisplayName(
        SearchFilterPreset preset)
    {
        bool modified =
            _selectedPresetId == preset.Id &&
            IsSelectedPresetModified();

        return modified
            ? $"{preset.Name} • modifié"
            : preset.Name;
    }

    private bool IsSelectedPresetModified()
    {
        SearchFilterPreset? preset =
            GetSelectedPreset();

        if (preset is null ||
            Model is null)
        {
            return false;
        }

        return preset.SortOrder != _sortOrder ||
            !string.Equals(
                JsonSerializer.Serialize(
                    preset.Filters
                ),
                JsonSerializer.Serialize(
                    Model
                ),
                StringComparison.Ordinal
            );
    }

    private static SearchItemsModel CloneSearchModel(
        SearchItemsModel model)
    {
        string json =
            JsonSerializer.Serialize(
                model
            );

        return JsonSerializer
            .Deserialize<SearchItemsModel>(
                json
            )
            ?? new SearchItemsModel();
    }

    private void PersistFilterPresets()
    {
        _filterPresets =
            _filterPresets
                .OrderBy(
                    preset => preset.Name,
                    StringComparer.CurrentCultureIgnoreCase
                )
                .ToList();

        BestCrushSettings
            .SaveSearchFilterPresets(
                _filterPresets
            );
    }

    private void BeginNewPreset()
    {
        Model = new SearchItemsModel();
        _sortOrder = SortOrder.BestBenefit;
        _selectedPresetId = null;
        _presetEditorMode = "create";
        _presetNameDraft = string.Empty;
        _confirmDeletePreset = false;
        _presetMessage = null;

        _allItems = null;
        _rankedItems = null;
        _unrankedItems = null;
    }

    private void SaveCurrentPreset()
    {
        SearchFilterPreset? preset =
            GetSelectedPreset();

        if (preset is null)
        {
            _presetEditorMode = "create";
            _presetNameDraft = string.Empty;
            _presetMessage = null;
            return;
        }

        preset.Filters =
            CloneSearchModel(
                Model ?? new SearchItemsModel()
            );

        preset.SortOrder =
            _sortOrder;

        PersistFilterPresets();

        _presetMessage =
            $"✓ Filtre « {preset.Name} » mis à jour.";
    }

    private void BeginRenamePreset()
    {
        SearchFilterPreset? preset =
            GetSelectedPreset();

        if (preset is null)
        {
            return;
        }

        _presetEditorMode = "rename";
        _presetNameDraft = preset.Name;
        _presetMessage = null;
    }

    private void ConfirmPresetEditor()
    {
        string name =
            _presetNameDraft.Trim();

        if (string.IsNullOrWhiteSpace(
            name))
        {
            _presetMessage =
                "⚠ Donne un nom au filtre.";
            return;
        }

        SearchFilterPreset? selected =
            GetSelectedPreset();

        bool duplicateName =
            _filterPresets.Any(
                preset =>
                    !ReferenceEquals(
                        preset,
                        selected
                    ) &&
                    string.Equals(
                        preset.Name,
                        name,
                        StringComparison.CurrentCultureIgnoreCase
                    )
            );

        if (duplicateName)
        {
            _presetMessage =
                "⚠ Un filtre porte déjà ce nom.";
            return;
        }

        if (string.Equals(
            _presetEditorMode,
            "rename",
            StringComparison.Ordinal))
        {
            if (selected is null)
            {
                CancelPresetEditor();
                return;
            }

            selected.Name = name;
            PersistFilterPresets();
            _presetMessage =
                $"✓ Filtre renommé « {name} ».";
        }
        else
        {
            SearchFilterPreset preset =
                new()
                {
                    Name = name,
                    Filters = CloneSearchModel(
                        Model ?? new SearchItemsModel()
                    ),
                    SortOrder = _sortOrder
                };

            _filterPresets.Add(
                preset
            );

            _selectedPresetId =
                preset.Id;

            PersistFilterPresets();
            _presetMessage =
                $"✓ Filtre « {name} » créé.";
        }

        _presetEditorMode = null;
        _presetNameDraft = string.Empty;
    }

    private void CancelPresetEditor()
    {
        _presetEditorMode = null;
        _presetNameDraft = string.Empty;
    }

    private void DeleteSelectedPreset()
    {
        SearchFilterPreset? preset =
            GetSelectedPreset();

        if (preset is null)
        {
            _confirmDeletePreset = false;
            return;
        }

        string name = preset.Name;

        _filterPresets.Remove(
            preset
        );

        PersistFilterPresets();

        _selectedPresetId = null;
        _confirmDeletePreset = false;
        _presetEditorMode = null;
        _presetMessage =
            $"✓ Filtre « {name} » supprimé.";
    }

    private async Task ApplyPresetAsync(
        ChangeEventArgs args)
    {
        string? rawValue =
            args.Value?.ToString();

        if (!Guid.TryParse(
            rawValue,
            out Guid id))
        {
            _selectedPresetId = null;
            return;
        }

        SearchFilterPreset? preset =
            _filterPresets.FirstOrDefault(
                candidate => candidate.Id == id
            );

        if (preset is null)
        {
            return;
        }

        _selectedPresetId = id;
        Model = CloneSearchModel(
            preset.Filters
        );
        _sortOrder = preset.SortOrder;
        _presetEditorMode = null;
        _confirmDeletePreset = false;
        _presetMessage = null;

        SaveSessionState();

        await Search(
            forceRefresh: false
        );
    }

    private async Task ApplyOpportunitiesAsync()
    {
        Model ??= new SearchItemsModel();

        Model.ProfitabilityMode =
            ProfitabilityFilterMode.Best;
        Model.CompleteDataOnly = true;
        Model.FreshDataOnly = true;
        Model.RequireCoefficient = true;

        _sortOrder = SortOrder.BestYield;
        _selectedPresetId = null;
        _presetMessage =
            "✓ Filtre Opportunités appliqué.";

        await Search(
            forceRefresh: false
        );
    }

    private bool HasEconomicFilters()
    {
        return Model is not null &&
            (
                Model.MinimumRoiPercent is not null ||
                Model.MinimumBenefit is not null ||
                Model.CompleteDataOnly ||
                Model.FreshDataOnly ||
                Model.RequireCoefficient ||
                Model.RuneFilters.Count > 0
            );
    }

    private bool MatchesExactRuneFilters(
        ItemCrushResult item)
    {
        IReadOnlyList<RuneFilterCriterion> criteria =
            Model?.RuneFilters ?? [];

        if (criteria.Count == 0)
        {
            return true;
        }

        HashSet<long> obtainedRuneIds =
            item.Runes
                .Where(entry => entry.Value > 0)
                .Select(entry => entry.Key.DofusDbId)
                .ToHashSet();

        return Model!.RuneMatchMode ==
            RuneFilterMatchMode.All
                ? criteria.All(
                    criterion =>
                        obtainedRuneIds.Contains(
                            criterion.DofusDbId
                        )
                )
                : criteria.Any(
                    criterion =>
                        obtainedRuneIds.Contains(
                            criterion.DofusDbId
                        )
                );
    }

    private bool PassesEconomicFilters(
        ItemCrushResult item)
    {
        SearchItemsModel? model =
            Model;

        if (model is null)
        {
            return true;
        }

        if (model.RequireCoefficient &&
            item.Coefficient.CoefficientPercent <= 0)
        {
            return false;
        }

        if (model.CompleteDataOnly &&
            IsPartial(item))
        {
            return false;
        }

        if (model.FreshDataOnly &&
            !HasFreshData(item))
        {
            return false;
        }

        double effectiveYield =
            GetEffectiveYield(item);

        if (model.MinimumRoiPercent
                is double minimumRoi &&
            effectiveYield * 100.0 < minimumRoi)
        {
            return false;
        }

        double effectiveBenefit =
            GetEffectiveBenefit(item);

        if (model.MinimumBenefit
                is double minimumBenefit &&
            effectiveBenefit < minimumBenefit)
        {
            return false;
        }

        return true;
    }

    private bool HasFreshData(
        ItemCrushResult item)
    {
        if (DataFreshnessEvaluator
                .Evaluate(
                    item.Coefficient.ObservedAtUtc
                ) != DataFreshness.Fresh)
        {
            return false;
        }

        if (item.RuneValues.Values.Any(
            value =>
                value.Freshness !=
                    DataFreshness.Fresh))
        {
            return false;
        }

        bool purchaseFresh =
            item.Cost is not null &&
            DataFreshnessEvaluator
                .Evaluate(
                    item.Cost.ObservedAtUtc
                ) == DataFreshness.Fresh;

        bool craftFresh =
            item.CraftCost.IsComplete &&
            item.CraftCost.Resources.All(
                resource =>
                    resource.Purchase?.Freshness ==
                        DataFreshness.Fresh
            );

        return (Model?.ProfitabilityMode ??
            ProfitabilityFilterMode.Best) switch
        {
            ProfitabilityFilterMode.Purchase =>
                purchaseFresh,

            ProfitabilityFilterMode.Craft =>
                craftFresh,

            _ =>
                purchaseFresh || craftFresh
        };
    }

    private double GetEffectiveBenefit(
        ItemCrushResult item)
    {
        return (Model?.ProfitabilityMode ??
            ProfitabilityFilterMode.Best) switch
        {
            ProfitabilityFilterMode.Purchase =>
                item.PurchaseBenefit ??
                    double.MinValue,

            ProfitabilityFilterMode.Craft =>
                item.CraftBenefit ??
                    double.MinValue,

            _ => item.Benefits
        };
    }

    private double GetEffectiveYield(
        ItemCrushResult item)
    {
        return (Model?.ProfitabilityMode ??
            ProfitabilityFilterMode.Best) switch
        {
            ProfitabilityFilterMode.Purchase =>
                item.PurchaseYield ??
                    double.MinValue,

            ProfitabilityFilterMode.Craft =>
                item.CraftYield ??
                    double.MinValue,

            _ => item.Yield
        };
    }

    private double GetEffectiveTargetMargin(
        ItemCrushResult item)
    {
        return (Model?.ProfitabilityMode ??
            ProfitabilityFilterMode.Best) switch
        {
            ProfitabilityFilterMode.Purchase =>
                item.PurchaseTargetMargin ??
                    double.MinValue,

            ProfitabilityFilterMode.Craft =>
                item.CraftTargetMargin ??
                    double.MinValue,

            _ => Math.Max(
                item.PurchaseTargetMargin ??
                    double.MinValue,
                item.CraftTargetMargin ??
                    double.MinValue
            )
        };
    }

    private ItemCrushResult SelectBestScenarioForCurrentSort(
        IGrouping<Equipment, ItemCrushResult> group)
    {
        Func<ItemCrushResult, double> selector =
            _sortOrder switch
            {
                SortOrder.BestYield =>
                    GetEffectiveYield,

                SortOrder.PurchaseBenefit =>
                    result =>
                        result.PurchaseBenefit ??
                            double.MinValue,

                SortOrder.PurchaseYield =>
                    result =>
                        result.PurchaseYield ??
                            double.MinValue,

                SortOrder.CraftBenefit =>
                    result =>
                        result.CraftBenefit ??
                            double.MinValue,

                SortOrder.CraftYield =>
                    result =>
                        result.CraftYield ??
                            double.MinValue,

                SortOrder.HighestTargetMargin =>
                    GetEffectiveTargetMargin,

                SortOrder.HighestRuneValue =>
                    result =>
                        result.AdjustedRuneValue,

                _ => GetEffectiveBenefit
            };

        return group
            .OrderByDescending(
                selector
            )
            .First();
    }

    private IEnumerable<ItemCrushResult> OrderResults(
        IEnumerable<ItemCrushResult> results)
    {
        return _sortOrder switch
        {
            SortOrder.BestYield =>
                results.OrderByDescending(
                    GetEffectiveYield
                ),

            SortOrder.PurchaseBenefit =>
                results.OrderByDescending(
                    result =>
                        result.PurchaseBenefit ??
                            double.MinValue
                ),

            SortOrder.PurchaseYield =>
                results.OrderByDescending(
                    result =>
                        result.PurchaseYield ??
                            double.MinValue
                ),

            SortOrder.CraftBenefit =>
                results.OrderByDescending(
                    result =>
                        result.CraftBenefit ??
                            double.MinValue
                ),

            SortOrder.CraftYield =>
                results.OrderByDescending(
                    result =>
                        result.CraftYield ??
                            double.MinValue
                ),

            SortOrder.HighestTargetMargin =>
                results.OrderByDescending(
                    GetEffectiveTargetMargin
                ),

            SortOrder.HighestRuneValue =>
                results.OrderByDescending(
                    result =>
                        result.AdjustedRuneValue
                ),

            SortOrder.NameAscending =>
                results.OrderBy(
                    result => result.Equipment.Name,
                    StringComparer.CurrentCultureIgnoreCase
                ),

            SortOrder.HighestCoefficient =>
                results
                    .OrderByDescending(
                        result =>
                            result.Coefficient
                                .CoefficientPercent
                    )
                    .ThenBy(
                        result => result.Equipment.Name,
                        StringComparer.CurrentCultureIgnoreCase
                    ),

            SortOrder.LevelAscending =>
                results
                    .OrderBy(
                        result =>
                            result.Equipment.Level
                    )
                    .ThenBy(
                        result => result.Equipment.Name,
                        StringComparer.CurrentCultureIgnoreCase
                    ),

            SortOrder.LevelDescending =>
                results
                    .OrderByDescending(
                        result =>
                            result.Equipment.Level
                    )
                    .ThenBy(
                        result => result.Equipment.Name,
                        StringComparer.CurrentCultureIgnoreCase
                    ),

            _ =>
                results.OrderByDescending(
                    GetEffectiveBenefit
                )
        };
    }

    IEnumerable<Equipment> FilterItems(IReadOnlyCollection<Equipment> items)
    {
        IEnumerable<Equipment> result = items;

        if (!string.IsNullOrWhiteSpace(
            Model?.SearchText))
        {
            string search =
                Model.SearchText.Trim();

            result = result.Where(
                item =>
                    item.Name.Contains(
                        search,
                        StringComparison.CurrentCultureIgnoreCase
                    )
            );
        }

        if (Model?.LevelMin is int levelMin)
        {
            result = result.Where(
                item => item.Level >= levelMin
            );
        }

        if (Model?.LevelMax is int levelMax)
        {
            result = result.Where(
                item => item.Level <= levelMax
            );
        }

        HashSet<EquipmentType> equipmentTypes =
            ComputeEquipmentTypes();

        if (equipmentTypes.Count > 0)
        {
            result = result.Where(
                item =>
                    equipmentTypes.Contains(
                        item.Type
                    )
            );
        }

        IReadOnlyList<RuneFilterCriterion> criteria =
            Model?.RuneFilters ?? [];

        if (criteria.Count > 0)
        {
            result = result.Where(
                equipment =>
                {
                    bool Matches(
                        RuneFilterCriterion criterion)
                    {
                        return equipment.Characteristics
                            .Any(
                                candidate =>
                                    candidate.Characteristic ==
                                    criterion.Characteristic
                            );
                    }

                    return Model!.RuneMatchMode ==
                        RuneFilterMatchMode.All
                            ? criteria.All(Matches)
                            : criteria.Any(Matches);
                }
            );
        }

        return result;
    }

