@using BestCrush.Services
@inject ItemsService ItemsService
@inject RunesService RunesService
@inject BestCrush.Services.BestCrushSettingsService BestCrushSettings
@inject ILogger<Server> Logger
@inject BestCrush.Services.OverlayService OverlayService
@inject BestCrush.Services.CurrentServerState CurrentServerState
@inject NavigationManager NavigationManager
@inject IDataPriorityProvider DataPriorityProvider
@inject EquipmentProfitabilityService EquipmentProfitabilityService
@inject BestCrush.Services.LiveStockService Stocks
@inject BestCrush.Services.CurrentDofusClientsState Clients
@inject StockCraftPlanner StockPlanner
@inject Microsoft.Extensions.DependencyInjection.IServiceScopeFactory AnalysisScopes
@using Microsoft.Extensions.DependencyInjection

@implements IDisposable

@page "/servers/{ServerName}"
@using BestCrush.Components.Pure
@using BestCrush.Domain.Models
@using BestCrush.Domain.Services
@using BestCrush.Models
@using DofusSharp.Dofocus.ApiClients.Models.Items
@using Microsoft.Extensions.Logging
@using System.Text.Json


@{ var artworkStock = Stocks.SelectedForServer(ServerName); }
<ItemCopyScope>
<div class="container workspace-page">
    <PageHeading Title="Concassage" Description="Comparez les équipements à briser selon leur coût d’achat ou de craft et la valeur estimée des runes." />
    <WorkspaceSettingsDialog Visible="@_showSettings" OnClose="CloseSettings"
                             OnYieldChanged="RefreshCrushSettingsAsync" />


    <details class="mb-3">
        <summary class="btn btn-outline-secondary btn-sm"><i class="bi bi-bookmark me-2" aria-hidden="true"></i>Filtres enregistrés</summary>
    <div class="card border-0 bg-light mt-2">
        <div class="card-body py-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <label class="small fw-semibold text-nowrap" for="saved-filter-select">
                    Filtres enregistrés
                </label>

                <select id="saved-filter-select"
                        class="form-select form-select-sm"
                        style="width:auto; min-width:220px"
                        value="@(_selectedPresetId?.ToString() ?? string.Empty)"
                        @onchange="ApplyPresetAsync"
                        disabled="@_searching">
                    <option value="">— Aucun —</option>
                    @foreach (SearchFilterPreset preset in _filterPresets.OrderBy(p => p.Name))
                    {
                        <option value="@preset.Id">
                            @PresetDisplayName(preset)
                        </option>
                    }
                </select>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        @onclick="BeginNewPreset"
                        disabled="@_searching">
                    Nouveau
                </button>

                <button type="button"
                        class="btn btn-outline-primary btn-sm"
                        @onclick="SaveCurrentPreset"
                        disabled="@_searching">
                    Enregistrer
                </button>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        @onclick="BeginRenamePreset"
                        disabled="@(_searching || _selectedPresetId is null)">
                    Renommer
                </button>

                @if (_confirmDeletePreset)
                {
                    <button type="button"
                            class="btn btn-danger btn-sm"
                            @onclick="DeleteSelectedPreset"
                            disabled="@_searching">
                        Confirmer la suppression
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            @onclick="() => _confirmDeletePreset = false">
                        Annuler
                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            @onclick="() => _confirmDeletePreset = true"
                            disabled="@(_searching || _selectedPresetId is null)">
                        Supprimer
                    </button>
                }

                <button type="button"
                        class="btn btn-outline-success btn-sm ms-auto"
                        title="Données complètes et fraîches, coefficient connu"
                        @onclick="ApplyOpportunitiesAsync"
                        disabled="@_searching">
                    Opportunités
                </button>
            </div>

            @if (_presetEditorMode is not null)
            {
                <div class="d-flex align-items-center gap-2 mt-2">
                    <input class="form-control form-control-sm"
                           style="max-width:320px"
                           placeholder="Nom du filtre"
                           @bind="_presetNameDraft" />
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            @onclick="ConfirmPresetEditor">
                        Valider
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            @onclick="CancelPresetEditor">
                        Annuler
                    </button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_presetMessage))
            {
                <div class="small @PresetMessageCssClass() mt-2">@_presetMessage</div>
            }
        </div>
    </div>

    </details>

    @if (StockItemId is not null)
    {
        <p class="small">Équipement ciblé · <a href="@AllEquipmentUrl">Afficher tous les objets</a></p>
    }
    <form method="post" @onsubmit="AnalyzeAsync" @onsubmit:preventDefault @formname="search-form">
        <SearchItemsForm @ref="_searchForm" Model="Model" AvailableRunes="_availableRunes" Disabled="_searching"
            JobCatalog="_crushingJobCatalog" JobsLoading="_jobFiltersBusy" JobsError="@_jobFiltersError" RetryJobs="LoadCrushingJobsAsync" JobSelectionChanged="OnCrushingJobSelectionChanged" SearchChanged="StateHasChanged"
            PlayerLevel="DetectedPlayerLevel" ProfessionLevels="DetectedProfessionLevels">
            <Actions>
                <label class="d-flex align-items-center gap-2">
                    <input id="use-crushing-stocks" class="form-check-input mt-0" type="checkbox" checked="@_takeStocks" @onchange="ToggleStocks" />
                    <span>Stock personnel</span>
                </label>
                <button class="btn btn-primary" type="submit" disabled="@(_searching || JobFilterUnavailable)">
                    @if (_searching) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                    @AnalysisButtonText
                </button>
            </Actions>
        </SearchItemsForm>
    </form>

    <div>
        @if (_takeStocks)
        {
            <div class="small text-secondary mt-1" title="Le gain après achats ne déduit pas la valeur de revente des ingrédients possédés.">
                @if (UseStockCalculation)
                {
                    <span>@(BestCrush.Services.StockOpportunityService.HasSynchronizedBank(_preparedStockSource) ? "Inventaire + banque" : "Inventaire seul") · gain après achats, avant taxes.</span>
                }
                else if (_preparingStocks) { <span>Préparation des stocks…</span> }
                else { <span>Inventaire non synchronisé sur ce serveur : calcul standard affiché. Reconnectez le personnage avec BestCrush ouvert.</span> }
            </div>
        }
    </div>
    @if (_marketUpdating) { <p class="small text-secondary" role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Actualisation des prix…</p> }
    @if (_marketRefreshError is not null) { <p class="small text-warning" role="status">@_marketRefreshError</p> }
    @if (_analysisError is not null)
    {
        <div class="alert alert-warning" role="status">@_analysisError</div>
    }

    @if (_allItems is not null && _analyzing)
    {
        int done = _processedItems;
        double ratio = _allItems.Length == 0
            ? 1
            : (double)done / _allItems.Length;
        int percent = (int)(ratio * 100);

        {
            <div class="progress mb-4" role="progressbar" aria-label="Progression de l’analyse des concassages" aria-valuenow="@done" aria-valuemin="0" aria-valuemax="@_allItems.Length">
                <div class="progress-bar progress-bar-striped progress-bar-animated text-bg-warning" style="width: @percent%">@done / @_allItems.Length</div>
            </div>
        }
    }

    @if (!_searching && _rankedItems is not null && _unrankedItems is not null &&
        !string.IsNullOrWhiteSpace(Model?.SearchText) &&
        !_rankedItems.Any(x => MatchesSearchText(x.Equipment)) && !_unrankedItems.Any(MatchesSearchText) &&
        (_rankedItems.Count + _unrankedItems.Count > 0))
    {
        <p class="alert alert-info" role="status">Aucun résultat déjà analysé ne correspond à ce nom. Relancez l’analyse pour rechercher d’autres équipements.</p>
    }
    @if (_unrankedItems is not null && _rankedItems is not null)
    {
        @if (_rankedItems.Count > 0)
        {
            IEnumerable<IGrouping<Equipment, ItemCrushResult>> equipments =
                _rankedItems.GroupBy(i => i.Equipment);

            IEnumerable<ItemCrushResult> bestLines =
                equipments.Select(
                    SelectBestScenarioForCurrentSort
                );

            IEnumerable<ItemCrushResult> bestLinesOrdered =
                OrderResults(
                    bestLines
                );

            <div class="my-4">
                <div class="d-flex align-items-center justify-content-end gap-2 mb-2 px-3">
                    <div class="d-flex gap-2">
                        <label for="sort-order" class="col-form-label col-form-label-sm text-nowrap">Tri par</label>
                        <InputSelect TValue="SortOrder" @bind-Value="_sortOrder" class="form-select form-select-sm" id="sort-order">
                            <option value="@SortOrder.BestBenefit">@(UseStockCalculation ? "Gain après achats — meilleur mode" : "Bénéfice — meilleur mode")</option>
                            <option value="@SortOrder.BestYield">ROI — meilleur mode</option>
                            <option value="@SortOrder.PurchaseBenefit">@(UseStockCalculation ? "Gain après achat de l’équipement" : "Bénéfice achat")</option>
                            <option value="@SortOrder.PurchaseYield">ROI achat</option>
                            <option value="@SortOrder.CraftBenefit">@(UseStockCalculation ? "Gain après achats (craft)" : "Bénéfice craft")</option>
                            <option value="@SortOrder.CraftYield">ROI craft</option>
                            <option value="@SortOrder.HighestTargetMargin">Marge avant seuil</option>
                            <option value="@SortOrder.HighestRuneValue">Valeur runes ajustée</option>
                            <option value="@SortOrder.NameAscending">Nom (A → Z)</option>
                            <option value="@SortOrder.HighestCoefficient">Coefficient (décroissant)</option>
                            <option value="@SortOrder.LevelAscending">Niveau (croissant)</option>
                            <option value="@SortOrder.LevelDescending">Niveau (décroissant)</option>
                        </InputSelect>
                    </div>
                    <div>
                        <button class="btn btn-light border" @onclick="() => Search(true)" disabled="@_searching">Tout rafraîchir</button>
                    </div>
                </div>
                <div class="service-results">
                    @{
                        ItemCrushResult[] completeLines =
                            bestLinesOrdered
                                .Where(item => MatchesSearchText(item.Equipment) && !IsPartial(item))
                                .ToArray();

                        ItemCrushResult[] partialLines =
                            bestLinesOrdered
                                .Where(item => MatchesSearchText(item.Equipment) && IsPartial(item))
                                .ToArray();
                    }
                    @if (completeLines.Length > 0)
                    {
                        <h5 class="mt-4 mb-3">
                            Résultats complets
                            <span class="badge text-bg-success">
                                @completeLines.Length
                            </span>
                        </h5>

                        <PagedDataTable Items="completeLines" PageSize="30" ResetKey="@($"{ServerName}|{_sortOrder}|{StockItemId}|{Model?.SearchText}")">
                            <RowContent Context="pageRows">
                        @foreach (ItemCrushResult item in pageRows)
                        {
                            <div class="p-0" @key="item.Equipment.DofusDbId">
                                <ServiceResult InitiallyExpanded="@(StockItemId == item.Equipment.DofusDbId)" Focus="() => FocusInOverlay(item.Equipment)" FocusItemName="@item.Equipment.Name">
<Summary>
    <span class="result-identity"><StockItemArtwork ItemId="item.Equipment.DofusDbId" Stock="artworkStock"><MarketItemPicture IconId="item.Equipment.DofusDbIconId" /></StockItemArtwork><span><span class="result-name"><CopyTextButton Value="@item.Equipment.Name" Tooltip="Copier le nom de l’équipement">@item.Equipment.Name</CopyTextButton></span><small>@item.Equipment.Type.ToDisplayName() · Niv. @item.Equipment.Level</small></span></span>
    <span class="result-stat"><small>Coefficient</small><strong>@item.Coefficient.CoefficientPercent.ToString("N0") %</strong></span>
    <span class="result-stat"><small>Valeur des runes</small><strong>@CrushMoney(item.AdjustedRuneValue)</strong></span>
    <span class="result-stat"><small>@(UseStockCalculation ? "Gain après achats" : "Gain estimé")</small><strong style="@($"color: {GainColor(item)}")">@CrushMoney(GetEffectiveBenefit(item))</strong></span>
</Summary>
<ChildContent>
                                <CrushResultLine Stock="artworkStock" Equipment="item.Equipment"
                                                Cost="item.Cost"
                                                CraftCost="item.CraftCost"
                                                FocusedCharacteristic="item.FocusedCharacteristic"
                                                Runes="item.Runes"
                                                RuneValues="item.RuneValues"
                                                AdjustedRuneValue="item.AdjustedRuneValue"
                                                NoImage="_searching"
                                                />
                                <CraftCostSummary Equipment="item.Equipment" StockServerName="@ServerName" Result="item.CraftCost" StockPlan="@(UseStockCalculation ? _stockPlans.GetValueOrDefault(item.Equipment.DofusDbId) : null)" />
</ChildContent>
                                </ServiceResult>
                            </div>
                        }
                            </RowContent>
                        </PagedDataTable>
                    }
                    @if (partialLines.Length > 0)
                    {
                        <h5 class="mt-5 mb-3">
                            Données partielles
                            <span class="badge text-bg-warning">
                                @partialLines.Length
                            </span>
                        </h5>

                        <PagedDataTable Items="partialLines" PageSize="30" ResetKey="@($"{ServerName}|{_sortOrder}|{StockItemId}|{Model?.SearchText}")">
                            <RowContent Context="pageRows">
                        @foreach (ItemCrushResult item in pageRows)
                        {
                            <div class="p-0" @key="item.Equipment.DofusDbId">
                                <ServiceResult InitiallyExpanded="@(StockItemId == item.Equipment.DofusDbId)" Focus="() => FocusInOverlay(item.Equipment)" FocusItemName="@item.Equipment.Name">
<Summary>
    <span class="result-identity"><StockItemArtwork ItemId="item.Equipment.DofusDbId" Stock="artworkStock"><MarketItemPicture IconId="item.Equipment.DofusDbIconId" /></StockItemArtwork><span><span class="result-name"><CopyTextButton Value="@item.Equipment.Name" Tooltip="Copier le nom de l’équipement">@item.Equipment.Name</CopyTextButton></span><small>@item.Equipment.Type.ToDisplayName() · Niv. @item.Equipment.Level</small></span></span>
    <span class="result-stat"><small>Coefficient</small><strong>@item.Coefficient.CoefficientPercent.ToString("N0") %</strong></span>
    <span class="result-stat"><small>Valeur des runes</small><strong>@CrushMoney(item.AdjustedRuneValue)</strong></span>
    <span class="result-stat"><small>@(UseStockCalculation ? "Gain après achats" : "Gain estimé")</small><strong style="@($"color: {GainColor(item)}")">@CrushMoney(GetEffectiveBenefit(item))</strong></span>
</Summary>
<ChildContent>

                                <CrushResultLine Stock="artworkStock" Equipment="item.Equipment"
                                                Cost="item.Cost"
                                                CraftCost="item.CraftCost"
                                                FocusedCharacteristic="item.FocusedCharacteristic"
                                                Runes="item.Runes"
                                                RuneValues="item.RuneValues"
                                                AdjustedRuneValue="item.AdjustedRuneValue"
                                                NoImage="_searching"
                                                />
                                <CraftCostSummary Equipment="item.Equipment" StockServerName="@ServerName" Result="item.CraftCost" StockPlan="@(UseStockCalculation ? _stockPlans.GetValueOrDefault(item.Equipment.DofusDbId) : null)" />

                                @if (_missingDataByItem.TryGetValue(
                                    item.Equipment.DofusDbId,
                                    out HashSet<string>? warnings))
                                {
                                    <CrushingMissingData Calculation="@_baseCalculations.GetValueOrDefault(item.Equipment.DofusDbId)" CraftCost="item.CraftCost" Messages="warnings" Stock="artworkStock" />
                                }

</ChildContent>
                                </ServiceResult>
                            </div>
                        }
                            </RowContent>
                        </PagedDataTable>
                    }
                </div>
            </div>
        }

        @if (_unrankedItems is { Count: > 0 } unrankedItems && !HasEconomicFilters())
        {
            IEnumerable<Equipment> unrankedItemsOrdered =
                _sortOrder switch
                {
                    SortOrder.NameAscending =>
                        unrankedItems.OrderBy(
                            item => item.Name,
                            StringComparer.CurrentCultureIgnoreCase
                        ),

                    SortOrder.HighestCoefficient =>
                        unrankedItems
                            .OrderByDescending(
                                item =>
                                    _coefficients.TryGetValue(
                                        item.DofusDbId,
                                        out CoefficientObservation? coefficient
                                    )
                                        ? coefficient.CoefficientPercent
                                        : double.MinValue
                            )
                            .ThenBy(
                                item => item.Name,
                                StringComparer.CurrentCultureIgnoreCase
                            ),

                    SortOrder.LevelAscending =>
                        unrankedItems
                            .OrderBy(item => item.Level)
                            .ThenBy(
                                item => item.Name,
                                StringComparer.CurrentCultureIgnoreCase
                            ),

                    SortOrder.LevelDescending =>
                        unrankedItems
                            .OrderByDescending(item => item.Level)
                            .ThenBy(
                                item => item.Name,
                                StringComparer.CurrentCultureIgnoreCase
                            ),

                    _ =>
                        unrankedItems
                };
            unrankedItemsOrdered = unrankedItemsOrdered.Where(MatchesSearchText);

            <div class="my-4">

                <h5>
                    Données absentes
                    <span class="badge text-bg-secondary">
                        @unrankedItemsOrdered.Count()
                    </span>
                </h5>

                <div class="list-group">

                    <PagedDataTable Items="unrankedItemsOrdered" PageSize="30" ResetKey="@($"{ServerName}|{_sortOrder}|{StockItemId}|{Model?.SearchText}")">
                        <RowContent Context="pageRows">
                    @foreach (Equipment item in pageRows)
                    {
                        <div @key="item.DofusDbId">
                            <ServiceResult InitiallyExpanded="@(StockItemId == item.DofusDbId)" Focus="() => FocusInOverlay(item)" FocusItemName="@item.Name">
                                <Summary><span class="result-identity"><StockItemArtwork ItemId="item.DofusDbId" Stock="artworkStock"><MarketItemPicture IconId="item.DofusDbIconId" /></StockItemArtwork><span><span class="result-name"><CopyTextButton Value="@item.Name" Tooltip="Copier le nom de l’équipement">@item.Name</CopyTextButton></span><small>@item.Type.ToDisplayName() · Niv. @item.Level</small></span></span><span class="badge text-bg-secondary">Données manquantes</span></Summary>
                                <ChildContent>
                                    <CrushResultLine Equipment="item" Stock="artworkStock" Cost="@_baseCalculations.GetValueOrDefault(item.DofusDbId)?.EquipmentCost"
                                        CraftCost="@_craftCostsByItem.GetValueOrDefault(item.DofusDbId)" NoImage="_searching" />
                                    @if (_craftCostsByItem.TryGetValue(item.DofusDbId, out CraftCostResult? craftCost))
                                    {
                                        <CraftCostSummary Equipment="item" StockServerName="@ServerName" Result="@(UseStockCalculation && _stockPlans.TryGetValue(item.DofusDbId, out var plan) ? StockCrushingProjection.RemainingCost(plan) : craftCost)" StockPlan="@(UseStockCalculation ? _stockPlans.GetValueOrDefault(item.DofusDbId) : null)" />
                                    }
                                    @if (_missingDataByItem.TryGetValue(item.DofusDbId, out HashSet<string>? missingData))
                                    {
                                        <CrushingMissingData Calculation="@_baseCalculations.GetValueOrDefault(item.DofusDbId)" CraftCost="@(UseStockCalculation && _stockPlans.TryGetValue(item.DofusDbId, out var missingPlan) ? StockCrushingProjection.RemainingCost(missingPlan) : null)" Messages="missingData" Partial="false" Stock="artworkStock" />
                                    }
                                </ChildContent>
                            </ServiceResult>
                        </div>
                    }

                        </RowContent>
                    </PagedDataTable>
                </div>

            </div>
        }

        @if (!_searching && _analysisError is null && _rankedItems.Count == 0 &&
            (HasEconomicFilters() || _unrankedItems.Count == 0))
        {
            <div class="text-center text-secondary border rounded py-4 my-4" role="status">
                @if (_allItems is { Length: 0 })
                {
                    <span>Aucun équipement ne correspond à ces filtres. Modifiez-les puis relancez l’analyse.</span>
                }
                else
                {
                    <span>Aucun équipement ne satisfait les filtres actuels.</span>
                }
            </div>
        }
    }
</div>

</ItemCopyScope>

@code {
    private static readonly Dictionary<string, ServerPageState>
        _sessionStates =
            new(StringComparer.OrdinalIgnoreCase);

    private ServerPageState? _sessionState;

    private string? _loadedServerName;

    private bool _searching;
    private int _processedItems;
    private bool _showSettings;

    private IReadOnlyList<Rune> _availableRunes =
        Array.Empty<Rune>();

    private List<SearchFilterPreset> _filterPresets = [];
    private Guid? _selectedPresetId;
    private string? _presetEditorMode;
    private string _presetNameDraft = string.Empty;
    private bool _confirmDeletePreset;
    private string? _presetMessage;
    private void CloseSettings()
    {
        _showSettings = false;

        // A global header link may have opened the existing settings
        // modal via ?settings=true. Remove that query when closing it.
        if (ShowSettingsFromQuery)
            NavigationManager.NavigateTo(
                BestCrush.Components.KnownRoutes.Server(ServerName),
                replace: true);
    }
    Equipment[]? _allItems;
    List<ItemCrushResult>? _rankedItems;
    List<Equipment>? _unrankedItems;
    Dictionary<long, HashSet<string>> _missingDataByItem = new();
    IReadOnlyDictionary<(long DofusDbId, int Quantity), MarketPriceObservation> _runePrices =
    new Dictionary<(long DofusDbId, int Quantity), MarketPriceObservation>();
    IReadOnlyDictionary<(long DofusDbId, int Quantity), MarketPriceObservation> _equipmentPrices =
    new Dictionary<(long DofusDbId, int Quantity), MarketPriceObservation>();
    IReadOnlyDictionary<
        (long DofusDbId, int Quantity),
        MarketPriceObservation> _resourcePrices =
            new Dictionary<
                (long DofusDbId, int Quantity),
                MarketPriceObservation>();

    Dictionary<long, CraftCostResult>
        _craftCostsByItem = new();
    Dictionary<long, CoefficientObservation> _coefficients = new();
    SortOrder _sortOrder;

    [Parameter]
    public required string ServerName { get; set; }

    [SupplyParameterFromQuery(Name = "settings")]
    public bool ShowSettingsFromQuery { get; set; }

    [SupplyParameterFromForm]
    private SearchItemsModel? Model { get; set; }

    [CascadingParameter] public WorkspaceNavigation? Workspace { get; set; }

    protected override async Task OnInitializedAsync()
    {
        InitializeProfessionTracking();
        InitializeMarketTracking();
        if (Workspace is not null) Workspace.CrushSettingsChanged += OnWorkspaceCrushSettingsChanged;
        Stocks.Changed += OnCrushingStockChanged;
        Clients.Changed += OnCrushingStockChanged;
        _availableRunes =
            (await RunesService.GetRunesAsync())
                .OrderBy(
                    rune => rune.Name,
                    StringComparer.CurrentCultureIgnoreCase
                )
                .ToArray();

        _filterPresets =
            BestCrushSettings
                .GetSearchFilterPresets()
                .OrderBy(
                    preset => preset.Name,
                    StringComparer.CurrentCultureIgnoreCase
                )
                .ToList();
        _ = LoadCrushingJobsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ShowSettingsFromQuery)
        {
            if (Workspace is null) _showSettings = true;
            else
            {
                Workspace.OpenSettings();
                NavigationManager.NavigateTo(KnownRoutes.Server(ServerName), replace: true);
            }
        }
        if (!CurrentServerState.AutomaticRoutingEnabled) CurrentServerState.SelectServer(ServerName);
        bool serverChanged = !string.Equals(_loadedServerName, ServerName, StringComparison.OrdinalIgnoreCase);
        bool itemChanged = _lastStockItemId != StockItemId;
        bool stocksQueryChanged = _lastStocksQuery != UseStocksFromQuery;
        if (serverChanged)
        {
            InvalidateMarketRefresh();
            bool firstLoad = _loadedServerName is null;
            SaveSessionState();
            _loadedServerName = ServerName;
            LoadSessionState(useSuppliedModel: firstLoad);
            await PrepareStocksAsync(force: true);
            CatchUpMarketChanges();
        }
        if (stocksQueryChanged && UseStocksFromQuery)
        {
            _takeStocks = true;
            RebuildVisibleCalculations();
        }
        _lastStocksQuery = UseStocksFromQuery;
        _lastStockItemId = StockItemId;
        // Links from Opportunities open the existing filtered screen, never a second menu.
        if (((itemChanged || serverChanged) && StockItemId is not null) || (itemChanged && _allItems is not null))
            await Search(false);
    }

    private static string MarketSourceLabel(
        MarketPriceSource source)
    {
        return source switch
        {
            MarketPriceSource.Manual =>
                "Manuel",

            MarketPriceSource.InGameAutomatic =>
                "Jeu",

            _ =>
                source.ToString()
        };
    }

    private static string FreshnessLabel(
        DataFreshness freshness)
    {
        return freshness switch
        {
            DataFreshness.Fresh =>
                "frais",

            DataFreshness.Aging =>
                "à rafraîchir",

            DataFreshness.Stale =>
                "ancien",

            _ =>
                freshness.ToString()
        };
    }

    private static string FreshnessCssClass(
        DataFreshness freshness)
    {
        return freshness switch
        {
            DataFreshness.Fresh =>
                "text-success",

            DataFreshness.Aging =>
                "text-warning",

            DataFreshness.Stale =>
                "text-danger",

            _ =>
                "text-secondary"
        };
    }

    private static Task CopyTextAsync(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
            value))
        {
            return Task.CompletedTask;
        }

        return Microsoft.Maui.ApplicationModel.DataTransfer
            .Clipboard
            .Default
            .SetTextAsync(
                value.Trim()
            );
    }

    private static Task CopyPercentAsync(
        double value)
    {
        return CopyTextAsync(
            value.ToString(
                "0.##",
                System.Globalization.CultureInfo.CurrentCulture
            )
        );
    }

    Task FocusInOverlay(Equipment equipment) => OverlayService.FocusEquipmentAndCopyNameAsync(equipment, ServerName);

    private void LoadSessionState(
        bool useSuppliedModel)
    {
        if (!_sessionStates.TryGetValue(
            ServerName,
            out ServerPageState? state))
        {
            state =
                new ServerPageState();

            _sessionStates[ServerName] =
                state;
        }

        _sessionState = state;

        if (useSuppliedModel &&
            Model is not null)
        {
            state.Model = Model;
        }
        else
        {
            Model = state.Model;
        }

        _allItems =
            state.AllItems;

        _rankedItems =
            state.RankedItems;

        _unrankedItems =
            state.UnrankedItems;

        _missingDataByItem =
            state.MissingDataByItem;

        _runePrices =
            state.RunePrices;

        _equipmentPrices =
            state.EquipmentPrices;

        _resourcePrices =
            state.ResourcePrices;

        _craftCostsByItem =
            state.CraftCostsByItem;

        _coefficients =
            state.Coefficients;

        _sortOrder =
            state.SortOrder;
        _baseCalculations = state.BaseCalculations;
        _marketRevision = state.MarketRevision;
        _takeStocks = UseStocksFromQuery || state.TakeStocks;

    }

    private void SaveSessionState()
    {
        if (_sessionState is null)
        {
            return;
        }

        if (Model is not null)
        {
            _sessionState.Model =
                Model;
        }

        _sessionState.AllItems =
            _allItems;

        _sessionState.RankedItems =
            _rankedItems;

        _sessionState.UnrankedItems =
            _unrankedItems;

        _sessionState.MissingDataByItem =
            _missingDataByItem;

        _sessionState.RunePrices =
            _runePrices;

        _sessionState.EquipmentPrices =
            _equipmentPrices;

        _sessionState.ResourcePrices =
            _resourcePrices;

        _sessionState.CraftCostsByItem =
            _craftCostsByItem;

        _sessionState.Coefficients =
            _coefficients;

        _sessionState.SortOrder =
            _sortOrder;
        _sessionState.BaseCalculations = _baseCalculations;
        _sessionState.MarketRevision = _marketRevision;
        _sessionState.TakeStocks = _takeStocks;
    }

    public void Dispose()
    {
        DisposeProfessionTracking();
        if (Workspace is not null) Workspace.CrushSettingsChanged -= OnWorkspaceCrushSettingsChanged;
        _stockDisposed = true;
        DisposeMarketTracking();
        _jobFiltersStop.Cancel();
        _stockPreparationVersion++;
        Stocks.Changed -= OnCrushingStockChanged;
        Clients.Changed -= OnCrushingStockChanged;
        SaveSessionState();
    }

    private void OnWorkspaceCrushSettingsChanged() => _ = InvokeAsync(RefreshCrushSettingsAsync);

    private async Task RefreshCrushSettingsAsync()
    {
        if (_allItems is not null &&
            (_rankedItems is not null ||
             _unrankedItems is not null))
        {
            await Search(
                forceRefresh: false
            );
        }
    }

    private bool _analyzing;
    private string? _analysisError;
    private string AnalysisButtonText => !_searching ? "Analyser"
        : !_analyzing ? "Actualisation…"
        : _allItems is null ? "Préparation de l’analyse…"
        : $"Analyse… {_processedItems:N0} / {_allItems.Length:N0}";

    private SearchItemsForm? _searchForm;
    private Task AnalyzeAsync()
    {
        _searchForm?.CollapseAdvanced();
        return Search(forceRefresh: false);
    }

    async Task Search(bool forceRefresh)
    {
        if (_searching || _stockDisposed) return;
        bool respectProfessions = Model?.RespectJobLevels == true;
        var professionInputs = CaptureProfessionInputs();
        if (respectProfessions && !CrushingProfessionFilterRules.CanEnable(professionInputs?.PlayerLevel, professionInputs?.Levels, Model?.LevelMin, Model?.LevelMax))
        {
            _analysisError = CrushingProfessionFilterRules.UnavailableReason(professionInputs?.PlayerLevel, professionInputs?.Levels, Model?.LevelMin, Model?.LevelMax);
            Model!.RespectJobLevels = false;
            return;
        }
        if (JobFilterUnavailable)
        {
            _analysisError = "Le métier sélectionné n’est pas disponible. Choisissez Tous les métiers ou réessayez son chargement.";
            return;
        }

        _marketGeneration++;
        _allItems = null;
        _rankedItems = null;
        _unrankedItems = null;
        _processedItems = 0;
        _analysisError = null;
        _searching = true;
        _analyzing = true;
        _missingDataByItem.Clear();
        _baseCalculations.Clear();
        _stockPlans.Clear();
        _stockResults.Clear();
        _stockPreparationVersion++;
        _preparingStocks = false;
        string analysisServer = ServerName;
        long analysisMarketRevision = _marketChanges?.Revision ?? 0;
        bool IsCurrent() => !_stockDisposed && ServerName == analysisServer &&
            (!respectProfessions || professionInputs?.Key == CaptureProfessionInputs()?.Key);
        await InvokeAsync(StateHasChanged);

        try
        {
            // This scope owns its DB context; the worker never shares the view's
            // context with price/stock interactions or another page.
            using var scope = AnalysisScopes.CreateScope();
            var itemsService = scope.ServiceProvider.GetRequiredService<ItemsService>();
            var profitabilityService = scope.ServiceProvider.GetRequiredService<EquipmentProfitabilityService>();
            var loaded = await Task.Run(async () =>
            {
                var all = await itemsService.GetEquipmentsAsync();
                var market = await profitabilityService.LoadContextAsync(analysisServer);
                return (Items: all, Market: market);
            });
            if (!IsCurrent()) return;
            if (respectProfessions)
                await LoadProfessionRecipesAsync(FilterItemsCore(loaded.Items), scope.ServiceProvider);
            if (!IsCurrent()) return;
            Equipment[] items = FilterItems(loaded.Items).ToArray();
            _allItems = items;
            _rankedItems = [];
            _unrankedItems = [];
            var profitabilityContext = loaded.Market;
            _runePrices = profitabilityContext.RunePrices;
            _equipmentPrices = profitabilityContext.EquipmentPrices;
            _resourcePrices = profitabilityContext.ResourcePrices;
            _coefficients = profitabilityContext.Coefficients;
            _craftCostsByItem.Clear();
            SetStockInputs(Stocks.Selected);
            await InvokeAsync(StateHasChanged);

            var renderClock = System.Diagnostics.Stopwatch.StartNew();
            foreach (Equipment item in items)
            {
                if (!IsCurrent()) return;
                try
                {
                    var profitability = await Task.Run(() => profitabilityService.CalculateAsync(
                        item, analysisServer, profitabilityContext, forceRefresh, includeUnpricedScenarios: true));
                    if (!IsCurrent()) return;
                    _craftCostsByItem[item.DofusDbId] = profitability.CraftCost;
                    CacheCalculation(profitability);
                    AddVisibleCalculation(profitability);
                }
                catch (Exception exn)
                {
                    if (!IsCurrent()) return;
                    _unrankedItems.Add(item);
                    AddMissingData(item, "Erreur lors de la récupération des données de brisage");
                    Logger.LogError(exn, "Error while processing item {ItemName} ({ItemId})", item.Name, item.DofusDbId);
                }
                _processedItems++;
                // Show the first result immediately, then limit costly list
                // renders while retaining visible progress throughout the scan.
                if (_processedItems == 1 || _processedItems == items.Length || renderClock.ElapsedMilliseconds >= 100)
                {
                    await InvokeAsync(StateHasChanged);
                    renderClock.Restart();
                }
            }
            _marketRevision = analysisMarketRevision;
            SaveSessionState();
        }
        catch (Exception exn)
        {
            Logger.LogError(exn, "An error occured while searching for best crush.");
            if (IsCurrent()) _analysisError = "L’analyse n’a pas pu aboutir. Réessayez avec le bouton Analyser.";
        }
        finally
        {
            _searching = false;
            _analyzing = false;
            if (!_stockDisposed) { await InvokeAsync(StateHasChanged); CatchUpMarketChanges(); }
        }
    }

    void AddMissingData(Equipment equipment, string message)
    {
        if (!_missingDataByItem.TryGetValue(
            equipment.DofusDbId,
            out HashSet<string>? messages))
        {
            messages = [];
            _missingDataByItem[equipment.DofusDbId] = messages;
        }

        messages.Add(message);
    }

    bool IsPartial(ItemCrushResult item)
    {
        return _missingDataByItem.TryGetValue(
            item.Equipment.DofusDbId,
            out HashSet<string>? warnings)
            && warnings.Count > 0;
    }

