@using BestCrush.Services
@using BestCrush.Network.Protocol
@inject MarketClipboardQueue CopyQueue

<div class="pet-preparation-lists">
    @foreach(var kind in Sections)
    {
        var state=_states[kind];
        var prices=FilteredChecks(kind);
        int count=prices.Count;
        int total=Total(kind);
        <section @key="kind" class="bc-surface" aria-label="@Title(kind)">
            <header>
                <h2><i class="bi bi-shop" aria-hidden="true"></i> @Title(kind) <small>@(count==total ? total.ToString() : $"{count} / {total}")</small></h2>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(count==0)" @onclick="()=>CopyAsync(kind)"
                    aria-label="Copier les éléments à consulter" title="@(kind==ListKind.PetPrices ? "Copier la liste filtrée" : "Copier 50 ressources parmi les résultats")"><i class="bi bi-copy" aria-hidden="true"></i></button>
            </header>
            <ServiceSearch Value="@state.Search" ValueChanged="value=>SetSearch(kind,value)" Label="@($"Rechercher · {Title(kind)}")" Placeholder="Rechercher…" />
            <ul>
                @foreach(var check in prices.Take(state.Visible))
                {
                    <li @key="check.ItemId"><CopyTextButton Value="@check.Name" Tooltip="Copier le nom">@check.Name</CopyTextButton>
                        <StatusIcon Icon="@(check.LastObserved is null ? "question-circle" : "clock-history")" Tooltip="@Reason(check)" CssClass="text-warning" />
                    </li>
                }
            </ul>
            @if(state.Message is not null){<small class="d-block mt-2" role="status">@state.Message</small>}
            @if(count>state.Visible)
            {<button type="button" class="pet-list-more" @onclick="()=>state.Visible+=20">Voir plus… <small>@state.Visible / @count</small></button>}
        </section>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<BreedingPriceCheck> Checks {get;set;}=[];
    [Parameter] public IReadOnlyList<BreedingPriceCheck> ResourcePriceChecks {get;set;}=[];
    [Parameter] public IReadOnlySet<long> KnownFoodExperienceItems {get;set;}=new HashSet<long>();
    [Parameter] public DofusClientWindowKey? TargetWindow {get;set;}
    [Parameter] public bool ShowResourcePrices {get;set;}
    [Parameter] public string MarketTitle {get;set;}="Prix familiers à actualiser";
    private enum ListKind { PetPrices,ResourcePrices }
    private sealed class ListState { public string Search="";public int Visible=20;public string? Message; }
    private readonly Dictionary<ListKind,ListState> _states=Enum.GetValues<ListKind>().ToDictionary(kind=>kind,_=>new ListState());
    private IEnumerable<ListKind> Sections=>new[]{ListKind.PetPrices}
        .Concat(ShowResourcePrices ? [ListKind.ResourcePrices] : Array.Empty<ListKind>())
        .OrderBy(kind=>Total(kind)==0);
    private int Total(ListKind kind)=>kind==ListKind.PetPrices ? Checks.Count : ResourcePriceChecks.Count;
    private string Title(ListKind kind)=>kind==ListKind.PetPrices ? MarketTitle : "Prix ressources à actualiser";
    private static bool Matches(string name,string search)=>name.Contains(search.Trim(),StringComparison.CurrentCultureIgnoreCase);
    private IReadOnlyList<BreedingPriceCheck> FilteredChecks(ListKind kind)=>(kind==ListKind.PetPrices ? Checks : ResourcePriceChecks)
        .Where(entry=>Matches(entry.Name,_states[kind].Search)).ToArray();
    private void SetSearch(ListKind kind,string value)
    {var state=_states[kind];state.Search=value;state.Visible=20;state.Message=null;}
    private static string Reason(BreedingPriceCheck check)=>check.Reason+(check.LastObserved is {} at ? $" · {at.ToLocalTime():dd/MM HH:mm}" : "");
    private async Task CopyAsync(ListKind kind)
    {
        try
        {
            var names=kind==ListKind.ResourcePrices
                ? PetOpportunityService.FoodPriceNames(FilteredChecks(kind),KnownFoodExperienceItems)
                : FilteredChecks(kind).Select(c=>c.Name);
            var result=await CopyQueue.CopyAsync(names,TargetWindow);
            _states[kind].Message=result.IsQueue ? $"{result.Count} noms · Ctrl+V dans Dofus" : "Liste copiée.";
        }
        catch{_states[kind].Message="Copie indisponible.";}
    }
}
