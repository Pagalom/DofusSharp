@using BestCrush.Domain.Models
@using BestCrush.Domain.Services
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@inject IServiceScopeFactory DataScopes
@inject ILogger<ForgemagingWorkspace> Logger

<section class="fm-workspace" aria-busy="@(Busy ? "true" : "false")">
    <PageHeading Title="Forgemagie" Description="Suivez le jet de votre équipement et les runes passées dans l’atelier de Dofus." />
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        @if (!string.IsNullOrWhiteSpace(ServerName))
        {
            <button type="button" class="btn @(_showOwned ? "btn-outline-secondary" : "btn-secondary")" aria-pressed="@(!_showOwned ? "true" : "false")" @onclick="() => _showOwned = false">Assistant</button>
            <button type="button" class="btn @(_showOwned ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@(_showOwned ? "true" : "false")" @onclick="() => _showOwned = true">Mes équipements</button>
            <RuneDataLink ServerName="@ServerName" />
        }
        <a class="btn btn-sm btn-outline-secondary @(!string.IsNullOrWhiteSpace(ServerName) ? "ms-auto" : null)" href="https://dofocus.fr/forgemagie/" target="_blank" rel="noopener noreferrer" title="Ouvrir le simulateur de DoFocus dans le navigateur">Simulateur FM DoFocus ↗</a>
    </div>
    @if (string.IsNullOrWhiteSpace(ServerName))
    {
        <p class="alert alert-info">Choisissez un serveur en haut pour utiliser ses prix de runes.</p>
    }
    else
    {
        @if (_showOwned)
        {
            <ItemCopyScope>
                <OwnedForgemagingList ServerName="@ServerName"  />
            </ItemCopyScope>
        }
        else
        {
        <p class="small text-secondary" role="status">@(_view?.Status ?? "Le suivi en jeu n’est pas disponible.")</p>
        @if (Busy && _session is null) { <div role="status" class="my-3"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Chargement de l’équipement et des prix…</div> }
        @if (_saveError is not null) { <p class="alert alert-warning" role="alert">@_saveError</p> }
        @if (_session is { } session)
        {
            var history = _latestFirst ? session.Attempts.AsEnumerable().Reverse() : session.Attempts;
            var lastChanges = session.Attempts.LastOrDefault() is { } latest ? Deltas(latest).ToDictionary(d => d.Stat, d => d.Delta) : new Dictionary<Characteristic, int>();
            IEnumerable<ForgemagingLine> shownLines = session.Lines;
            if (_crushPlan?.Next is { } proposed && session.Lines.All(line => line.Characteristic != proposed.Rune.Characteristic))
                shownLines = shownLines.Append(new ForgemagingLine { Characteristic = proposed.Rune.Characteristic, Current = 0 });
            <section class="fm-card fm-station" aria-label="Atelier de forgemagie">
                <header class="fm-session-heading">
                    <div class="fm-item">
                        <MarketItemPicture IconId="@_view?.EquipmentIconId" />
                        <div>
                            <h2>@session.ItemName</h2>
                            <div class="fm-muted">Niv. @session.Level · Jet reçu de Dofus</div>
                            <div class="fm-muted">Dépensé <strong class="fm-spent">@Money(session.KnownSpent)</strong></div>
                            @if (session.UnpricedAttempts > 0)
                            {
                                <div class="fm-warning">@session.UnpricedAttempts tentative(s) sans prix</div>
                            }
                        </div>
                    </div>
                    <div class="fm-header-actions">
                        <label class="fm-budget">Budget
                            <span class="fm-number"><input class="form-control form-control-sm" type="number" min="0" step="1" placeholder="Sans limite"
                                @bind="session.Budget" @bind:after="EditedAsync" disabled="@Busy" /><span>K</span></span>
                        </label>
                        <a class="fm-tool fm-crushing-link" href="@CrushingLink(session)">
                            Voir brisage <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </div>
                </header>
                @if (session.Budget is { } cap && session.KnownSpent >= cap)
                {
                    <p class="fm-warning" role="status">Budget atteint.</p>
                }
                else if (session.Budget is { } budget)
                {
                    <p class="fm-budget-left">Budget restant : @Money(budget - session.KnownSpent)@(session.UnpricedAttempts > 0 ? " au maximum" : "")</p>
                }
                <div class="fm-intent" role="group" aria-label="Objectif de la FM">
                    <label><input type="radio" name="fm-intent" checked="@(!_prepareCrushing)" @onchange="() => { _prepareCrushing = false; Recalculate(); }" /> Atteindre un jet</label>
                    <label><input type="radio" name="fm-intent" checked="@_prepareCrushing" @onchange="() => { _prepareCrushing = true; Recalculate(); }" /> Préparer un concassage</label>
                </div>
                <div class="fm-columns">
                    <aside class="fm-history" aria-label="Historique des tentatives">
                        <div class="fm-history-heading">
                            <h3>Historique</h3>
                            <button type="button" class="fm-tool fm-history-sort" disabled="@(session.Attempts.Count < 2)" @onclick="() => _latestFirst = !_latestFirst"
                                aria-label="@(_latestFirst ? "Afficher les plus anciennes d’abord" : "Afficher les plus récentes d’abord")"
                                title="@(_latestFirst ? "Plus récentes d’abord" : "Plus anciennes d’abord")">
                                <i class="bi @(_latestFirst ? "bi-arrow-down" : "bi-arrow-up")" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="fm-history-summary">
                            <span>@session.Attempts.Count @(session.Attempts.Count == 1 ? "tentative" : "tentatives")</span>
                            @foreach (var outcome in DisplayedOutcomes)
                            {
                                <strong class="@OutcomeClass(outcome)" title="@OutcomeName(outcome)">@session.Attempts.Count(a => a.Outcome == outcome) @OutcomeCode(outcome)</strong>
                            }
                        </div>
                        @if (session.Attempts.Count == 0)
                        {
                            <p class="fm-muted">Aucune tentative enregistrée.</p>
                        }
                        else
                        {
                            <PagedDataTable TItem="ForgemagingAttempt" Items="history" PageSize="20" ResetKey="@($"{ServerName}|{session.ItemId}|{session.GameRecordingId}|{session.Attempts.Count}|{_latestFirst}")">
                                <RowContent Context="attempts">
                                    <ul class="fm-history-list" tabindex="0" aria-label="Résultats des tentatives">
                                        @foreach (var attempt in attempts)
                                        {
                                            var deltas = Deltas(attempt).ToArray();
                                            <li class="fm-attempt @OutcomeClass(attempt.Outcome)">
                                                <div class="fm-attempt-heading" title="@($"{attempt.AtUtc.ToLocalTime():dd/MM HH:mm:ss} · {(attempt.FromGame ? "Reçu du jeu" : "Saisie manuelle")}")">
                                                    <strong class="fm-outcome-code" title="@OutcomeName(attempt.Outcome)" aria-label="@OutcomeName(attempt.Outcome)">@OutcomeCode(attempt.Outcome)</strong>
                                                    <img src="@RuneImage(attempt.Rune)" alt="" width="22" height="22" onerror="this.onerror=null;this.src='img/runes/unknown.svg';" />
                                                    <span>@attempt.Rune.Name@(attempt.RuneCount > 1 ? $" × {attempt.RuneCount}" : "")</span>
                                                </div>
                                                @foreach (var delta in deltas)
                                                {
                                                    <div class="fm-delta @(delta.Delta > 0 ? "gain" : "loss")"><ForgemagingStat Stat="delta.Stat" Value="delta.Delta" ShowSign /></div>
                                                }
                                                @if (deltas.Length == 0) { <div class="fm-attempt-note">@(attempt.Outcome is ForgemagingOutcome.Failure or ForgemagingOutcome.Unconfirmed ? OutcomeName(attempt.Outcome) : "Jet inchangé")</div> }
                                                <div class="fm-attempt-note">
                                                    <span>@Money(attempt.Rune.UnitPrice * attempt.RuneCount)</span>
                                                    @if (attempt.SinkAfter is { } remainder) { <span title="Reliquat après la tentative">Reliquat @remainder.ToString("0.##")</span> }
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </RowContent>
                            </PagedDataTable>
                        }
                    </aside>
                    <div class="fm-roll">
                        <div class="fm-toolbar">
                            @if (!_prepareCrushing)
                            {
                                <RuneExoPicker Runes="_runes" Lines="session.Lines" Selected="AddExtraAsync" Disabled="Busy" />
                            }
                            <label class="fm-sink">Reliquat
                                <input class="form-control form-control-sm" type="number" min="0" step="0.01" placeholder="—"
                                    title="Puits de forgemagie disponible" value="@session.Sink?.ToString(System.Globalization.CultureInfo.InvariantCulture)" readonly />
                            </label>
                        </div>
                        <div class="fm-grid-scroll">
                            <table class="fm-grid" aria-label="Jet et chances estimées par rune">
                                <thead><tr>
                                    <th scope="col">Min</th><th scope="col">Max</th>
                                    <th scope="col">Effets</th>
                                    @if (!_prepareCrushing) { <th scope="col">Objectif</th> }
                                    <th scope="col">Poids</th><th scope="col" title="Modification lors du dernier essai">Modif.</th>
                                    @foreach (var tier in RuneTiers) { <th scope="col">@tier</th> }
                                </tr></thead>
                                <tbody>
                                    @foreach (var line in shownLines)
                                    {
                                        int change = lastChanges.GetValueOrDefault(line.Characteristic);
                                        var name = StatName(line.Characteristic);
                                        var lineRunes = _runes.Where(r => r.Characteristic == line.Characteristic && r.Gain > 0).ToLookup(RuneTier);
                                        <tr @key="line.Characteristic" class="@(change == 0 ? null : change > 0 ? "fm-line-gain" : "fm-line-loss")">
                                            <td class="fm-muted">@line.Minimum</td><td class="fm-muted">@line.Maximum</td>
                                            <th scope="row" class="fm-effect">
                                                <div class="fm-effect-values">
                                                    <span class="@(line.IsNative ? line.Current > line.Maximum ? "fm-over" : null : "fm-exotic")" title="@(line.IsNative ? null : "Exotique")"><ForgemagingStat Stat="line.Characteristic" Value="line.Current" /></span>
                                                </div>
                                            </th>
                                            @if (!_prepareCrushing)
                                            {
                                                <td><input type="number" class="form-control form-control-sm" aria-label="@($"Objectif : {name}")"
                                                    @bind="line.Target" @bind:after="EditedAsync" disabled="@Busy" /></td>
                                            }
                                            <td>@((line.Current * line.Characteristic.GetWeight())?.ToString("0.##") ?? "—")</td>
                                            <td>@if (change != 0) { <span class="fm-modification @(change > 0 ? "gain" : "loss")">@change.ToString("+0;-0")</span> } else { <span class="fm-muted">—</span> }</td>
                                            @for (int tier = 0; tier < RuneTiers.Length; tier++)
                                            {
                                                <td class="fm-rune-cell">
                                                    @foreach (var rune in lineRunes[tier])
                                                    {
                                                        var odds = _validation is null ? ForgemagingPlanner.Evaluate(session.Level, session.Lines, rune) : null;
                                                        bool recommended = (_prepareCrushing ? _crushPlan?.Next?.Rune.Id : _coaching.Next?.Advice.Rune.Id) == rune.Id;
                                                        var tooltip = $"{rune.Name} · +{rune.Gain} {StatName(rune.Characteristic)}";
                                                        <span class="fm-rune-tile @(recommended ? "fm-rune-recommended" : null)" tabindex="0"
                                                              data-bs-toggle="tooltip" data-bs-title="@tooltip" data-bs-custom-class="multiline-tooltip"
                                                              aria-label="@tooltip">
                                                            <span class="fm-rune">
                                                                <img src="@RuneImage(rune)" alt="" width="24" height="24" onerror="this.onerror=null;this.src='img/runes/unknown.svg';" />
                                                                <span class="@($"fm-odds {OutcomeClass(_shownOdds)}")">@(odds is { Blocked: null } ? $"{OddsPercentage(odds):0.#} %" : "—")</span>
                                                            </span>
                                                        </span>
                                                    }
                                                    @if (!lineRunes[tier].Any()) { <span class="fm-muted">—</span> }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="fm-display">
                            <div class="fm-display-options" role="group" aria-label="Pourcentage affiché">
                                <span class="fm-muted">Chances estimées</span>
                                @foreach (var outcome in DisplayedOutcomes)
                                {
                                    <button type="button" class="fm-tool @OutcomeClass(outcome)" aria-pressed="@(_shownOdds == outcome ? "true" : "false")" @onclick="() => _shownOdds = outcome">@OutcomeName(outcome)</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            @if (_prepareCrushing && _crushPlan is { } plan)
            {
                <section class="fm-card fm-next my-3" aria-label="Préparation au concassage">
                    <h3>Prochaine étape</h3>
                    @if (plan.Next is { } step)
                    {
                        <div class="fm-next-action">
                            <img src="@RuneImage(step.Rune)" alt="" width="28" height="28" onerror="this.onerror=null;this.src='img/runes/unknown.svg';" />
                            <strong>@step.Rune.Name</strong>
                            <span class="fm-muted">@Money(step.Rune.UnitPrice) par tentative · @step.Odds.Critical.ToString("N1") % de succès critique estimé</span>
                        </div>
                        <div class="fm-crush-values">
                            <div><span>Concassage actuel</span><strong>@Money(plan.Current!.Value)</strong><span class="small">@FocusName(plan.Current)</span></div>
                            <div><span>Après un succès critique</span><strong>@Money(step.OnCriticalSuccess.Value)</strong><span class="small">@FocusName(step.OnCriticalSuccess)</span></div>
                            <div><span>Gain net estimé par tentative</span><strong>+@Money(step.EstimatedNetGain)</strong></div>
                        </div>
                        <p class="small mt-3 mb-0">@(step.CoveredBySink
                            ? "Le calcul suppose que le reliquat couvre le poids de la rune pour les résultats sans succès critique."
                            : "Le calcul prend l’hypothèse défavorable d’une perte de la valeur actuelle du jet en cas de résultat sans succès critique.") Le conseil est recalculé après chaque tentative.</p>
                    }
                    else
                    {
                        <p class="mt-2 mb-1">@plan.StopReason</p>
                        @if (plan.Current is { } current)
                        {
                            <p class="small fm-muted mb-1">Concassage actuel · @Money(current.Value) · @FocusName(current)</p>
                        }
                    }
                    @foreach (var notice in plan.Notices) { <p class="small text-warning mt-2 mb-0">@notice</p> }
                </section>
            }
            else if (_validation is null && !Complete)
            {
                <section class="fm-card fm-next my-3" aria-label="Conseil adaptatif">
                    <h3>Prochaine étape</h3>
                    @if (_coaching.Next is { } next)
                    {
                        <div class="fm-next-action">
                            <img src="@RuneImage(next.Advice.Rune)" alt="" width="28" height="28" onerror="this.onerror=null;this.src='img/runes/unknown.svg';" />
                            <strong>@next.Advice.Rune.Name</strong>
                            <span class="fm-muted">@next.Stage · @Money(next.Advice.Rune.UnitPrice)</span>
                        </div>
                        <p class="mb-0">@next.Reason</p>
                    }
                    else { <p class="mb-0 mt-2">@_coaching.StopReason</p> }
                    @foreach (var notice in _coaching.Notices) { <p class="small text-secondary mt-2 mb-0">@notice</p> }
                </section>
            }
            else if (_validation is not null) { <p class="alert alert-info mt-3">@_validation</p> }
            else if (Complete) { <p class="alert alert-success mt-3">Le jet actuel atteint tous vos objectifs.</p> }
        }
        }
    }
</section>
