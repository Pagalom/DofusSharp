@page "/profile"
@implements IDisposable
@using BestCrush.Services
@inject CurrentCharacterState CurrentCharacterState
@inject CurrentAccountProfessionsState CurrentAccountProfessionsState
@inject CurrentCandidateWindowCardsState CurrentCandidateWindowCardsState
@inject CurrentDofusClientsState CurrentDofusClientsState
@inject WindowServerAttributionState WindowServerAttributionState

<div class="character-profile-page container-fluid px-1 px-md-3 py-4">
    @{
        // The local title is only a conservative UI visibility hint:
        // selection-screen windows must never display an active character
        // card. Network ownership still comes exclusively from TCP/OS.
        var visibleCandidateSheets = VisibleCandidateSheets;
        var serverLinkedWithoutRoster = ServerLinkedWithoutRoster(visibleCandidateSheets);
    }
    <div class="profile-page-intro">
        <h1>Personnages</h1>
        <p>
            Vos personnages actifs, leurs richesses et leurs métiers.
            Les informations non encore recueillies restent indiquées comme telles.
        </p>
    </div>

    @if (visibleCandidateSheets.Count > 0 ||
         serverLinkedWithoutRoster.Count > 0)
    {
        <section class="profile-sheet-section" aria-label="Fiches temporaires des fenêtres Dofus">
            <div class="profile-section-heading">
                <h2>Fiches de la session</h2>
            </div>
            <div class="profile-sheet-grid">
                @foreach (var (candidate, client) in visibleCandidateSheets)
                {
                    <CharacterSheetCard @key="candidate.Window"
                                        DisplayName="@client.DisplayName"
                                        ClassName="@client.ClassName"
                                        Level="@candidate.SelectedLevelCandidate"
                                        ServerName="@WindowServerAttributionState.ForWindow(client.Key)?.ServerName"
                                        ServerId="@WindowServerAttributionState.ForWindow(client.Key)?.ServerId"
                                        IsExperimental="true"
                                        IsSelected="@(CurrentDofusClientsState.SelectedClient?.Key == client.Key)"
                                        OnSelect="@(() => SelectDofusClient(client.Key))" />
                }
                @foreach (DofusClientWindow client in serverLinkedWithoutRoster)
                {
                    <CharacterSheetCard @key="client.Key"
                                        DisplayName="@client.DisplayName"
                                        ClassName="@client.ClassName"
                                        ServerName="@WindowServerAttributionState.ForWindow(client.Key)?.ServerName"
                                        ServerId="@WindowServerAttributionState.ForWindow(client.Key)?.ServerId"
                                        IsExperimental="true"
                                        IsSelected="@(CurrentDofusClientsState.SelectedClient?.Key == client.Key)"
                                        OnSelect="@(() => SelectDofusClient(client.Key))" />
                }
            </div>
        </section>
    }

    @if (CurrentCharacterState.Characters.Any(profile =>
            CurrentCharacterState.IsCharacterConnected(profile.Key)))
    {
        <section class="profile-sheet-section" aria-label="Fiches de personnages confirmés">
            @if (visibleCandidateSheets.Count > 0 || serverLinkedWithoutRoster.Count > 0)
            {
                <div class="profile-section-heading">
                    <h2>Fiches avec identité vérifiée</h2>
                </div>
            }
            <div class="profile-sheet-grid">
                @foreach (CharacterSessionProfile character in CurrentCharacterState.Characters
                    .Where(profile => CurrentCharacterState.IsCharacterConnected(profile.Key)))
                {
                    <CharacterSheetCard @key="character.Key"
                                        DisplayName="@character.Name"
                                        ClassName="@DofusClassDisplayNames.ForId(character.ClassId)"
                                        Level="@character.Level"
                                        ServerName="@character.Key.ServerName"
                                        PocketKamas="@character.PocketKamas"
                                        BankKamas="@character.BankKamas"
                                        Professions="@CurrentAccountProfessionsState.ForCharacter(character)?.Professions"
                                        IsSelected="@(CurrentCharacterState.ActiveCharacterKey == character.Key)"
                                        OnSelect="@(() => SelectCharacter(character.Key))" />
                }
            </div>
        </section>
    }

    @if (visibleCandidateSheets.Count == 0 &&
         serverLinkedWithoutRoster.Count == 0 &&
         !CurrentCharacterState.Characters.Any(profile =>
             CurrentCharacterState.IsCharacterConnected(profile.Key)))
    {
        <div class="profile-empty" role="status">
            <span class="profile-empty-icon" aria-hidden="true">♜</span>
            <div>
                <strong>Aucun personnage chargé pour le moment</strong>
                <p>Ouvrez un personnage dans Dofus. Sa fiche apparaîtra dès que
                    BestCrush pourra associer sa fenêtre aux messages de chargement.</p>
            </div>
        </div>
    }

    @if (CurrentCandidateWindowCardsState.IsResearchEnabled ||
         serverLinkedWithoutRoster.Count > 0)
    {
        <p class="profile-research-note">
            Association serveur expérimentale issue des messages Connection et
            ksc/ksb. Attention : les prix et coefficients utilisent encore le
            serveur global historique dans ce jalon. Ne pas collecter de
            données économiques de plusieurs serveurs simultanément.
            Les noms/classes proviennent des titres Windows ; les niveaux
            candidats ne sont montrés que lorsqu'ils sont observés.
        </p>
    }
</div>

@code {
    private IReadOnlyList<(CandidateWindowRosterCard Candidate, DofusClientWindow Client)>
        VisibleCandidateSheets =>
            CandidateCharacterSheetVisibility.Visible(
                CurrentCandidateWindowCardsState.Cards,
                CurrentDofusClientsState.Clients);

    private IReadOnlyList<DofusClientWindow> ServerLinkedWithoutRoster(
        IReadOnlyList<(CandidateWindowRosterCard Candidate, DofusClientWindow Client)>
            visibleCandidateSheets)
    {
        HashSet<DofusClientWindowKey> alreadyDisplayed =
            visibleCandidateSheets.Select(pair => pair.Candidate.Window).ToHashSet();
        return CurrentDofusClientsState.Clients
            .Where(client => client.HasCharacterTitle &&
                !alreadyDisplayed.Contains(client.Key) &&
                WindowServerAttributionState.ForWindow(client.Key) is not null)
            .ToArray();
    }

    protected override void OnInitialized()
    {
        CurrentCharacterState.Changed += OnCharacterChanged;
        CurrentCandidateWindowCardsState.Changed += OnCharacterChanged;
        CurrentDofusClientsState.Changed += OnCharacterChanged;
        WindowServerAttributionState.Changed += OnCharacterChanged;
    }

    private void SelectDofusClient(DofusClientWindowKey key)
    {
        CurrentDofusClientsState.SelectWindow(key);
    }

    private void SelectCharacter(CharacterKey key)
    {
        CurrentCharacterState.SelectCharacter(key);
    }

    private void OnCharacterChanged() =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CurrentCharacterState.Changed -= OnCharacterChanged;
        CurrentCandidateWindowCardsState.Changed -= OnCharacterChanged;
        CurrentDofusClientsState.Changed -= OnCharacterChanged;
        WindowServerAttributionState.Changed -= OnCharacterChanged;
    }
}
