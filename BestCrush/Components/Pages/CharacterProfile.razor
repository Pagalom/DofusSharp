@page "/profile"
@implements IDisposable
@inject BestCrush.Services.CurrentCharacterState CurrentCharacterState
@inject BestCrush.Services.CurrentAccountProfessionsState CurrentAccountProfessionsState
@inject BestCrush.Services.CurrentCandidateWindowCardsState CurrentCandidateWindowCardsState
@inject BestCrush.Services.CurrentDofusClientsState CurrentDofusClientsState

<div class="container py-4">
    <h1>Personnages — session actuelle</h1>
    <p class="text-secondary">
        Les fiches sont créées automatiquement quand un personnage est identifié
        de manière fiable. Elles existent uniquement en mémoire et disparaissent
        à la fermeture de BestCrush.
    </p>

    @if (CurrentCandidateWindowCardsState.IsResearchEnabled)
    {
        <section class="mb-4" aria-label="Fenêtres Dofus candidates en mémoire">
            <h2 class="h5">Fenêtres reliées — étude réseau expérimentale</h2>
            <p class="small text-secondary">
                Ces cartes représentent des fenêtres Windows dont les messages
                ksc/ksb sont cohérents. Le nom provient du titre de la fenêtre,
                pas d'une identité réseau confirmée. Aucun compte Ankama,
                serveur réseau ou métier n'est vérifié.
            </p>
            @if (CurrentCandidateWindowCardsState.Cards.Count == 0)
            {
                <p class="text-secondary small">
                    Aucun groupe candidat relié pour le moment.
                    Les cartes n'apparaissent qu'après une liaison réseau.
                </p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-3">
                    @foreach (BestCrush.Services.CandidateWindowRosterCard candidate in CurrentCandidateWindowCardsState.Cards)
                    {
                        @if (CurrentDofusClientsState.Clients.FirstOrDefault(client => client.Key == candidate.Window) is { } client)
                        {
                            <div @key="candidate.Window" class="card" style="min-width: 260px; max-width: 360px;">
                                <div class="card-body">
                                    <h3 class="h6 card-title">@client.DisplayName</h3>
                                    <p class="small text-secondary mb-2">
                                        Fenêtre Dofus détectée localement — groupe candidat, non vérifié
                                    </p>
                                    <p class="small mb-2">
                                        Personnages candidats dans la liste : @candidate.CandidateCount
                                    </p>
                                    <p class="small mb-3">
                                        Classe d'après le titre : @(client.ClassName ?? "Inconnue")
                                    </p>
                                    <button type="button"
                                            class="btn btn-sm @(CurrentDofusClientsState.SelectedClient?.Key == client.Key ? "btn-secondary" : "btn-outline-primary")"
                                            @onclick="() => SelectDofusClient(client.Key)">
                                        @(CurrentDofusClientsState.SelectedClient?.Key == client.Key ? "Fenêtre ciblée" : "Cibler cette fenêtre")
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            <p class="small text-secondary mt-2">
                Fermeture de la fenêtre : suppression de cette carte, même sans nouveau paquet réseau.
                Aucune donnée de ces groupes n'est écrite dans les profils ou les métiers.
            </p>
        </section>
    }

    @if (CurrentCharacterState.ServerName is null)
    {
        <div class="alert alert-info" role="status">
            Aucun serveur sélectionné. Le contexte personnage reste indéterminé.
        </div>
    }
    else if (CurrentCharacterState.Characters.Count == 0)
    {
        <div class="alert alert-secondary" role="status">
            Aucun personnage identifié sur @CurrentCharacterState.ServerName.
            L'identification réseau et la lecture des inventaires
            nécessitent encore la validation du protocole Dofus.
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap gap-3">
            @foreach (BestCrush.Services.CharacterSessionProfile character in CurrentCharacterState.Characters)
            {
                <div class="card" style="min-width: 260px; max-width: 360px;">
                    <div class="card-body">
                        <h2 class="h5 card-title">@character.Name</h2>
                        <p class="small text-secondary">Serveur : @character.Key.ServerName</p>
                        <p class="small mb-2">
                            Niveau : @(character.Level?.ToString() ?? "Non observé")
                            | Classe : @(character.ClassId?.ToString() ?? "Non observée")
                        </p>
                        <p class="small mb-2">
                            Kamas en poche : @(character.PocketKamas?.ToString("N0") ?? "Non observés")
                        </p>
                        <p class="small mb-2">
                            Kamas en banque : @(character.BankKamas?.ToString("N0") ?? "Non observés")
                        </p>
                        <p class="small mb-2">
                            Inventaire : @(character.Inventory is null ? "Non observé" : $"{character.Inventory.Count} lignes")
                        </p>
                        <p class="small mb-2">
                            Banque : @(character.BankInventory is null ? "Non observée" : $"{character.BankInventory.Count} lignes")
                        </p>
                        <section class="mb-3" aria-label="Métiers partagés du compte">
                            <h3 class="h6">Métiers (compte + serveur)</h3>
                            @if (CurrentAccountProfessionsState.ForCharacter(character) is { } sharedProfessions)
                            {
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th scope="col">Métier</th>
                                            <th scope="col">Niveau</th>
                                            <th scope="col">XP cumulée</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (BestCrush.Services.AccountProfessionProgress profession in sharedProfessions.Professions.OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase))
                                        {
                                            <tr>
                                                <td>@profession.Name</td>
                                                <td>@profession.Level</td>
                                                <td>@profession.CumulativeExperience.ToString("N0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="small text-secondary">
                                    Non disponibles : compte et serveur non vérifiés.
                                    Les métiers sont partagés, pas propres au personnage.
                                </p>
                            }
                        </section>
                        <button class="btn btn-sm @(CurrentCharacterState.ActiveCharacterKey == character.Key ? "btn-secondary" : "btn-outline-primary")"
                                type="button"
                                disabled="@(!CurrentCharacterState.IsCharacterConnected(character.Key))"
                                @onclick="() => SelectCharacter(character.Key)">
                            @(CurrentCharacterState.ActiveCharacterKey == character.Key ? "Personnage ciblé" : "Cibler ce personnage")
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <p class="text-secondary mt-4">
        La sélection automatique suivra la fenêtre Dofus ciblée après
        validation de la détection réseau. Le choix manuel reste possible
        parmi les personnages détectés durant cette session.
    </p>
</div>

@code {
    protected override void OnInitialized()
    {
        CurrentCharacterState.Changed += OnCharacterChanged;
        CurrentCandidateWindowCardsState.Changed += OnCharacterChanged;
        CurrentDofusClientsState.Changed += OnCharacterChanged;
    }

    private void SelectDofusClient(BestCrush.Services.DofusClientWindowKey key)
    {
        CurrentDofusClientsState.SelectWindow(key);
    }

    private void SelectCharacter(BestCrush.Services.CharacterKey key)
    {
        CurrentCharacterState.SelectCharacter(key);
    }

    private void OnCharacterChanged() =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CurrentCharacterState.Changed -= OnCharacterChanged;
        CurrentCandidateWindowCardsState.Changed -= OnCharacterChanged;
        CurrentDofusClientsState.Changed -= OnCharacterChanged;
    }
}
