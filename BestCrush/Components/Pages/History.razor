@page "/servers/{ServerName}/history"

@inject HistoryService HistoryService
@inject ItemsService ItemsService
@inject RunesService RunesService
@inject MarketAnalyticsService MarketAnalyticsService
@inject BestCrush.Services.MarketAnalyticsPresetService MarketAnalyticsPresetService

@using BestCrush.Components.Pure
@using BestCrush.Domain.Models
@using BestCrush.Domain.Services
@using BestCrush.Models
@using Rune = BestCrush.Domain.Models.Rune

<div class="container history-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-1">Historique</h2>
            <div class="text-secondary">Serveur : @ServerName</div>
        </div>

        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@_loading"
                    @onclick="RefreshAsync">
                Rafraîchir
            </button>

            <a class="btn btn-outline-secondary"
               href="@BestCrush.Components.KnownRoutes.Server(ServerName)">
                Retour
            </a>
        </div>
    </div>

    <div class="history-tabs mb-3">
        <button type="button"
                class="@TabClass(HistoryTab.Resources)"
                @onclick="() => SelectTabAsync(HistoryTab.Resources)">
            Ressources
        </button>
        <button type="button"
                class="@TabClass(HistoryTab.Items)"
                @onclick="() => SelectTabAsync(HistoryTab.Items)">
            Items
        </button>
        <button type="button"
                class="@TabClass(HistoryTab.Runes)"
                @onclick="() => SelectTabAsync(HistoryTab.Runes)">
            Runes
        </button>
        <button type="button"
                class="@TabClass(HistoryTab.Crushes)"
                @onclick="() => SelectTabAsync(HistoryTab.Crushes)">
            Concassages
        </button>
        <button type="button"
                class="@TabClass(HistoryTab.Analytics)"
                @onclick="() => SelectTabAsync(HistoryTab.Analytics)">
            Analyses
        </button>
    </div>

    @if (_tab != HistoryTab.Analytics)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-lg">
                        <label class="form-label small text-secondary mb-1">Recherche</label>
                        <input class="form-control"
                               placeholder="Nom d'objet ou de rune..."
                               @bind="_searchText" />
                    </div>

                    @if (_tab != HistoryTab.Crushes)
                    {
                        <div class="col-6 col-md-3 col-lg-2">
                            <label class="form-label small text-secondary mb-1">Niveau min.</label>
                            <input type="number"
                                   min="0"
                                   max="200"
                                   class="form-control"
                                   @bind="_levelMin" />
                        </div>
                        <div class="col-6 col-md-3 col-lg-2">
                            <label class="form-label small text-secondary mb-1">Niveau max.</label>
                            <input type="number"
                                   min="0"
                                   max="200"
                                   class="form-control"
                                   @bind="_levelMax" />
                        </div>
                    }

                    @if (_tab == HistoryTab.Items)
                    {
                        <div class="col-12 col-md-6 col-lg-3">
                            <label class="form-label small text-secondary mb-1">Type d'équipement</label>
                            <select class="form-select"
                                    value="@(_equipmentType?.ToString() ?? string.Empty)"
                                    @onchange="OnEquipmentTypeChanged">
                                <option value="">Tous les types</option>
                                @foreach (EquipmentType type in Enum.GetValues<EquipmentType>())
                                {
                                    <option value="@type">@type.ToDisplayName()</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="col-auto">
                        <button type="button"
                                class="btn btn-primary"
                                disabled="@_loading"
                                @onclick="ApplyFiltersAsync">
                            Filtrer
                        </button>
                    </div>
                    <div class="col-auto">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                disabled="@_loading"
                                @onclick="ResetFiltersAsync">
                            Réinitialiser
                        </button>
                    </div>
                </div>

                @if (_tab == HistoryTab.Items || _tab == HistoryTab.Crushes)
                {
                    <div class="history-secondary-filter mt-3 pt-3 border-top">
                        <div class="small text-secondary mb-2">
                            @(_tab == HistoryTab.Items ? "Rune obtenable" : "Rune obtenue")
                        </div>

                        <div class="position-relative history-rune-filter-wrap">
                            <button type="button"
                                    class="btn btn-outline-secondary history-rune-filter-button"
                                    @onclick="ToggleRunePicker">
                                @if (SelectedFilterRune is Rune selectedRune)
                                {
                                    <span class="d-flex align-items-center gap-2">
                                        <ItemIcon Item="selectedRune"
                                                  Background="IconBackground.Slot"
                                                  Size="Size.Tiny" />
                                        <span>@selectedRune.Name</span>
                                    </span>
                                }
                                else
                                {
                                    <span>Toutes les runes</span>
                                }
                            </button>

                            @if (_runePickerOpen)
                            {
                                <div class="history-rune-picker shadow">
                                    <button type="button"
                                            class="history-rune-option"
                                            @onclick="() => SelectRuneFilterAsync(null)">
                                        <span class="history-empty-icon"></span>
                                        <span>Toutes les runes</span>
                                    </button>

                                    @foreach (Rune rune in _runes)
                                    {
                                        <button type="button"
                                                class="history-rune-option"
                                                @onclick="() => SelectRuneFilterAsync(rune.DofusDbId)">
                                            <ItemIcon Item="rune"
                                                      Background="IconBackground.Slot"
                                                      Size="Size.Tiny" />
                                            <span>@rune.Name</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-xl-3">
                        <label class="form-label small text-secondary mb-1">Analyse enregistrée</label>
                        <select class="form-select"
                                value="@(_selectedAnalyticsPresetId?.ToString() ?? string.Empty)"
                                @onchange="OnAnalyticsPresetChangedAsync">
                            <option value="">Nouvelle analyse</option>
                            @foreach (MarketAnalyticsPreset preset in _analyticsPresets)
                            {
                                <option value="@preset.Id">@preset.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-xl-3">
                        <label class="form-label small text-secondary mb-1">Nom</label>
                        <input class="form-control"
                               placeholder="Ex. Analyse Sagesse"
                               @bind="_analyticsName"
                               @bind:event="oninput" />
                    </div>

                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label small text-secondary mb-1">Période</label>
                        <select class="form-select"
                                value="@_analyticsPeriod"
                                @onchange="OnAnalyticsPeriodChangedAsync">
                            <option value="@MarketAnalyticsPeriod.Hours24">24 h</option>
                            <option value="@MarketAnalyticsPeriod.Days7">7 jours</option>
                            <option value="@MarketAnalyticsPeriod.Days30">30 jours</option>
                            <option value="@MarketAnalyticsPeriod.All">Tout</option>
                        </select>
                    </div>

                    <div class="col-12 col-xl">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled="@_loading"
                                    @onclick="NewAnalyticsAsync">
                                Nouveau
                            </button>
                            <button type="button"
                                    class="btn btn-primary"
                                    disabled="@_loading"
                                    title="Crée l'analyse si elle est nouvelle, sinon met à jour le preset sélectionné. Le nom peut être modifié avant l'enregistrement."
                                    @onclick="() => SaveAnalyticsPresetAsync(false)">
                                Enregistrer
                            </button>
                            <button type="button"
                                    class="btn btn-outline-primary"
                                    disabled="@_loading"
                                    @onclick="() => SaveAnalyticsPresetAsync(true)">
                                Enregistrer sous
                            </button>
                            <button type="button"
                                    class="btn btn-outline-danger"
                                    disabled="@(_loading || _selectedAnalyticsPresetId is null)"
                                    @onclick="DeleteAnalyticsPresetAsync">
                                Supprimer
                            </button>
                        </div>
                    </div>
                </div>

                @if (_selectedAnalyticsPresetId is not null && AnalyticsPresetIsModified)
                {
                    <div class="mt-2">
                        <span class="badge text-bg-warning">Analyse modifiée</span>
                    </div>
                }

                <div class="small text-secondary mt-2">
                    Les analyses enregistrées sont globales : elles peuvent être réappliquées à l'identique sur le serveur sélectionné avec les données du moment.
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h5 class="mb-0">Séries</h5>
                <div class="small text-secondary">
                    Un même élément peut être ajouté plusieurs fois avec des calculs différents.
                </div>
            </div>

            <button type="button"
                    class="btn btn-primary"
                    disabled="@(_loading || _analyticsDraft is not null)"
                    @onclick="BeginAddAnalyticsSeries">
                + Ajouter une série
            </button>
        </div>

        @if (_analyticsDraft is MarketAnalyticsSeriesDefinition draft)
        {
            <div class="card mb-3">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                        <h6 class="mb-0">
                            @(_editingAnalyticsSeriesId is null
                                ? "Ajouter une série"
                                : "Modifier la série")
                        </h6>
                        <button type="button"
                                class="btn-close"
                                aria-label="Annuler"
                                @onclick="CancelAnalyticsSeriesDraft"></button>
                    </div>

                    <div class="row g-2 align-items-end">
                        <div class="col-6 col-lg-2">
                            <label class="form-label small text-secondary mb-1">Type</label>
                            <select class="form-select form-select-sm"
                                    value="@draft.ObjectType"
                                    @onchange="OnAnalyticsDraftObjectTypeChanged">
                                <option value="@MarketObjectType.Rune">Rune</option>
                                <option value="@MarketObjectType.Resource">Ressource</option>
                                <option value="@MarketObjectType.Equipment">Équipement</option>
                            </select>
                        </div>

                        <div class="col-12 col-lg-4">
                            <label class="form-label small text-secondary mb-1">Élément</label>
                            <select class="form-select form-select-sm"
                                    value="@draft.DofusDbId"
                                    @onchange="OnAnalyticsDraftItemChanged">
                                @foreach (AnalyticsCatalogItem item in GetAnalyticsCatalogItems(draft.ObjectType))
                                {
                                    <option value="@item.DofusDbId">@item.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-6 col-md-3 col-lg-2">
                            <label class="form-label small text-secondary mb-1">Lots</label>
                            <select class="form-select form-select-sm"
                                    value="@(draft.LotQuantity?.ToString() ?? string.Empty)"
                                    @onchange="OnAnalyticsDraftLotChanged">
                                <option value="">Tous</option>
                                <option value="1">x1</option>
                                @if (draft.ObjectType != MarketObjectType.Equipment)
                                {
                                    <option value="10">x10</option>
                                    <option value="100">x100</option>
                                    <option value="1000">x1000</option>
                                }
                            </select>
                        </div>

                        <div class="col-6 col-md-3 col-lg-2">
                            <label class="form-label small text-secondary mb-1">Valeur</label>
                            <select class="form-select form-select-sm"
                                    value="@draft.ValueMode"
                                    @onchange="OnAnalyticsDraftValueModeChanged">
                                <option value="@MarketAnalyticsValueMode.UnitPrice">Prix unitaire</option>
                                <option value="@MarketAnalyticsValueMode.LotPrice"
                                        disabled="@(draft.LotQuantity is null)">
                                    Prix du lot
                                </option>
                            </select>
                        </div>

                        <div class="col-6 col-md-3 col-lg-2">
                            <label class="form-label small text-secondary mb-1">Agrégation</label>
                            <select class="form-select form-select-sm"
                                    value="@draft.Aggregation"
                                    @onchange="OnAnalyticsDraftAggregationChanged">
                                <option value="@MarketAnalyticsAggregation.Median">Médiane</option>
                                <option value="@MarketAnalyticsAggregation.Mean">Moyenne</option>
                                <option value="@MarketAnalyticsAggregation.FirstQuartile">1er quartile (Q1)</option>
                                <option value="@MarketAnalyticsAggregation.ThirdQuartile">3e quartile (Q3)</option>
                            </select>
                        </div>

                        <div class="col-6 col-md-3 col-lg-2">
                            <label class="form-label small text-secondary mb-1">Source</label>
                            <select class="form-select form-select-sm"
                                    value="@draft.SourceMode"
                                    @onchange="OnAnalyticsDraftSourceChanged">
                                <option value="@MarketAnalyticsSourceMode.InGameAutomatic">Jeu</option>
                                <option value="@MarketAnalyticsSourceMode.Manual">Manuel</option>
                                <option value="@MarketAnalyticsSourceMode.All">Toutes</option>
                            </select>
                        </div>

                        <div class="col-6 col-md-3 col-lg-2">
                            <label class="form-label small text-secondary mb-1">Transformation</label>
                            <select class="form-select form-select-sm"
                                    value="@draft.Transformation"
                                    @onchange="OnAnalyticsDraftTransformationChanged">
                                <option value="@MarketAnalyticsTransformation.Raw">Valeur brute</option>
                                <option value="@MarketAnalyticsTransformation.Base100">Base 100</option>
                            </select>
                        </div>

                        <div class="col-auto ms-lg-auto">
                            <div class="d-flex gap-2">
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm"
                                        @onclick="CancelAnalyticsSeriesDraft">
                                    Annuler
                                </button>
                                <button type="button"
                                        class="btn btn-primary btn-sm"
                                        disabled="@_loading"
                                        @onclick="CommitAnalyticsSeriesDraftAsync">
                                    @(_editingAnalyticsSeriesId is null
                                        ? "Ajouter la série"
                                        : "Enregistrer les modifications")
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (draft.LotQuantity is null)
                    {
                        <div class="small text-secondary mt-2">
                            Tous les lots sont comparés après conversion en prix unitaire.
                        </div>
                    }
                </div>
            </div>
        }

        @if (_analyticsSeries.Count == 0 && _analyticsDraft is null)
        {
            <div class="alert alert-secondary">
                Ajoute une série pour commencer l'analyse.
            </div>
        }
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }

    @if (_loading)
    {
        <div class="text-center py-5 text-secondary">
            Chargement de l'historique…
        </div>
    }
    else
    {
        @if (_tab == HistoryTab.Analytics)
        {
            <MarketAnalyticsChart Definitions="_analyticsSeries"
                                  Series="_analyticsResults"
                                  Resources="_resources"
                                  Equipments="_equipments"
                                  Runes="_runesById"
                                  EditRequested="BeginEditAnalyticsSeries"
                                  RemoveRequested="RemoveAnalyticsSeriesAsync" />
        }
        else if (_tab == HistoryTab.Resources || _tab == HistoryTab.Runes)
        {
                IReadOnlyList<MarketHistoryRow> rows =
                    _marketHistory?.Rows ?? [];

                <div class="table-responsive history-table-wrap">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <button class="@SortButtonClass(HistorySortColumn.Date)"
                                            @onclick="() => SortByAsync(HistorySortColumn.Date)">
                                        Date @SortIndicator(HistorySortColumn.Date)
                                    </button>
                                </th>
                                <th>
                                    <button class="@SortButtonClass(HistorySortColumn.Name)"
                                            @onclick="() => SortByAsync(HistorySortColumn.Name)">
                                        Nom @SortIndicator(HistorySortColumn.Name)
                                    </button>
                                </th>
                                <th class="text-end">
                                    <button class="@SortButtonClass(HistorySortColumn.Level)"
                                            @onclick="() => SortByAsync(HistorySortColumn.Level)">
                                        Niveau @SortIndicator(HistorySortColumn.Level)
                                    </button>
                                </th>
                                <th class="text-end">
                                    <button class="@SortButtonClass(HistorySortColumn.Quantity)"
                                            @onclick="() => SortByAsync(HistorySortColumn.Quantity)">
                                        Lot @SortIndicator(HistorySortColumn.Quantity)
                                    </button>
                                </th>
                                <th class="text-end">
                                    <button class="@SortButtonClass(HistorySortColumn.Value)"
                                            @onclick="() => SortByAsync(HistorySortColumn.Value)">
                                        Prix @SortIndicator(HistorySortColumn.Value)
                                    </button>
                                </th>
                                <th>
                                    <button class="@SortButtonClass(HistorySortColumn.Source)"
                                            @onclick="() => SortByAsync(HistorySortColumn.Source)">
                                        Source @SortIndicator(HistorySortColumn.Source)
                                    </button>
                                </th>
                                <th>État</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (rows.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-secondary py-4">
                                        Aucune observation ne correspond aux filtres.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (MarketHistoryRow row in rows)
                                {
                                    <tr class="@(row.IsCleared ? "history-cleared-row" : null)">
                                        <td class="text-nowrap">@FormatDate(row.ObservedAtUtc)</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (GetMarketItem(row) is IItem item)
                                                {
                                                    <ItemIcon Item="item"
                                                              Background="IconBackground.Slot"
                                                              Size="Size.Tiny" />
                                                }
                                                <span class="fw-semibold">@row.Name</span>
                                            </div>
                                        </td>
                                        <td class="text-end">@row.Level</td>
                                        <td class="text-end">x@row.Quantity</td>
                                        <td class="text-end text-nowrap">
                                            @(row.IsCleared ? "—" : $"{row.Price:N0} K")
                                        </td>
                                        <td>@FormatMarketSource(row.Source)</td>
                                        <td>
                                            @if (row.IsCleared)
                                            {
                                                <span class="badge text-bg-secondary">Supprimé</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-success">Enregistré</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
        }
        else if (_tab == HistoryTab.Items)
        {
                IReadOnlyList<ItemHistoryRow> rows =
                    _itemHistory?.Rows ?? [];

                <div class="table-responsive history-table-wrap">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <button class="@SortButtonClass(HistorySortColumn.Date)"
                                            @onclick="() => SortByAsync(HistorySortColumn.Date)">
                                        Date @SortIndicator(HistorySortColumn.Date)
                                    </button>
                                </th>
                                <th>
                                    <button class="@SortButtonClass(HistorySortColumn.Name)"
                                            @onclick="() => SortByAsync(HistorySortColumn.Name)">
                                        Item @SortIndicator(HistorySortColumn.Name)
                                    </button>
                                </th>
                                <th class="text-end">
                                    <button class="@SortButtonClass(HistorySortColumn.Level)"
                                            @onclick="() => SortByAsync(HistorySortColumn.Level)">
                                        Niveau @SortIndicator(HistorySortColumn.Level)
                                    </button>
                                </th>
                                <th>
                                    <button class="@SortButtonClass(HistorySortColumn.Type)"
                                            @onclick="() => SortByAsync(HistorySortColumn.Type)">
                                        Type @SortIndicator(HistorySortColumn.Type)
                                    </button>
                                </th>
                                <th>
                                    <button class="@SortButtonClass(HistorySortColumn.DataKind)"
                                            @onclick="() => SortByAsync(HistorySortColumn.DataKind)">
                                        Donnée @SortIndicator(HistorySortColumn.DataKind)
                                    </button>
                                </th>
                                <th class="text-end">
                                    <button class="@SortButtonClass(HistorySortColumn.Value)"
                                            @onclick="() => SortByAsync(HistorySortColumn.Value)">
                                        Valeur @SortIndicator(HistorySortColumn.Value)
                                    </button>
                                </th>
                                <th>
                                    <button class="@SortButtonClass(HistorySortColumn.Source)"
                                            @onclick="() => SortByAsync(HistorySortColumn.Source)">
                                        Source @SortIndicator(HistorySortColumn.Source)
                                    </button>
                                </th>
                                <th>État</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (rows.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-secondary py-4">
                                        Aucune observation ne correspond aux filtres.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (ItemHistoryRow row in rows)
                                {
                                    <tr class="@(row.IsCleared ? "history-cleared-row" : null)">
                                        <td class="text-nowrap">@FormatDate(row.ObservedAtUtc)</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (_equipments.GetValueOrDefault(row.DofusDbId) is Equipment equipment)
                                                {
                                                    <ItemIcon Item="equipment"
                                                              Background="IconBackground.Slot"
                                                              Size="Size.Tiny" />
                                                }
                                                <span class="fw-semibold">@row.Name</span>
                                            </div>
                                        </td>
                                        <td class="text-end">@row.Level</td>
                                        <td>@row.Type.ToDisplayName()</td>
                                        <td>@FormatDataKind(row.DataKind)</td>
                                        <td class="text-end text-nowrap">@FormatItemValue(row)</td>
                                        <td>@FormatItemSource(row)</td>
                                        <td>
                                            @if (row.IsCleared)
                                            {
                                                <span class="badge text-bg-secondary">Supprimé</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-success">Enregistré</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
        }
        else
        {
                IReadOnlyList<CrushHistorySession> rows =
                    _crushHistory?.Rows ?? [];

                <div class="history-crush-list">
                    <div class="history-crush-header d-none d-lg-grid">
                        <div>
                            <button class="@SortButtonClass(HistorySortColumn.Date)"
                                    @onclick="() => SortByAsync(HistorySortColumn.Date)">
                                Date @SortIndicator(HistorySortColumn.Date)
                            </button>
                        </div>
                        <div>
                            <button class="@SortButtonClass(HistorySortColumn.Name)"
                                    @onclick="() => SortByAsync(HistorySortColumn.Name)">
                                Items @SortIndicator(HistorySortColumn.Name)
                            </button>
                        </div>
                        <div>
                            <button class="@SortButtonClass(HistorySortColumn.Rune)"
                                    @onclick="() => SortByAsync(HistorySortColumn.Rune)">
                                Runes @SortIndicator(HistorySortColumn.Rune)
                            </button>
                        </div>
                        <div class="text-end">
                            <button class="@SortButtonClass(HistorySortColumn.Quantity)"
                                    @onclick="() => SortByAsync(HistorySortColumn.Quantity)">
                                Quantité @SortIndicator(HistorySortColumn.Quantity)
                            </button>
                        </div>
                        <div class="text-end">
                            <button class="@SortButtonClass(HistorySortColumn.Value)"
                                    @onclick="() => SortByAsync(HistorySortColumn.Value)">
                                Valeur @SortIndicator(HistorySortColumn.Value)
                            </button>
                        </div>
                        <div></div>
                    </div>

                    @if (rows.Count == 0)
                    {
                        <div class="text-center text-secondary py-5 border rounded">
                            Aucun concassage ne correspond aux filtres.
                        </div>
                    }
                    else
                    {
                        @foreach (CrushHistorySession session in rows)
                        {
                            bool expanded = _expandedSessions.Contains(session.Id);
                            int totalQuantity = session.Runes.Sum(rune => rune.Quantity);

                            <div class="history-crush-card">
                                <div class="history-crush-summary">
                                    <div>
                                        <div class="history-mobile-label">Date</div>
                                        <div class="text-nowrap">@FormatDate(session.CompletedAtUtc)</div>
                                    </div>

                                    <div>
                                        <div class="history-mobile-label">Items</div>
                                        <div class="d-flex flex-wrap align-items-center gap-1">
                                            @foreach (CrushHistoryEquipment equipmentLine in session.Equipments.OrderBy(e => e.RowY))
                                            {
                                                <div class="history-icon-token" title="@equipmentLine.EquipmentName">
                                                    @if (_equipments.GetValueOrDefault(equipmentLine.DofusDbId) is Equipment equipment)
                                                    {
                                                        <ItemIcon Item="equipment"
                                                                  Background="IconBackground.Slot"
                                                                  Size="Size.Tiny" />
                                                    }
                                                    <span>@equipmentLine.EquipmentName</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div>
                                        <div class="history-mobile-label">Runes</div>
                                        <div class="d-flex flex-wrap align-items-center gap-1">
                                            @foreach (CrushHistoryRune runeLine in session.Runes.OrderBy(r => r.RuneName))
                                            {
                                                <div class="history-icon-token" title="@runeLine.RuneName">
                                                    @if (_runesById.GetValueOrDefault(runeLine.DofusDbId) is Rune rune)
                                                    {
                                                        <ItemIcon Item="rune"
                                                                  Background="IconBackground.Slot"
                                                                  Size="Size.Tiny" />
                                                    }
                                                    <span>@runeLine.RuneName</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="text-lg-end">
                                        <div class="history-mobile-label">Quantité</div>
                                        <strong>@totalQuantity.ToString("N0")</strong>
                                    </div>

                                    <div class="text-lg-end">
                                        <div class="history-mobile-label">Valeur</div>
                                            @if (session.DiscountedTotalValue.HasValue)
                                            {
                                                <strong>@FormatKamas(session.DiscountedTotalValue.Value)</strong>

                                                <div class="small text-secondary">
                                                    Brute : @FormatKamas(session.TotalValue)
                                                    • -@session.DiscountPercent.ToString("0.##") %
                                                </div>
                                            }
                                        else
                                        {
                                            <strong>@FormatKamas(session.TotalValue)</strong>
                                            <div class="small text-secondary">Décote non enregistrée</div>
                                        }
                                    </div>

                                    <div class="text-lg-end">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                title="Afficher les détails"
                                                @onclick="() => ToggleSession(session.Id)">
                                            @(expanded ? "▼" : "▶")
                                        </button>
                                    </div>
                                </div>

                                @if (expanded)
                                {
                                    <div class="history-crush-details border-top">
                                        <div class="row g-4">
                                            <div class="col-12 col-xl-5">
                                                <h6>Équipements</h6>
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (CrushHistoryEquipment equipmentLine in session.Equipments.OrderBy(e => e.RowY))
                                                    {
                                                        <div class="d-flex align-items-center justify-content-between gap-3 history-detail-line">
                                                            <div class="d-flex align-items-center gap-2 min-w-0">
                                                                @if (_equipments.GetValueOrDefault(equipmentLine.DofusDbId) is Equipment equipment)
                                                                {
                                                                    <ItemIcon Item="equipment"
                                                                              Background="IconBackground.Slot"
                                                                              Size="Size.Tiny" />
                                                                }
                                                                <span class="text-truncate">@equipmentLine.EquipmentName</span>
                                                            </div>
                                                            <div class="text-end text-nowrap">
                                                                <strong>@equipmentLine.CoefficientPercent.ToString("0.##") %</strong>
                                                                <div class="small text-secondary">@FormatCoefficientSource(equipmentLine.CoefficientSource)</div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div class="col-12 col-xl-7">
                                                <h6>Runes obtenues</h6>
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (CrushHistoryRune runeLine in session.Runes.OrderBy(r => r.RuneName))
                                                    {
                                                        <div class="history-rune-detail">
                                                            <div class="d-flex align-items-center justify-content-between gap-3">
                                                                <div class="d-flex align-items-center gap-2 min-w-0">
                                                                    @if (_runesById.GetValueOrDefault(runeLine.DofusDbId) is Rune rune)
                                                                    {
                                                                        <ItemIcon Item="rune"
                                                                                  Background="IconBackground.Slot"
                                                                                  Size="Size.Tiny" />
                                                                    }
                                                                    <div>
                                                                        <div class="fw-semibold">@runeLine.RuneName</div>
                                                                        <div class="small text-secondary">×@(runeLine.Quantity.ToString("N0"))</div>
                                                                    </div>
                                                                </div>
                                                                <strong class="text-nowrap">@FormatKamas(runeLine.Value)</strong>
                                                            </div>

                                                            @if (runeLine.Lots.Count > 0)
                                                            {
                                                                <div class="history-lots mt-2">
                                                                    @foreach (CrushHistoryRuneLot lot in runeLine.Lots.OrderByDescending(l => l.LotQuantity))
                                                                    {
                                                                        <div class="small d-flex flex-wrap justify-content-between gap-2">
                                                                            <span>
                                                                                @(lot.Count.ToString("N0"))×@(lot.LotQuantity)
                                                                                = @((lot.Count * lot.LotPrice).ToString("N0")) K
                                                                            </span>
                                                                            <span class="text-secondary">
                                                                                @lot.LotPrice.ToString("N0") K / lot
                                                                                @if (lot.IsEstimated)
                                                                                {
                                                                                    <span> • estimé</span>
                                                                                }
                                                                                @if (lot.PriceSource is MarketPriceSource source)
                                                                                {
                                                                                    <span> • @FormatMarketSource(source)</span>
                                                                                }
                                                                                @if (lot.PriceObservedAtUtc is DateTime observedAt)
                                                                                {
                                                                                    <span> • @FormatDate(observedAt)</span>
                                                                                }
                                                                            </span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-end mt-3 pt-3 border-top">
                                            <div class="text-end">
                                                <div class="small text-secondary">Valeurs figées à la date du concassage</div>
                                                <div>
                                                    Valeur brute :
                                                    <strong>@FormatKamas(session.TotalValue)</strong>
                                                </div>

                                                    @if (session.DiscountedTotalValue.HasValue)
                                                    {
                                                        <div class="fs-5 fw-bold">
                                                            Valeur ajustée (-@session.DiscountPercent.ToString("0.##") %) :
                                                            @FormatKamas(session.DiscountedTotalValue.Value)
                                                        </div>
                                                    }
                                                else
                                                {
                                                    <div class="small text-secondary">
                                                        Décote non enregistrée pour cette ancienne session
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
        }

        @if (CurrentHasMore)
        {
            <div class="d-flex justify-content-center my-4">
                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="LoadMoreAsync">
                    Charger @PageIncrement entrées de plus
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string ServerName { get; set; } = string.Empty;

    private const int InitialTake = 100;
    private const int PageIncrement = 100;

    private HistoryTab _tab = HistoryTab.Resources;
    private HistorySortColumn _sortColumn = HistorySortColumn.Date;
    private HistorySortDirection _sortDirection = HistorySortDirection.Descending;

    private string? _searchText;
    private int? _levelMin;
    private int? _levelMax;
    private EquipmentType? _equipmentType;
    private long? _itemRuneFilterId;
    private long? _crushRuneFilterId;
    private bool _runePickerOpen;

    private int _take = InitialTake;
    private bool _loading;
    private string? _errorMessage;

    private HistoryPage<MarketHistoryRow>? _marketHistory;
    private HistoryPage<ItemHistoryRow>? _itemHistory;
    private HistoryPage<CrushHistorySession>? _crushHistory;

    private Dictionary<long, Resource> _resources = [];
    private Dictionary<long, Equipment> _equipments = [];
    private Dictionary<long, Rune> _runesById = [];
    private List<Rune> _runes = [];

    private List<MarketAnalyticsPreset> _analyticsPresets = [];
    private Guid? _selectedAnalyticsPresetId;
    private string _analyticsName = "Nouvelle analyse";
    private MarketAnalyticsPeriod _analyticsPeriod = MarketAnalyticsPeriod.Days7;
    private List<MarketAnalyticsSeriesDefinition> _analyticsSeries = [];
    private IReadOnlyList<MarketAnalyticsSeriesResult> _analyticsResults = [];
    private MarketAnalyticsSeriesDefinition? _analyticsDraft;
    private Guid? _editingAnalyticsSeriesId;

    private HashSet<Guid> _expandedSessions = [];

    protected override async Task OnInitializedAsync()
    {
        LoadAnalyticsPresets();
        await LoadCatalogsAsync();
        await LoadCurrentAsync();
    }

    private async Task LoadCatalogsAsync()
    {
        IReadOnlyCollection<Resource> resources =
            await ItemsService.GetResourcesAsync();

        IReadOnlyCollection<Equipment> equipments =
            await ItemsService.GetAllEquipmentsAsync();

        IReadOnlyCollection<Rune> runes =
            await RunesService.GetLocalRunesAsync();

        _resources = resources.ToDictionary(item => item.DofusDbId);
        _equipments = equipments.ToDictionary(item => item.DofusDbId);
        _runes = runes.OrderBy(rune => rune.Name).ToList();
        _runesById = _runes.ToDictionary(rune => rune.DofusDbId);
    }

    private async Task LoadCurrentAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            switch (_tab)
            {
                case HistoryTab.Resources:
                    _marketHistory = await HistoryService.GetMarketHistoryAsync(
                        MarketObjectType.Resource,
                        ServerName,
                        _searchText,
                        _levelMin,
                        _levelMax,
                        _sortColumn,
                        _sortDirection,
                        _take
                    );
                    break;

                case HistoryTab.Runes:
                    _marketHistory = await HistoryService.GetMarketHistoryAsync(
                        MarketObjectType.Rune,
                        ServerName,
                        _searchText,
                        _levelMin,
                        _levelMax,
                        _sortColumn,
                        _sortDirection,
                        _take
                    );
                    break;

                case HistoryTab.Items:
                    _itemHistory = await HistoryService.GetItemHistoryAsync(
                        ServerName,
                        _searchText,
                        _levelMin,
                        _levelMax,
                        _equipmentType,
                        _itemRuneFilterId,
                        _sortColumn,
                        _sortDirection,
                        _take
                    );
                    break;

                case HistoryTab.Crushes:
                    _crushHistory = await HistoryService.GetCrushHistoryAsync(
                        ServerName,
                        _searchText,
                        _crushRuneFilterId,
                        _sortColumn,
                        _sortDirection,
                        _take
                    );
                    break;

                case HistoryTab.Analytics:
                    await BuildAnalyticsResultsAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectTabAsync(HistoryTab tab)
    {
        if (_tab == tab)
        {
            return;
        }

        _tab = tab;
        _take = InitialTake;
        _sortColumn = HistorySortColumn.Date;
        _sortDirection = HistorySortDirection.Descending;
        _runePickerOpen = false;
        _expandedSessions.Clear();

        await LoadCurrentAsync();
    }

    private async Task RefreshAsync()
    {
        await LoadCurrentAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        NormalizeLevels();
        _take = InitialTake;
        _runePickerOpen = false;
        await LoadCurrentAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _searchText = null;
        _levelMin = null;
        _levelMax = null;
        _equipmentType = null;

        if (_tab == HistoryTab.Items)
        {
            _itemRuneFilterId = null;
        }
        else if (_tab == HistoryTab.Crushes)
        {
            _crushRuneFilterId = null;
        }

        _take = InitialTake;
        _runePickerOpen = false;
        await LoadCurrentAsync();
    }

    private void NormalizeLevels()
    {
        if (_levelMin is < 0)
        {
            _levelMin = 0;
        }

        if (_levelMax is > 200)
        {
            _levelMax = 200;
        }

        if (_levelMin is int min &&
            _levelMax is int max &&
            min > max)
        {
            (_levelMin, _levelMax) = (_levelMax, _levelMin);
        }
    }

    private void OnEquipmentTypeChanged(ChangeEventArgs args)
    {
        string? value = args.Value?.ToString();

        _equipmentType = Enum.TryParse(
            value,
            ignoreCase: true,
            out EquipmentType parsed)
                ? parsed
                : null;
    }

    private void ToggleRunePicker()
    {
        _runePickerOpen = !_runePickerOpen;
    }

    private async Task SelectRuneFilterAsync(long? dofusDbId)
    {
        if (_tab == HistoryTab.Items)
        {
            _itemRuneFilterId = dofusDbId;
        }
        else if (_tab == HistoryTab.Crushes)
        {
            _crushRuneFilterId = dofusDbId;
        }

        _runePickerOpen = false;
        _take = InitialTake;
        await LoadCurrentAsync();
    }

    private Rune? SelectedFilterRune
    {
        get
        {
            long? id = _tab == HistoryTab.Items
                ? _itemRuneFilterId
                : _crushRuneFilterId;

            return id is long value
                ? _runesById.GetValueOrDefault(value)
                : null;
        }
    }

    private async Task SortByAsync(HistorySortColumn column)
    {
        if (_sortColumn == column)
        {
            _sortDirection = _sortDirection == HistorySortDirection.Ascending
                ? HistorySortDirection.Descending
                : HistorySortDirection.Ascending;
        }
        else
        {
            _sortColumn = column;
            _sortDirection = DefaultDirection(column);
        }

        _take = InitialTake;
        await LoadCurrentAsync();
    }

    private static HistorySortDirection DefaultDirection(HistorySortColumn column) =>
        column switch
        {
            HistorySortColumn.Name or
            HistorySortColumn.Level or
            HistorySortColumn.Type or
            HistorySortColumn.Source or
            HistorySortColumn.DataKind or
            HistorySortColumn.Rune => HistorySortDirection.Ascending,

            _ => HistorySortDirection.Descending
        };

    private string SortIndicator(HistorySortColumn column)
    {
        if (_sortColumn != column)
        {
            return "↕";
        }

        return _sortDirection == HistorySortDirection.Ascending
            ? "▲"
            : "▼";
    }

    private string SortButtonClass(HistorySortColumn column) =>
        _sortColumn == column
            ? "history-sort active"
            : "history-sort";

    private async Task LoadMoreAsync()
    {
        _take += PageIncrement;
        await LoadCurrentAsync();
    }

    private bool CurrentHasMore =>
        _tab switch
        {
            HistoryTab.Resources or HistoryTab.Runes => _marketHistory?.HasMore == true,
            HistoryTab.Items => _itemHistory?.HasMore == true,
            HistoryTab.Crushes => _crushHistory?.HasMore == true,
            _ => false
        };

    private string TabClass(HistoryTab tab) =>
        tab == _tab
            ? "btn btn-primary"
            : "btn btn-outline-secondary";

    private IItem? GetMarketItem(MarketHistoryRow row)
    {
        return _tab == HistoryTab.Resources
            ? _resources.GetValueOrDefault(row.DofusDbId)
            : _runesById.GetValueOrDefault(row.DofusDbId);
    }

    private void LoadAnalyticsPresets()
    {
        _analyticsPresets =
            MarketAnalyticsPresetService
                .GetAll()
                .ToList();
    }

    private async Task BuildAnalyticsResultsAsync()
    {
        List<MarketAnalyticsSeriesResult> results = [];

        foreach (
            MarketAnalyticsSeriesDefinition series
            in _analyticsSeries)
        {
            if (series.DofusDbId <= 0)
            {
                continue;
            }

            MarketAnalyticsSeriesResult result =
                await MarketAnalyticsService
                    .BuildSeriesAsync(
                        series,
                        ServerName,
                        _analyticsPeriod
                    );

            results.Add(result);
        }

        _analyticsResults = results;
    }

    private async Task RefreshAnalyticsAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            await BuildAnalyticsResultsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task NewAnalyticsAsync()
    {
        _selectedAnalyticsPresetId = null;
        _analyticsName = "Nouvelle analyse";
        _analyticsPeriod = MarketAnalyticsPeriod.Days7;
        _analyticsSeries = [];
        _analyticsResults = [];
        _analyticsDraft = null;
        _editingAnalyticsSeriesId = null;
        _errorMessage = null;

        return Task.CompletedTask;
    }

    private async Task OnAnalyticsPresetChangedAsync(
        ChangeEventArgs args)
    {
        string? value = args.Value?.ToString();

        if (!Guid.TryParse(value, out Guid presetId))
        {
            await NewAnalyticsAsync();
            return;
        }

        MarketAnalyticsPreset? preset =
            _analyticsPresets.FirstOrDefault(
                candidate =>
                    candidate.Id == presetId
            );

        if (preset is null)
        {
            return;
        }

        _selectedAnalyticsPresetId = preset.Id;
        _analyticsName = preset.Name;
        _analyticsPeriod = preset.Period;
        _analyticsSeries = preset.Series
            .Select(
                BestCrush.Services
                    .MarketAnalyticsPresetService
                    .Clone)
            .ToList();
        _analyticsDraft = null;
        _editingAnalyticsSeriesId = null;

        await RefreshAnalyticsAsync();
    }

    private Task SaveAnalyticsPresetAsync(
        bool saveAs)
    {
        string name =
            _analyticsName.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            _errorMessage =
                "Donne un nom à l'analyse avant de l'enregistrer.";
            return Task.CompletedTask;
        }

        Guid id =
            saveAs ||
            _selectedAnalyticsPresetId is null
                ? Guid.NewGuid()
                : _selectedAnalyticsPresetId.Value;

        MarketAnalyticsPreset preset = new()
        {
            Id = id,
            Name = name,
            Period = _analyticsPeriod,
            Series = _analyticsSeries
                .Select(
                    BestCrush.Services
                        .MarketAnalyticsPresetService
                        .Clone)
                .ToList()
        };

        MarketAnalyticsPresetService.Save(preset);
        LoadAnalyticsPresets();

        _selectedAnalyticsPresetId = id;
        _analyticsName = name;
        _errorMessage = null;

        return Task.CompletedTask;
    }

    private Task DeleteAnalyticsPresetAsync()
    {
        if (_selectedAnalyticsPresetId is not Guid presetId)
        {
            return Task.CompletedTask;
        }

        MarketAnalyticsPresetService.Delete(presetId);
        LoadAnalyticsPresets();

        _selectedAnalyticsPresetId = null;
        _analyticsName = "Nouvelle analyse";

        return Task.CompletedTask;
    }

    private bool AnalyticsPresetIsModified
    {
        get
        {
            if (_selectedAnalyticsPresetId is not Guid presetId)
            {
                return false;
            }

            MarketAnalyticsPreset? saved =
                _analyticsPresets.FirstOrDefault(
                    preset =>
                        preset.Id == presetId
                );

            if (saved is null ||
                !string.Equals(
                    saved.Name,
                    _analyticsName.Trim(),
                    StringComparison.Ordinal) ||
                saved.Period != _analyticsPeriod ||
                saved.Series.Count != _analyticsSeries.Count)
            {
                return true;
            }

            for (int index = 0;
                index < saved.Series.Count;
                index++)
            {
                if (!AnalyticsSeriesEqual(
                    saved.Series[index],
                    _analyticsSeries[index]))
                {
                    return true;
                }
            }

            return false;
        }
    }

    private static bool AnalyticsSeriesEqual(
        MarketAnalyticsSeriesDefinition left,
        MarketAnalyticsSeriesDefinition right)
    {
        return
            left.Id == right.Id &&
            left.ObjectType == right.ObjectType &&
            left.DofusDbId == right.DofusDbId &&
            string.Equals(
                left.ItemName,
                right.ItemName,
                StringComparison.Ordinal) &&
            left.LotQuantity == right.LotQuantity &&
            left.ValueMode == right.ValueMode &&
            left.Aggregation == right.Aggregation &&
            left.SourceMode == right.SourceMode &&
            left.Transformation == right.Transformation;
    }

    private void BeginAddAnalyticsSeries()
    {
        MarketAnalyticsSeriesDefinition? draft =
            CreateDefaultAnalyticsSeries();

        if (draft is null)
        {
            _errorMessage =
                "Aucun élément n'est disponible pour créer une série.";
            return;
        }

        _editingAnalyticsSeriesId = null;
        _analyticsDraft = draft;
        _errorMessage = null;
    }

    private MarketAnalyticsSeriesDefinition?
        CreateDefaultAnalyticsSeries()
    {
        foreach (MarketObjectType objectType in new[]
        {
            MarketObjectType.Rune,
            MarketObjectType.Resource,
            MarketObjectType.Equipment
        })
        {
            AnalyticsCatalogItem? first =
                GetAnalyticsCatalogItems(objectType)
                    .FirstOrDefault();

            if (first is not null)
            {
                return new MarketAnalyticsSeriesDefinition
                {
                    ObjectType = objectType,
                    DofusDbId = first.DofusDbId,
                    ItemName = first.Name,
                    LotQuantity =
                        objectType == MarketObjectType.Equipment
                            ? 1
                            : null
                };
            }
        }

        return null;
    }

    private void BeginEditAnalyticsSeries(Guid seriesId)
    {
        MarketAnalyticsSeriesDefinition? series =
            _analyticsSeries.FirstOrDefault(candidate =>
                candidate.Id == seriesId);

        if (series is null)
        {
            return;
        }

        _editingAnalyticsSeriesId = seriesId;
        MarketAnalyticsSeriesDefinition draft =
            BestCrush.Services
                .MarketAnalyticsPresetService
                .Clone(series);

        if (draft.LotQuantity is null)
        {
            draft.ValueMode =
                MarketAnalyticsValueMode.UnitPrice;
        }

        _analyticsDraft = draft;
        _errorMessage = null;
    }

    private void CancelAnalyticsSeriesDraft()
    {
        _analyticsDraft = null;
        _editingAnalyticsSeriesId = null;
    }

    private async Task CommitAnalyticsSeriesDraftAsync()
    {
        if (_analyticsDraft is null)
        {
            return;
        }

        MarketAnalyticsSeriesDefinition committed =
            BestCrush.Services
                .MarketAnalyticsPresetService
                .Clone(_analyticsDraft);

        if (committed.LotQuantity is null)
        {
            committed.ValueMode =
                MarketAnalyticsValueMode.UnitPrice;
        }

        if (_editingAnalyticsSeriesId is Guid seriesId)
        {
            int index = _analyticsSeries.FindIndex(candidate =>
                candidate.Id == seriesId);

            if (index >= 0)
            {
                committed.Id = seriesId;
                _analyticsSeries[index] = committed;
            }
        }
        else
        {
            _analyticsSeries.Add(committed);
        }

        _analyticsDraft = null;
        _editingAnalyticsSeriesId = null;

        await RefreshAnalyticsAsync();
    }

    private async Task RemoveAnalyticsSeriesAsync(
        Guid seriesId)
    {
        _analyticsSeries.RemoveAll(
            series =>
                series.Id == seriesId);

        if (_editingAnalyticsSeriesId == seriesId)
        {
            CancelAnalyticsSeriesDraft();
        }

        await RefreshAnalyticsAsync();
    }

    private async Task OnAnalyticsPeriodChangedAsync(
        ChangeEventArgs args)
    {
        if (Enum.TryParse(
            args.Value?.ToString(),
            out MarketAnalyticsPeriod period))
        {
            _analyticsPeriod = period;
            await RefreshAnalyticsAsync();
        }
    }

    private void OnAnalyticsDraftObjectTypeChanged(
        ChangeEventArgs args)
    {
        if (_analyticsDraft is null ||
            !Enum.TryParse(
            args.Value?.ToString(),
            out MarketObjectType objectType))
        {
            return;
        }

        AnalyticsCatalogItem? first =
            GetAnalyticsCatalogItems(objectType)
                .FirstOrDefault();

        if (first is null)
        {
            return;
        }

        _analyticsDraft.ObjectType = objectType;
        _analyticsDraft.DofusDbId = first.DofusDbId;
        _analyticsDraft.ItemName = first.Name;
        _analyticsDraft.LotQuantity =
            objectType == MarketObjectType.Equipment
                ? 1
                : null;
        _analyticsDraft.ValueMode =
            MarketAnalyticsValueMode.UnitPrice;
    }

    private void OnAnalyticsDraftItemChanged(
        ChangeEventArgs args)
    {
        if (_analyticsDraft is null ||
            !long.TryParse(
            args.Value?.ToString(),
            out long dofusDbId))
        {
            return;
        }

        AnalyticsCatalogItem? item =
            GetAnalyticsCatalogItems(
                _analyticsDraft.ObjectType)
                .FirstOrDefault(candidate =>
                    candidate.DofusDbId == dofusDbId);

        if (item is null)
        {
            return;
        }

        _analyticsDraft.DofusDbId = item.DofusDbId;
        _analyticsDraft.ItemName = item.Name;
    }

    private void OnAnalyticsDraftLotChanged(
        ChangeEventArgs args)
    {
        if (_analyticsDraft is null)
        {
            return;
        }

        string? value = args.Value?.ToString();

        _analyticsDraft.LotQuantity =
            int.TryParse(value, out int quantity) &&
            quantity > 0
                ? quantity
                : null;

        if (_analyticsDraft.LotQuantity is null)
        {
            _analyticsDraft.ValueMode =
                MarketAnalyticsValueMode.UnitPrice;
        }
    }

    private void OnAnalyticsDraftValueModeChanged(
        ChangeEventArgs args)
    {
        if (_analyticsDraft is not null &&
            Enum.TryParse(
            args.Value?.ToString(),
            out MarketAnalyticsValueMode value))
        {
            _analyticsDraft.ValueMode =
                _analyticsDraft.LotQuantity is null
                    ? MarketAnalyticsValueMode.UnitPrice
                    : value;
        }
    }

    private void OnAnalyticsDraftAggregationChanged(
        ChangeEventArgs args)
    {
        if (_analyticsDraft is not null &&
            Enum.TryParse(
            args.Value?.ToString(),
            out MarketAnalyticsAggregation value))
