@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@inject IServiceScopeFactory DataScopes
@page "/servers/{ServerName}/history"

@inject HistoryService HistoryService
@inject ItemsService ItemsService
@inject RunesService RunesService

@using BestCrush.Components.Pure
@using BestCrush.Domain.Models
@using BestCrush.Domain.Services
@using BestCrush.Models
@using Rune = BestCrush.Domain.Models.Rune

<div class="container history-page workspace-page">
    <PageHeading Title="Historique" Description="Consultez les relevés de prix et de coefficients enregistrés.">
        <ChildContent>@if (!IsEmbedded) { <p class="small text-secondary mb-0">Serveur : @ServerName</p> }</ChildContent>
        <Actions>
        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@_loading"
                    @onclick="RefreshAsync">
                Rafraîchir
            </button>

    @if (!IsEmbedded)
    {
            <a class="btn btn-outline-secondary"
               href="@BestCrush.Components.KnownRoutes.Server(ServerName)">
                Retour
            </a>
    }
        </div>
        </Actions>
    </PageHeading>

    @if (_historyItemId is not null)
    {
        <div class="d-flex align-items-center gap-3 mb-3">
            <span>Historique de <strong>@InitialSelection?.Name</strong></span>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearItemSelectionAsync">Voir tout</button>
        </div>
    }
    <div class="history-tabs mb-3">
        <button type="button" class="@TabClass(HistoryTab.Items)" @onclick="() => SelectTabAsync(HistoryTab.Items)">Équipements</button>
        <button type="button" class="@TabClass(HistoryTab.Runes)" @onclick="() => SelectTabAsync(HistoryTab.Runes)">Runes</button>
        <button type="button" class="@TabClass(HistoryTab.Resources)" @onclick="() => SelectTabAsync(HistoryTab.Resources)">Ressources</button>
        <button type="button" class="@TabClass(HistoryTab.Crushes)" @onclick="() => SelectTabAsync(HistoryTab.Crushes)">Concassages</button>
    </div>

    <div>
        <div class="history-filter-area mb-3">
            <div class="history-primary-filters">
                <div class="history-search-field"><ServiceSearch @bind-Value="_searchText" Placeholder="@SearchPlaceholder" Changed="QueueSearchAsync" /></div>
                <label>Période
                    <select class="form-select" @bind="_period" @bind:after="ApplyFiltersAsync">
                        <option value="24h">Dernières 24 h</option><option value="7d">7 derniers jours</option>
                        <option value="30d">30 derniers jours</option><option value="all">Tout l’historique</option>
                        <option value="custom">Dates personnalisées</option>
                    </select>
                </label>
            </div>
            @if (_period == "custom")
            {
                <div class="history-date-range mt-2">
                    <label>Du<input class="form-control" type="date" @bind="_dateFrom" @bind:after="ApplyFiltersAsync" /></label>
                    <label>Au<input class="form-control" type="date" @bind="_dateTo" @bind:after="ApplyFiltersAsync" /></label>
                </div>
            }
            <div class="d-flex align-items-center justify-content-between gap-2 mt-3">
                <button class="btn btn-outline-secondary" type="button" aria-expanded="@_advancedOpen" aria-controls="history-advanced"
                        @onclick="() => _advancedOpen = !_advancedOpen">
                    <i class="bi bi-sliders me-2" aria-hidden="true"></i>Filtres avancés
                    @if (AdvancedFilterCount > 0) { <span class="badge text-bg-secondary ms-1">@AdvancedFilterCount</span> }
                    <span class="ms-2" aria-hidden="true">@(_advancedOpen ? "⌃" : "⌄")</span>
                </button>
                @if (HasActiveFilters)
                {
                    <button class="btn btn-link" type="button" @onclick="ResetFiltersAsync">Réinitialiser</button>
                }
            </div>
            @if (_advancedOpen)
            {
                <div id="history-advanced" class="history-advanced mt-3">
                    <div class="history-advanced-grid">
                        @if (_tab is HistoryTab.Items or HistoryTab.Resources)
                        {
                            <div><label class="form-label mb-1" for="history-level-min">Niveau</label><div class="d-flex align-items-center gap-2">
                                <input id="history-level-min" type="number" class="form-control" min="1" max="200" placeholder="Min" aria-label="Niveau minimum" @bind="_levelMin" @bind:after="ApplyFiltersAsync" />
                                <span>à</span><input type="number" class="form-control" min="1" max="200" placeholder="Max" aria-label="Niveau maximum" @bind="_levelMax" @bind:after="ApplyFiltersAsync" />
                            </div></div>
                        }
                        @if (_tab == HistoryTab.Items)
                        {
                            <div><div class="form-label mb-1">Types d’objet</div>
                                <EquipmentTypeFilter AvailableTypes="_availableEquipmentTypes" SelectedTypes="_equipmentTypes"
                                    SelectedTypesChanged="OnEquipmentTypesChangedAsync" DisclosureGroup="history-filters" />
                            </div>
                        }
                        @if (_tab is HistoryTab.Items or HistoryTab.Crushes)
                        {
                            <label>Type de relevé<select class="form-select" @bind="_recordKind" @bind:after="ApplyFiltersAsync">
                                <option value="all">@(_tab == HistoryTab.Items ? "Prix et coefficients" : "Coefficients et opérations")</option>
                                @if (_tab == HistoryTab.Items) { <option value="price">Prix uniquement</option> }
                                <option value="coefficient">Coefficients uniquement</option>
                                @if (_tab == HistoryTab.Crushes) { <option value="operation">Concassages effectués</option> }
                            </select></label>
                        }
                        @if (_tab != HistoryTab.Crushes)
                        {
                            <label>Source<select class="form-select" @bind="_source" @bind:after="ApplyFiltersAsync">
                                <option value="all">Toutes les sources</option><option value="game">Capture en jeu</option><option value="manual">Saisie manuelle</option>
                                @if (_tab == HistoryTab.Items) { <option value="dofocus">DoFocus</option> }
                            </select></label>
                            <label>Quantité du lot<select class="form-select" @bind="_lotQuantity" @bind:after="ApplyFiltersAsync">
                                <option value="">Tous les lots</option><option value="1">× 1</option><option value="10">× 10</option><option value="100">× 100</option><option value="1000">× 1 000</option>
                            </select></label>
                        }
                        @if (_tab is HistoryTab.Items or HistoryTab.Crushes)
                        {
                            <label>@(_tab == HistoryTab.Items ? "Rune obtenable" : "Rune obtenue ou obtenable")
                                <select class="form-select" value="@SelectedFilterRune?.DofusDbId" @onchange="OnRuneFilterChangedAsync">
                                    <option value="">Toutes les runes</option>
                                    @foreach (Rune rune in _runes) { <option value="@rune.DofusDbId">@rune.Name</option> }
                                </select>
                            </label>
                        }
                    </div>
                    @if (_tab != HistoryTab.Crushes)
                    {
                        <label class="d-flex flex-row align-items-center gap-2 mt-3"><input class="form-check-input mt-0" type="checkbox" @bind="_includeCleared" @bind:after="ApplyFiltersAsync" />Inclure les entrées réinitialisées</label>
                    }
                </div>
            }
            @if (FilterChips.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2 mt-3" aria-label="Filtres actifs">
                    @foreach (var chip in FilterChips)
                    {
                        <FilterChip Label="@chip.Label" Removed="() => RemoveFilterAsync(chip.Key)" />
                    }
                </div>
            }
        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }

    <DataLoadingIndicator Busy="@(_loading || _catalogsLoading)" Failed="@(_catalogLoad.Error is not null)" Label="Chargement de l’historique…" Retry="RefreshAsync" />
    @if (_loading || _catalogsLoading)
    {
    }
    else
    {
        @if (_tab == HistoryTab.Crushes)
        {
            <CrushingHistoryTable Rows="@(_crushHistory?.Rows ?? [])" SortColumn="_sortColumn" SortDirection="_sortDirection" SortRequested="SortByAsync" ResetKey="@TableResetKey" />
        }
        else
        {
            <HistoryObservationTable MarketRows="@(_marketHistory?.Rows ?? [])" ItemRows="@(_itemHistory?.Rows ?? [])" IsEquipment="@(_tab == HistoryTab.Items)"
                Items="_historyItems" SortColumn="_sortColumn" SortDirection="_sortDirection" SortRequested="SortByAsync" ResetKey="@TableResetKey" />
        }

        <div>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
                <span class="small text-secondary" role="status">@(CurrentRowCount == 0 ? "Aucun résultat" : $"{_page * InitialTake + 1:N0}–{_page * InitialTake + CurrentRowCount:N0}")</span>
                @if (_page > 0 || CurrentHasMore)
                {
                    <nav class="d-flex align-items-center gap-2" aria-label="Pages de l’historique">
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(_page == 0 || _loading)" @onclick="PreviousPageAsync">Précédent</button>
                        <span class="small">Page @(_page + 1)</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!CurrentHasMore || _loading)" @onclick="NextPageAsync">Suivant</button>
                    </nav>
                }
            </div>
        </div>

    }
</div>

@code {
    [Parameter] public bool IsEmbedded { get; set; }
    [Parameter] public bool IsActive { get; set; } = true;
    [Parameter] public ObjectHistorySelection? InitialSelection { get; set; }
    private ObjectHistorySelection? _lastSelection;
    private long? _historyItemId;

    [Parameter]
    public string ServerName { get; set; } = string.Empty;

    private const int InitialTake = 50;

    private HistoryTab _tab = HistoryTab.Items;
    private HistorySortColumn _sortColumn = HistorySortColumn.Date;
    private HistorySortDirection _sortDirection = HistorySortDirection.Descending;

    private string? _searchText;
    private int? _levelMin;
    private int? _levelMax;
    private long? _itemRuneFilterId;
    private long? _crushRuneFilterId;

    private int _take = InitialTake;
    private bool _loading;
    private string? _errorMessage;

    private HistoryPage<MarketHistoryRow>? _marketHistory;
    private HistoryPage<ItemHistoryRow>? _itemHistory;
    private HistoryPage<CrushHistoryEntry>? _crushHistory;

    private Dictionary<long, Resource> _resources = [];
    private Dictionary<long, Equipment> _equipments = [];
    private Dictionary<long, Rune> _runesById = [];
    private List<Rune> _runes = [];

    private enum HistoryTab
    {
        Resources,
        Items,
        Runes,
        Crushes
    }
}
