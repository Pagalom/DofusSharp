@using BestCrush.Network.Protocol
@using BestCrush.Domain.Models
@using BestCrush.Services
@using Microsoft.Extensions.Logging
@inject BreedingObjectiveProgressStore ProgressStore
@inject CurrentDofusClientsState Clients
@inject BestCrushSettingsService Settings
@inject BreedingTradeService Trade
@inject GlobalSalesRepository Sales
@inject MarketDataChangeNotifier MarketChanges
@inject MarketClipboardQueue CopyQueue
@inject LiveStockService Stocks
@inject CurrentWindowProfessionsState Professions
@inject ILogger<BreedingDecisionsPanel> Logger
@implements IDisposable

@if (_trackingError is not null) { <p class="text-warning" role="status">@_trackingError</p> }
@if (_report is { } current && _journal is not null)
{
    <BreedingObjectiveBoard Report="current" Journal="_journal" PlanningModeChanged="ChangePlanningMode" CapturesChanged="ChangeCaptures" MinimumChanceChanged="ChangeMinimumChance" BudgetChanged="ChangeBudget" Select="SelectObjectiveAsync" Override="OverrideObjectiveAsync" Confirm="ConfirmStepAsync" ViewMount="ViewMount" Notices="Notices" ViewLocation="ViewLocation" />
    <div class="breeding-action-columns"><div>@ChildContent</div>
    <section class="breeding-hdv-card bc-surface">
        <header><h2><i class="bi bi-shop" aria-hidden="true"></i> À consulter à l’HDV <span>@current.PriceChecks.Count</span></h2>
            <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Copier la liste des éléments à consulter" disabled="@_copying" @onclick="() => CopyChecksAsync(current.PriceChecks)"><i class="bi bi-copy" aria-hidden="true"></i></button></header>
        <span role="status" class="small">@_copyStatus</span>
        <div class="breeding-hdv-list">
            @foreach (var check in current.PriceChecks)
            {
                <div><CopyTextButton Value="@check.Name" Tooltip="Copier pour chercher à l’HDV">@check.Name</CopyTextButton><StatusIcon Icon="@(check.LastObserved is null ? "question-circle" : "clock-history")" Tooltip="@($"{check.Reason}{(check.LastObserved is { } at ? $" · {at.ToLocalTime():dd/MM HH:mm}" : "")}")" CssClass="text-warning" /></div>
            }
        </div>
    </section></div>
}
else if (_loading) { <span class="small" role="status">Calcul en cours…</span> }
else if (_notice is not null) { <p role="status">@_notice</p> }

@if (_report is { } comparisonReport)
{
    <section class="breeding-comparisons" aria-label="Comparaisons d’élevage">
        <h2>Comparer</h2>
        <BreedingMarketPlan Report="comparisonReport" />
        <BreedingOwnedComparison Report="comparisonReport" Mounts="Mounts" SpeciesById="SpeciesById"
            MountLocations="MountLocations" HeldMounts="@Mounts.Where(m => KeepForBreeding(m.Id)).Select(m => m.Id).ToHashSet()"
            FocusedMount="FocusedMount" ViewMount="ViewMount" />
        <BreedingPairPlanner Report="comparisonReport" MountNumbers="MountNumbers" Reserved="_reserved" ReservedChanged="ReservePairAsync" />
    </section>
}

@code {
    [Parameter] public DofusClientWindowKey? Window { get; set; }
    [Parameter] public string? ServerName { get; set; }
    [Parameter, EditorRequired] public IReadOnlyDictionary<long, BreedingSpecies> SpeciesById { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<PaddockMountReading> Mounts { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyDictionary<Guid, int> MountNumbers { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyDictionary<Guid, string> MountLocations { get; set; } = null!;
    [Parameter] public EventCallback<IReadOnlyDictionary<Guid, int>> ExperienceGoalsChanged { get; set; }
    [Parameter] public EventCallback<IReadOnlyDictionary<Guid, BreedingResaleAssessment>> ResaleChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public Guid? FocusedMount { get; set; }
    [Parameter] public EventCallback<Guid> ViewMount { get; set; }
    [Parameter] public EventCallback<string> ViewLocation { get; set; }
    [Parameter] public IReadOnlyList<BreedingGaugeNotice> Notices { get; set; } = [];
    private BreedingObjectiveJournal? _journal;
    private string? _scope, _trackingError;
    private bool _goalsDirty;
    private IReadOnlyList<BreedingObjectiveStep> SelectedPlan => _journal?.Selected is { } key && _journal.Goals.GetValueOrDefault(key) is { } progress ? progress.Steps : _report?.Plan ?? [];

    private void UpdateProgress()
    {
        if (_report is null) return;
        try
        {
            // Window titles scope user planning only, never economic observations or network attribution.
            string? name = Clients.Clients.FirstOrDefault(c => c.Key == Window && c.HasCharacterTitle)?.DisplayName;
            string scope = name is null ? _scope ?? Guid.NewGuid().ToString("N") :
                Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(_report.Server + "\n" + name)));
            if (_journal is null || _scope != scope) { _journal = ProgressStore.Read(scope); _scope = scope; }
            bool changed = false;
            foreach (var objective in _report.Strategy.Objectives)
            {
                string key = BreedingObjectiveProgressStore.Key(objective);
                if (!_journal.Goals.TryGetValue(key, out var saved))
                {
                    saved = new() { Steps = _report.ObjectivePlans.GetValueOrDefault(key, []).ToList(), Planning = _report.Planning, StartedAt = DateTimeOffset.UtcNow };
                    _journal.Goals.Add(key, saved); changed = true;
                }
                else if ((saved.Planning?.MinimumGenerationChancePercent != _report.Planning.MinimumGenerationChancePercent || saved.Planning?.Mode != _report.Planning.Mode) && _report.ObjectivePlans.GetValueOrDefault(key) is { } revised)
                {
                    _report.Planning.Rebase(saved, revised); changed = true;
                }
                else if (saved.Done.Count == 0 && saved.Partial.Count == 0 && saved.PendingListings.Count == 0 && !saved.OverrideCurrentCycle &&
                    _report.ObjectivePlans.GetValueOrDefault(key) is { } latest && !saved.Steps.SequenceEqual(latest))
                {
                    saved.Steps = latest.ToList(); changed = true;
                }
                // Keep the current route stable while working; a new cycle gets the latest plan.
                if (saved.LastListedAt is null || saved.OverrideCurrentCycle || BreedingObjectiveProgressStore.WaitingUntil(_journal, objective.ItemId, DateTimeOffset.UtcNow) is null)
                    changed |= BreedingObjectiveProgressStore.Observe(saved, PlanningMounts(scope));
            }
            changed |= BreedingObjectiveProgressStore.ObserveListings(_journal, _report.Strategy.Objectives, _report.ObjectivePlans,
                Sales.ReadProductionListings(_report.Server, scope, DateTimeOffset.UtcNow), DateTimeOffset.UtcNow,
                Sales.ReadProductionSales(_report.Server, scope, DateTimeOffset.UtcNow), Sales.ReadProductionReturns(_report.Server, scope, DateTimeOffset.UtcNow));
            if (_journal.Selected is null || !_report.Strategy.Objectives.Any(g => BreedingObjectiveProgressStore.Key(g) == _journal.Selected))
            {
                var recommended = _report.Strategy.Objectives.FirstOrDefault(g => BreedingObjectiveProgressStore.Available(_journal, g, DateTimeOffset.UtcNow)) ?? _report.Strategy.Objectives.FirstOrDefault();
                if (recommended is not null) { _journal.Selected = BreedingObjectiveProgressStore.Key(recommended); changed = true; }
            }
            _goalsDirty |= changed;
            if (changed && name is not null) ProgressStore.Save(scope, _journal);
            _trackingError = name is null ? "Choisis ton personnage pour conserver les objectifs entre les relances." : null;
        }
        catch (Exception ex) when (ex is InvalidDataException or IOException or UnauthorizedAccessException)
        { Logger.LogWarning(ex, "Suivi des objectifs indisponible."); _trackingError = "Suivi indisponible · fichier conservé."; }
    }

    private void ChangeMinimumChance(int value) => Settings.BreedingMinimumChancePercent = value;
    private void ChangeCaptures(int value) => Settings.BreedingCapturesPerDay = value;
    private void ChangeBudget(long value) => Settings.ProductionBudgetKamas = value;
    private IReadOnlyList<PaddockMountReading> PlanningMounts(string scope)
    {
        var stock = Window is { } window ? Stocks.ForWindow(window) : null;
        var inventory = string.Equals(stock?.ServerName, _report?.Server, StringComparison.OrdinalIgnoreCase)
            ? stock!.Containers.Where(c => c.Complete && !c.Stale && c.Container is "inventory" or "bank")
                .SelectMany(c => c.Items).Select(i => ProductionListingReader.MountForPlanning(i, scope)).OfType<PaddockMountReading>()
                .Where(m => !Mounts.Any(known => known.SpeciesId == m.SpeciesId && known.Level == m.Level)).ToArray() : [];
        return Mounts.Concat(inventory).ToArray();
    }
    private void OnStockChanged() { if (!_disposed) _ = InvokeAsync(RefreshAsync); }
    private void ChangePlanningMode(BreedingPlanningMode mode) => Settings.BreedingPlanningMode = mode;
    private void OnPlanningChanged() { if (!_disposed) _ = InvokeAsync(RefreshAsync); }

    private async Task SelectObjectiveAsync(string key)
    {
        if (_journal is null || !_journal.Goals.ContainsKey(key)) return;
        _journal.Selected = key; SaveProgress(); await PublishExperienceGoalsAsync();
    }
    private async Task OverrideObjectiveAsync(string key)
    {
        if (_journal?.Goals.GetValueOrDefault(key) is not { } progress) return;
        progress.OverrideCurrentCycle = true;
        await SelectObjectiveAsync(key);
    }
    private async Task ConfirmStepAsync(int index)
    {
        if (_journal?.Selected is not { } key || _report?.Strategy.Objectives.FirstOrDefault(g => BreedingObjectiveProgressStore.Key(g) == key) is not { } objective) return;
        try
        {
            BreedingObjectiveProgressStore.ConfirmStep(_journal, objective, _report.ObjectivePlans.GetValueOrDefault(key, []), index, DateTimeOffset.UtcNow);
            UpdateProgress();
            SaveProgress(); await PublishExperienceGoalsAsync();
        }
        catch (InvalidOperationException ex) { _trackingError = ex.Message; }
    }
    private void SaveProgress()
    {
        if (_journal is null || _scope is null || !Clients.Clients.Any(c => c.Key == Window && c.HasCharacterTitle)) return;
        try { ProgressStore.Save(_scope, _journal); _trackingError = null; }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { Logger.LogWarning(ex, "Sauvegarde des objectifs indisponible."); _trackingError = "Sauvegarde indisponible · fichier conservé."; }
    }


    private readonly CancellationTokenSource _lifetime = new();
    private BreedingTradeReport? _report;
    private string? _notice;
    private bool _loading;
    private bool _refreshPending;
    private bool _disposed;
    private bool _copying;
    private string? _copyStatus;
    private DateTime _marketChecked;
    private IReadOnlyDictionary<long, BreedingSpecies>? _lastSpecies;
    private (Guid Id, int Level, int? SpeciesId, BreedingMountFertility? Fertility, BreedingMountSex? Sex, int ExperienceBand)[] _lastMountProfiles = [];
    private BreedingPairOption? _reserved;

    private BreedingSpecies? Species(PaddockMountReading mount) =>
        mount.SpeciesId is { } id ? SpeciesById.GetValueOrDefault(id) : null;

    private string Label(PaddockMountReading mount) =>
        $"#{MountNumbers.GetValueOrDefault(mount.Id)} · {Species(mount)?.Name ?? "Monture"} · Niveau {mount.Level}";


    private async Task CopyChecksAsync(IReadOnlyList<BreedingPriceCheck> checks)
    {
        if (_copying) return;
        _copying = true;
        try
        {
            var names = checks.Select(check => check.Name)
                .OrderBy(name => name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Contains("et", StringComparer.OrdinalIgnoreCase));
            var result = await CopyQueue.CopyAsync(names, Window);
            _copyStatus = result.IsQueue ? $"{result.Count} noms chargés · Ctrl+V dans Dofus." : "Liste copiée.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Copie de la liste HDV indisponible.");
            _copyStatus = "Copie indisponible. Réessaie.";
        }
        finally
        {
            _copying = false;
        }
    }

    private async Task ReservePairAsync(BreedingPairOption? pair)
    {
        _reserved = pair;
        await PublishExperienceGoalsAsync();
    }

    private bool KeepForBreeding(Guid id) => _reserved?.Contains(id) == true ||
        SelectedPlan.Any(step => step.Action == BreedingObjectiveAction.Prepare && step.OwnedId == id) == true;

    private Task PublishExperienceGoalsAsync()
    {
        var goals = _report?.Sellable.Where(entry => !KeepForBreeding(entry.Key) &&
                Mounts.Any(mount => mount.Id == entry.Key && mount.Level < entry.Value.Level))
            .ToDictionary(entry => entry.Key, entry => entry.Value.Level) ?? [];
        if (_report is not null)
            foreach (var step in SelectedPlan.Where(step => step.Action == BreedingObjectiveAction.Prepare))
                if (step.OwnedId is { } id && step.Level is { } level && Mounts.Any(mount => mount.Id == id && mount.Level < level))
                    goals[id] = level;
        return ExperienceGoalsChanged.InvokeAsync(goals);
    }

    protected override void OnInitialized()
    {
        Settings.BreedingSettingsChanged += OnPlanningChanged;
        Stocks.Changed += OnStockChanged;
        Professions.Changed += OnStockChanged;
        Sales.HistoryAvailabilityChanged += OnBreedingPricesChanged;
        Sales.BreedingPricesChanged += OnBreedingPricesChanged;
        Sales.ListingsChanged += OnBreedingPricesChanged;
        MarketChanges.Changed += OnMarketPricesChanged;
    }

    protected override Task OnParametersSetAsync()
    {
        UpdateProgress();
        var profiles = Mounts.Select(mount => (mount.Id, mount.Level, mount.SpeciesId, mount.Fertility, mount.Sex,
                ExperienceBand: mount.Experience / 2_000))
            .OrderBy(profile => profile.Id).ToArray();
        bool changed = !ReferenceEquals(_lastSpecies, SpeciesById) || !_lastMountProfiles.SequenceEqual(profiles);
        _lastSpecies = SpeciesById;
        _lastMountProfiles = profiles;
        if (changed || DateTime.UtcNow - _marketChecked >= TimeSpan.FromMinutes(10)) return RefreshAsync();
        if (!_goalsDirty) return Task.CompletedTask;
        _goalsDirty = false;
        return PublishExperienceGoalsAsync();
    }

    private void OnBreedingPricesChanged(string server) => QueueMarketRefresh(server);

    private void OnMarketPricesChanged(object? sender, MarketDataChangedEventArgs change)
    {
        QueueMarketRefresh(change.ServerName);
    }

    private void QueueMarketRefresh(string server)
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            string? viewedServer = _report?.Server ?? ServerName;
            return viewedServer is null || string.Equals(server, viewedServer, StringComparison.OrdinalIgnoreCase)
                ? RefreshAsync() : Task.CompletedTask;
        });
    }

    private async Task RefreshAsync()
    {
        if (_disposed) return;
        _refreshPending = true;
        if (_loading) return;

        var token = _lifetime.Token;
        _loading = true;
        StateHasChanged();
        try
        {
            do
            {
                // The listing and ordinary resource prices can be saved together.
                await Task.Delay(250, token);
                _refreshPending = false;
                await LoadMarketAsync(token);
                if (!_disposed) StateHasChanged();
            } while (_refreshPending && !_disposed);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        finally
        {
            _loading = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task LoadMarketAsync(CancellationToken token)
    {
        try
        {
            _marketChecked = DateTime.UtcNow;
            var report = await Trade.LoadAsync(Window, ServerName, Mounts, SpeciesById, token);
            token.ThrowIfCancellationRequested();
            _report = report;
            UpdateProgress();
            _notice = report is null ? "Identifie le serveur pour consulter les prix." : null;
            if (_reserved is { } pair && report?.Pairs.Any(current =>
                    current.Matches(pair.First.Mount.Id, pair.Second.Mount.Id)) != true)
                _reserved = null;
            await ResaleChanged.InvokeAsync(report?.Resale ?? new Dictionary<Guid, BreedingResaleAssessment>());
            await PublishExperienceGoalsAsync();
        }
        catch (Exception ex) when (!token.IsCancellationRequested)
        {
            Logger.LogWarning(ex, "Comparaison des prix d’élevage indisponible.");
            _notice = "Comparaison indisponible. Rouvre cette section pour réessayer.";
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Settings.BreedingSettingsChanged -= OnPlanningChanged;
        Stocks.Changed -= OnStockChanged;
        Professions.Changed -= OnStockChanged;
        Sales.HistoryAvailabilityChanged -= OnBreedingPricesChanged;
        Sales.BreedingPricesChanged -= OnBreedingPricesChanged;
        Sales.ListingsChanged -= OnBreedingPricesChanged;
        MarketChanges.Changed -= OnMarketPricesChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
